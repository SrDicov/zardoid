# Template file for 'copyq-bin'
pkgname=copyq-bin
version=16.0.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of CopyQ [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/CopyQ-AppImage"
distfiles="https://github.com/pkgforge-dev/CopyQ-AppImage/releases/download/${version}-1%402026-10-01_1790875781/CopyQ-${version}-1-anylinux-x86_64.AppImage>copyq-bin-${version}.AppImage"
checksum=f851d99470fc58c6bee34542323925300f0bbcb180636f38e7ecbbe2bdf5fd5f
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/copyq-bin
	vcopy "squashfs-root/*" opt/copyq-bin
	vmkdir usr/bin
	ln -sf "/opt/copyq-bin/AppRun" "${DESTDIR}/usr/bin/copyq"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
