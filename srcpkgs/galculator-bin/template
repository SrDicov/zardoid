# Template file for 'galculator-bin'
pkgname=galculator-bin
version=2.1.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Galculator [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Galculator-AppImage"
distfiles="https://github.com/pkgforge-dev/Galculator-AppImage/releases/download/v${version}%402026-10-18_1792320657/Galculator-v${version}-anylinux-x86_64.AppImage>galculator-bin-${version}.AppImage"
checksum=b1b4dbffde245fb114c6fa2ae5f67025d92f30e3afc6126179b50ec198bc1c63
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/galculator-bin
	vcopy "squashfs-root/*" opt/galculator-bin
	chmod -R o-w "${DESTDIR}/opt/galculator-bin"
	vmkdir usr/bin
	ln -sf "/opt/galculator-bin/AppRun" "${DESTDIR}/usr/bin/galculator"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
