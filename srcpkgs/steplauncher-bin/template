# Template file for 'steplauncher-bin'
pkgname=steplauncher-bin
version=2.6.0
revision=1
archs="x86_64"
short_desc="El launcher definitivo de Minecraft creado con Wails v3, Rapido,"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://steplauncher.pages.dev"
distfiles="https://github.com/NovaStepStudio/StepLauncher/releases/download/v${version}/steplauncher-v${version}-linux-amd64.AppImage>steplauncher-bin-${version}.AppImage"
checksum=0251661f19bf52e96265a60cd33749026c45e747ec73ff978db02fb8a21f3efc
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/steplauncher-bin
	vcopy "squashfs-root/*" opt/steplauncher-bin
	chmod -R o-w "${DESTDIR}/opt/steplauncher-bin"
	vmkdir usr/bin
	ln -sf "/opt/steplauncher-bin/AppRun" "${DESTDIR}/usr/bin/steplauncher"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
