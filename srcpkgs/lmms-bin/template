# Template file for 'lmms-bin'
pkgname=lmms-bin
version=20260811
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of LMMS that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/LMMS-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/LMMS-AppImage-Enhanced/releases/download/1.3.0.alpha.1.r1024.g067c3ad41-1%402026-08-11_1786442463/LMMS-1.3.0.alpha.1.r1024.g067c3ad41-1-anylinux-x86_64.AppImage>lmms-bin-${version}.AppImage"
checksum=0920c9e3dd81031acadbf221e9c30d014390053af99327756c36adf81c014a75
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/lmms-bin
	vcopy "squashfs-root/*" opt/lmms-bin
	vmkdir usr/bin
	ln -sf "/opt/lmms-bin/AppRun" "${DESTDIR}/usr/bin/lmms"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
