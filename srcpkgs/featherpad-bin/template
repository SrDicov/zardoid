# Template file for 'featherpad-bin'
pkgname=featherpad-bin
version=1.6.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of FeatherPad [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/FeatherPad-AppImage"
distfiles="https://github.com/pkgforge-dev/FeatherPad-AppImage/releases/download/${version}-1%402026-10-07_1791382781/FeatherPad-${version}-1-anylinux-x86_64.AppImage>featherpad-bin-${version}.AppImage"
checksum=dc015a287fd66eac31c586412795a213d86451a4ff00346265e8b316da25b180
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/featherpad-bin
	vcopy "squashfs-root/*" opt/featherpad-bin
	vmkdir usr/bin
	ln -sf "/opt/featherpad-bin/AppRun" "${DESTDIR}/usr/bin/featherpad"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
