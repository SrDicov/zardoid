# Template file for 'cromagrally-bin'
pkgname=cromagrally-bin
version=3.0.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of CroMagRally [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/CroMagRally-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/CroMagRally-AppImage-Enhanced/releases/download/${version}%402026-10-11_1791698910/Cro-Mag_Rally-${version}-anylinux-x86_64.AppImage>cromagrally-bin-${version}.AppImage"
checksum=05277fc238ea166d065184d63e925cab522799d31ad14da28b5dbb2225e80f0e
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cromagrally-bin
	vcopy "squashfs-root/*" opt/cromagrally-bin
	vmkdir usr/bin
	ln -sf "/opt/cromagrally-bin/AppRun" "${DESTDIR}/usr/bin/cromagrally"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
