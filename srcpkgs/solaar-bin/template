# Template file for 'solaar-bin'
pkgname=solaar-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of solaar [Maintainer=@TheRealYasri]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Solaar-AppImage"
distfiles="https://github.com/pkgforge-dev/Solaar-AppImage/releases/download/1.1.20-2%402026-10-22_1792688798/Solaar-1.1.20-2-anylinux-x86_64.AppImage>solaar-bin-${version}.AppImage"
checksum=711e67da0d624bbd8e98063cd9b145431eefc449ea1ef807ca810bf5c3b74163
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/solaar-bin
	vcopy "squashfs-root/*" opt/solaar-bin
	chmod -R o-w "${DESTDIR}/opt/solaar-bin"
	vmkdir usr/bin
	ln -sf "/opt/solaar-bin/AppRun" "${DESTDIR}/usr/bin/solaar"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
