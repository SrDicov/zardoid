# Template file for 'gnome-text-editor-bin'
pkgname=gnome-text-editor-bin
version=50.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Gnome's Text Editor application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Gnome-Text-Editor-AppImage"
distfiles="https://github.com/pkgforge-dev/Gnome-Text-Editor-AppImage/releases/download/${version}-1%402026-10-01_1790876138/Text_Editor-${version}-1-anylinux-x86_64.AppImage>gnome-text-editor-bin-${version}.AppImage"
checksum=ca1a30bc9ced194642c2fc43e37613e239929389b7b0f3867be16420f7b96106
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gnome-text-editor-bin
	vcopy "squashfs-root/*" opt/gnome-text-editor-bin
	vmkdir usr/bin
	ln -sf "/opt/gnome-text-editor-bin/AppRun" "${DESTDIR}/usr/bin/gnome-text-editor"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
