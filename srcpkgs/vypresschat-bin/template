# Template file for 'vypresschat-bin'
pkgname=vypresschat-bin
version=20261025
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of VypressChat [Maintainer=@mmtrt]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/VypressChat-AppImage"
distfiles="https://github.com/pkgforge-dev/VypressChat-AppImage/releases/download/2.1.9%402026-10-25_1792910499/VypressChat-2.1.9-anylinux-x86_64.AppImage>vypresschat-bin-${version}.AppImage"
checksum=f694056071e39b4a3fcdb22d5d264ac7bfddc11f3b804979367012da69b97974
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/vypresschat-bin
	vcopy "squashfs-root/*" opt/vypresschat-bin
	chmod -R o-w "${DESTDIR}/opt/vypresschat-bin"
	vmkdir usr/bin
	ln -sf "/opt/vypresschat-bin/AppRun" "${DESTDIR}/usr/bin/vypresschat"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
