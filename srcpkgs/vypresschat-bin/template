# Template file for 'vypresschat-bin'
pkgname=vypresschat-bin
version=2.1.9
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of VypressChat [Maintainer=@mmtrt]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/VypressChat-AppImage"
distfiles="https://github.com/pkgforge-dev/VypressChat-AppImage/releases/download/${version}%402026-09-01_1788296113/VypressChat-${version}-anylinux-x86_64.AppImage>vypresschat-bin-${version}.AppImage"
checksum=526d919b0cf1d71242c88c26ee101a1cef93a404b82d5b3d143d0c7a9c9ef436
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/vypresschat-bin
	vcopy "squashfs-root/*" opt/vypresschat-bin
	vmkdir usr/bin
	ln -sf "/opt/vypresschat-bin/AppRun" "${DESTDIR}/usr/bin/vypresschat"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
