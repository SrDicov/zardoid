# Template file for 'swiftynotes-bin'
pkgname=swiftynotes-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of swiftynotes [Maintainer=@TheRealYasri]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/swiftynotes-AppImage"
distfiles="https://github.com/pkgforge-dev/swiftynotes-AppImage/releases/download/1.5.0%402026-10-22_1792632970/Swifty_Notes-1.5.0-anylinux-x86_64.AppImage>swiftynotes-bin-${version}.AppImage"
checksum=cbed1623d3e84b9d58004faf6819db232aadcc3386bab1d19af61a52c4445a04
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/swiftynotes-bin
	vcopy "squashfs-root/*" opt/swiftynotes-bin
	chmod -R o-w "${DESTDIR}/opt/swiftynotes-bin"
	vmkdir usr/bin
	ln -sf "/opt/swiftynotes-bin/AppRun" "${DESTDIR}/usr/bin/swiftynotes"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
