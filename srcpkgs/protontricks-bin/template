# Template file for 'protontricks-bin'
pkgname=protontricks-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Protontricks [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Protontricks-AppImage"
distfiles="https://github.com/pkgforge-dev/Protontricks-AppImage/releases/download/1.14.1-1%402026-10-22_1792689411/Protontricks-1.14.1-1-anylinux-x86_64.AppImage>protontricks-bin-${version}.AppImage"
checksum=c133ff9769c812bdf0dd4a334158a9cca751c26436364efa3ed5b855844f7f50
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/protontricks-bin
	vcopy "squashfs-root/*" opt/protontricks-bin
	chmod -R o-w "${DESTDIR}/opt/protontricks-bin"
	vmkdir usr/bin
	ln -sf "/opt/protontricks-bin/AppRun" "${DESTDIR}/usr/bin/protontricks"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
