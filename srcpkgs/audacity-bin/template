# Template file for 'audacity-bin'
pkgname=audacity-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Audacity that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Audacity-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Audacity-AppImage-Enhanced/releases/download/3.7.9-1%402026-10-22_1792688755/Audacity-3.7.9-1-anylinux-x86_64.AppImage>audacity-bin-${version}.AppImage"
checksum=9a06e1acc1a32a26135c2c8f4b43daff1040f67e693818b4fca4dc3931d06d95
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/audacity-bin
	vcopy "squashfs-root/*" opt/audacity-bin
	chmod -R o-w "${DESTDIR}/opt/audacity-bin"
	vmkdir usr/bin
	ln -sf "/opt/audacity-bin/AppRun" "${DESTDIR}/usr/bin/audacity"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
