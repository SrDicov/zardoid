# Template file for 'powermanga-bin'
pkgname=powermanga-bin
version=20261007
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Powermanga [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Powermanga-AppImage"
distfiles="https://github.com/pkgforge-dev/Powermanga-AppImage/releases/download/da3de3382%402026-10-07_1791382392/Powermanga-da3de3382-anylinux-x86_64.AppImage>powermanga-bin-${version}.AppImage"
checksum=3dcdce2d49422302d927cd7fb1987bb411d0bdaba2325f00dc2c96db304436a6
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/powermanga-bin
	vcopy "squashfs-root/*" opt/powermanga-bin
	vmkdir usr/bin
	ln -sf "/opt/powermanga-bin/AppRun" "${DESTDIR}/usr/bin/powermanga"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
