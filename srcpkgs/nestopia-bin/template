# Template file for 'nestopia-bin'
pkgname=nestopia-bin
version=1.53.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Nestopia [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Nestopia-AppImage"
distfiles="https://github.com/pkgforge-dev/Nestopia-AppImage/releases/download/${version}-1%402026-09-01_1788278120/Nestopia-${version}-1-anylinux-x86_64.AppImage>nestopia-bin-${version}.AppImage"
checksum=a7b230f865f47ec9ad36e2e45dba3aa24a0680723869d094ca88951d35668d8b
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/nestopia-bin
	vcopy "squashfs-root/*" opt/nestopia-bin
	vmkdir usr/bin
	ln -sf "/opt/nestopia-bin/AppRun" "${DESTDIR}/usr/bin/nestopia"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
