# Template file for 'opentesarena-bin'
pkgname=opentesarena-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenTESArena [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenTESArena-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenTESArena-AppImage/releases/download/0.18.0%402026-10-22_1792689297/OpenTESArena-0.18.0-anylinux-x86_64.AppImage>opentesarena-bin-${version}.AppImage"
checksum=18c6f1892418d815df6220cae5d5cbdfa644b2390aad2e0ab7f491d978ea382b
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/opentesarena-bin
	vcopy "squashfs-root/*" opt/opentesarena-bin
	chmod -R o-w "${DESTDIR}/opt/opentesarena-bin"
	vmkdir usr/bin
	ln -sf "/opt/opentesarena-bin/AppRun" "${DESTDIR}/usr/bin/opentesarena"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
