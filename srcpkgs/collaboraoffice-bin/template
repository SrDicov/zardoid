# Template file for 'collaboraoffice-bin'
pkgname=collaboraoffice-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Collabora Office [Maintainer=@sounddrill31]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/CollaboraOffice-AppImage"
distfiles="https://github.com/pkgforge-dev/CollaboraOffice-AppImage/releases/download/26.04.2.4-1%402026-10-01_1790876635/Collabora_Office-26.04.2.4-1-anylinux-x86_64.AppImage>collaboraoffice-bin-${version}.AppImage"
checksum=82a049ab210a6a52440f915aba55d7f33b66cdd2703d899ad1f78077e38784d7
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/collaboraoffice-bin
	vcopy "squashfs-root/*" opt/collaboraoffice-bin
	vmkdir usr/bin
	ln -sf "/opt/collaboraoffice-bin/AppRun" "${DESTDIR}/usr/bin/collaboraoffice"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
