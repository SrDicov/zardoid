# Template file for 'riseup-vpn-bin'
pkgname=riseup-vpn-bin
version=0.25.8
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Riseup-VPN [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Riseup-VPN-AppImage"
distfiles="https://github.com/pkgforge-dev/Riseup-VPN-AppImage/releases/download/${version}%402026-10-07_1791383245/RiseupVPN-${version}-anylinux-x86_64.AppImage>riseup-vpn-bin-${version}.AppImage"
checksum=519bdcc2ea32e187954ef73785feebb5b232e2f1bbb129d78064569ddfb98dbf
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/riseup-vpn-bin
	vcopy "squashfs-root/*" opt/riseup-vpn-bin
	vmkdir usr/bin
	ln -sf "/opt/riseup-vpn-bin/AppRun" "${DESTDIR}/usr/bin/riseup-vpn"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
