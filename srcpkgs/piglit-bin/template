# Template file for 'piglit-bin'
pkgname=piglit-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Piglit [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Piglit-AppImage"
distfiles="https://github.com/pkgforge-dev/Piglit-AppImage/releases/download/c25575c9b%402026-10-01_1790878490/Piglit-c25575c9b-anylinux-x86_64.AppImage>piglit-bin-${version}.AppImage"
checksum=69926d18784bc7ee51a41d387df3680aa6bde54bbb991a152123731026ad6f8b
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/piglit-bin
	vcopy "squashfs-root/*" opt/piglit-bin
	vmkdir usr/bin
	ln -sf "/opt/piglit-bin/AppRun" "${DESTDIR}/usr/bin/piglit"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
