# Template file for 'basiliskii-bin'
pkgname=basiliskii-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Basilisk II [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/BasiliskII-AppImage"
distfiles="https://github.com/pkgforge-dev/BasiliskII-AppImage/releases/download/892eeb74a%402026-10-01_1790876688/BasiliskII-892eeb74a-anylinux-x86_64.AppImage>basiliskii-bin-${version}.AppImage"
checksum=33ff150f252f5603600918bdfe58b840d766fad6e572592abf7a8eed98a30feb
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/basiliskii-bin
	vcopy "squashfs-root/*" opt/basiliskii-bin
	vmkdir usr/bin
	ln -sf "/opt/basiliskii-bin/AppRun" "${DESTDIR}/usr/bin/basiliskii"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
