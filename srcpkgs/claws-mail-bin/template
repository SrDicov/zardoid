# Template file for 'claws-mail-bin'
pkgname=claws-mail-bin
version=20260907
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Claws Mail [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Claws-Mail-AppImage"
distfiles="https://github.com/pkgforge-dev/Claws-Mail-AppImage/releases/download/4.4.0-5%402026-09-07_1788786624/Claws_Mail-4.4.0-5-anylinux-x86_64.AppImage>claws-mail-bin-${version}.AppImage"
checksum=4c175b1f9fa37d4912acd6ac4dd7bb546c7cd63be35fb7817da6fdbb84fd7430
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/claws-mail-bin
	vcopy "squashfs-root/*" opt/claws-mail-bin
	vmkdir usr/bin
	ln -sf "/opt/claws-mail-bin/AppRun" "${DESTDIR}/usr/bin/claws-mail"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
