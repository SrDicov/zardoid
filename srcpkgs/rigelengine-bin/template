# Template file for 'rigelengine-bin'
pkgname=rigelengine-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of RigelEngine [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/RigelEngine-AppImage"
distfiles="https://github.com/pkgforge-dev/RigelEngine-AppImage/releases/download/0.9.1-30afeff8%402026-10-01_1790876614/RigelEngine-0.9.1-30afeff8-anylinux-x86_64.AppImage>rigelengine-bin-${version}.AppImage"
checksum=cbd3333a1906956be78d2aa7dfd762d5b21b06a04e992ac56f61f93f6b21fd5c
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rigelengine-bin
	vcopy "squashfs-root/*" opt/rigelengine-bin
	vmkdir usr/bin
	ln -sf "/opt/rigelengine-bin/AppRun" "${DESTDIR}/usr/bin/rigelengine"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
