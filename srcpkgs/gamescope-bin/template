# Template file for 'gamescope-bin'
pkgname=gamescope-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of gamescope [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/gamescope-AppImage"
distfiles="https://github.com/pkgforge-dev/gamescope-AppImage/releases/download/3.16.31-1%402026-10-22_1792689108/gamescope-3.16.31-1-anylinux-x86_64.AppImage>gamescope-bin-${version}.AppImage"
checksum=c12237375df8257eb0a31caa1b91999bb585f74e82c46ac4268c80c50e5182af
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gamescope-bin
	vcopy "squashfs-root/*" opt/gamescope-bin
	chmod -R o-w "${DESTDIR}/opt/gamescope-bin"
	vmkdir usr/bin
	ln -sf "/opt/gamescope-bin/AppRun" "${DESTDIR}/usr/bin/gamescope"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
