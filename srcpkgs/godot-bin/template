# Template file for 'godot-bin'
pkgname=godot-bin
version=4.7.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Godot [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Godot-AppImage"
distfiles="https://github.com/pkgforge-dev/Godot-AppImage/releases/download/${version}%402026-10-07_1791386209/Godot_Engine-${version}-anylinux-x86_64.AppImage>godot-bin-${version}.AppImage"
checksum=57cb02a21f5023b94764b97ee80143e8ddf31b638427045a4fe4620a356d4171
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/godot-bin
	vcopy "squashfs-root/*" opt/godot-bin
	vmkdir usr/bin
	ln -sf "/opt/godot-bin/AppRun" "${DESTDIR}/usr/bin/godot"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
