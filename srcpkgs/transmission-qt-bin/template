# Template file for 'transmission-qt-bin'
pkgname=transmission-qt-bin
version=4.1.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Transmission (Qt version)"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/transmission-qt-AppImage"
distfiles="https://github.com/pkgforge-dev/transmission-qt-AppImage/releases/download/${version}-2%402026-10-07_1791383144/Transmission_Qt-${version}-2-anylinux-x86_64.AppImage>transmission-qt-bin-${version}.AppImage"
checksum=59eaedc8888b4d70f571fa3c623c1b5a1935fefc7c8f38b41ea734eec6f854f5
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/transmission-qt-bin
	vcopy "squashfs-root/*" opt/transmission-qt-bin
	vmkdir usr/bin
	ln -sf "/opt/transmission-qt-bin/AppRun" "${DESTDIR}/usr/bin/transmission-qt"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
