# Template file for 'devilutionx-bin'
pkgname=devilutionx-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of DevilutionX [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/DevilutionX-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/DevilutionX-AppImage-Enhanced/releases/download/1.5.5%402026-10-22_1792689400/DevilutionX-1.5.5-anylinux-x86_64.AppImage>devilutionx-bin-${version}.AppImage"
checksum=0cec2937076ca8bfef5cb64bef435f270e19042b19d745bc14ff6953c189a2a6
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/devilutionx-bin
	vcopy "squashfs-root/*" opt/devilutionx-bin
	chmod -R o-w "${DESTDIR}/opt/devilutionx-bin"
	vmkdir usr/bin
	ln -sf "/opt/devilutionx-bin/AppRun" "${DESTDIR}/usr/bin/devilutionx"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
