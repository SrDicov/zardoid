# Template file for 'aerofoil-bin'
pkgname=aerofoil-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Aerofoil [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Aerofoil-AppImage"
distfiles="https://github.com/pkgforge-dev/Aerofoil-AppImage/releases/download/ba2a3628d%402026-10-01_1790876505/Aerofoil-ba2a3628d-anylinux-x86_64.AppImage>aerofoil-bin-${version}.AppImage"
checksum=7be8b9dde2cb85f65c5d9cb01e78f5b4e483ea6192113679339af25096516ea4
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/aerofoil-bin
	vcopy "squashfs-root/*" opt/aerofoil-bin
	vmkdir usr/bin
	ln -sf "/opt/aerofoil-bin/AppRun" "${DESTDIR}/usr/bin/aerofoil"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
