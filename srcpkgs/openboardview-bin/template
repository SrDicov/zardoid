# Template file for 'openboardview-bin'
pkgname=openboardview-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Open Board Viewer
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenBoardView-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenBoardView-AppImage/releases/download/cc76e69%402026-10-01_1790875653/OpenBoardView-cc76e69-anylinux-x86_64.AppImage>openboardview-bin-${version}.AppImage"
checksum=dfd1a50fa3a129dde112a729ce14ba604cd02f3d021a6523015f247d3b52c6bd
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openboardview-bin
	vcopy "squashfs-root/*" opt/openboardview-bin
	vmkdir usr/bin
	ln -sf "/opt/openboardview-bin/AppRun" "${DESTDIR}/usr/bin/openboardview"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
