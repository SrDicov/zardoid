# Template file for 'mousai-bin'
pkgname=mousai-bin
version=0.7.10
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Mousai song identifier application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Mousai-AppImage"
distfiles="https://github.com/pkgforge-dev/Mousai-AppImage/releases/download/${version}-1%402026-10-01_1790876703/Mousai-${version}-1-anylinux-x86_64.AppImage>mousai-bin-${version}.AppImage"
checksum=c35b72521023e2fcf39ff5f32aa9a6aff0740e3ff071d88f61d4456bc719a477
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/mousai-bin
	vcopy "squashfs-root/*" opt/mousai-bin
	vmkdir usr/bin
	ln -sf "/opt/mousai-bin/AppRun" "${DESTDIR}/usr/bin/mousai"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
