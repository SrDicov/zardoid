# Template file for 'joplin-desktop-bin'
pkgname=joplin-desktop-bin
version=3.6.16
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Joplin Desktop [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Joplin-Desktop-AppImage"
distfiles="https://github.com/pkgforge-dev/Joplin-Desktop-AppImage/releases/download/v${version}%402026-09-02_1788385775/Joplin-v${version}-anylinux-x86_64.AppImage>joplin-desktop-bin-${version}.AppImage"
checksum=5bfb8fd2d514666193d3a63fc6a35f8a51ab32f987cd1c2ce612ec4f870a8a27
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/joplin-desktop-bin
	vcopy "squashfs-root/*" opt/joplin-desktop-bin
	vmkdir usr/bin
	ln -sf "/opt/joplin-desktop-bin/AppRun" "${DESTDIR}/usr/bin/joplin-desktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
