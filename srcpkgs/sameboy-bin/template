# Template file for 'sameboy-bin'
pkgname=sameboy-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of SameBoy [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SameBoy-AppImage"
distfiles="https://github.com/pkgforge-dev/SameBoy-AppImage/releases/download/1.0.3-2%402026-10-22_1792689463/SameBoy-1.0.3-2-anylinux-x86_64.AppImage>sameboy-bin-${version}.AppImage"
checksum=a95249943d5d36ac7642e9131829023f1d90027dbd0787502f27e7bb51922917
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/sameboy-bin
	vcopy "squashfs-root/*" opt/sameboy-bin
	chmod -R o-w "${DESTDIR}/opt/sameboy-bin"
	vmkdir usr/bin
	ln -sf "/opt/sameboy-bin/AppRun" "${DESTDIR}/usr/bin/sameboy"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
