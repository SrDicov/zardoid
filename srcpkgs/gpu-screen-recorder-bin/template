# Template file for 'gpu-screen-recorder-bin'
pkgname=gpu-screen-recorder-bin
version=6.1.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of GPU Screen Recorder
 [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/gpu-screen-recorder-AppImage"
distfiles="https://github.com/pkgforge-dev/gpu-screen-recorder-AppImage/releases/download/${version}%402026-10-17_1792236768/gpu-screen-recorder-${version}-anylinux-x86_64.AppImage>gpu-screen-recorder-bin-${version}.AppImage"
checksum=bfa97075e9bb80888d519d82e40312a445529aa349f480251687e333e71d2f4d
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gpu-screen-recorder-bin
	vcopy "squashfs-root/*" opt/gpu-screen-recorder-bin
	vmkdir usr/bin
	ln -sf "/opt/gpu-screen-recorder-bin/AppRun" "${DESTDIR}/usr/bin/gpu-screen-recorder"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
