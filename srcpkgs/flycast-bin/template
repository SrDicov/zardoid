# Template file for 'flycast-bin'
pkgname=flycast-bin
version=2.7
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Flycast [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Flycast-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Flycast-AppImage-Enhanced/releases/download/${version}%402026-10-01_1790875174/Flycast-${version}-anylinux-x86_64.AppImage>flycast-bin-${version}.AppImage"
checksum=56407473faef14cf2a34d61c06419dbdca11fe1acebe729cdea4b70f8b169ecb
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/flycast-bin
	vcopy "squashfs-root/*" opt/flycast-bin
	vmkdir usr/bin
	ln -sf "/opt/flycast-bin/AppRun" "${DESTDIR}/usr/bin/flycast"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
