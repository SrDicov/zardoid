# Template file for 'flycast-bin'
pkgname=flycast-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Flycast [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Flycast-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Flycast-AppImage-Enhanced/releases/download/2.7%402026-10-22_1792688568/Flycast-2.7-anylinux-x86_64.AppImage>flycast-bin-${version}.AppImage"
checksum=2e6553bce47fe407b8bafd32adaaa1609d3d02397e372f98453bfc1c740e1330
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/flycast-bin
	vcopy "squashfs-root/*" opt/flycast-bin
	chmod -R o-w "${DESTDIR}/opt/flycast-bin"
	vmkdir usr/bin
	ln -sf "/opt/flycast-bin/AppRun" "${DESTDIR}/usr/bin/flycast"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
