# Template file for 'pinecone-launcher-bin'
pkgname=pinecone-launcher-bin
version=11.1.1
revision=1
archs="x86_64"
short_desc="This fork of Prism Launcher adds integrated support for Ely.by
 accounts"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://pineconemc.ru"
distfiles="https://github.com/ElyPrismLauncher/Launcher/releases/download/${version}/PineconeMC-Linux-x86_64.AppImage>pinecone-launcher-bin-${version}.AppImage"
checksum=6e18b48961f760a468975866e58e79d93b566b7e3b68fac03f9a124d0cf5c261
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pinecone-launcher-bin
	vcopy "squashfs-root/*" opt/pinecone-launcher-bin
	chmod -R o-w "${DESTDIR}/opt/pinecone-launcher-bin"
	vmkdir usr/bin
	ln -sf "/opt/pinecone-launcher-bin/AppRun" "${DESTDIR}/usr/bin/pinecone-launcher"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
