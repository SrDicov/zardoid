# Template file for 'qterminal-bin'
pkgname=qterminal-bin
version=2.4.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of QTerminal [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/QTerminal-AppImage"
distfiles="https://github.com/pkgforge-dev/QTerminal-AppImage/releases/download/${version}-1%402026-10-01_1790876161/QTerminal-${version}-1-anylinux-x86_64.AppImage>qterminal-bin-${version}.AppImage"
checksum=89450f6637bd8d395ddcb553045b82d869a964a7f041820618281d0cc6623039
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/qterminal-bin
	vcopy "squashfs-root/*" opt/qterminal-bin
	vmkdir usr/bin
	ln -sf "/opt/qterminal-bin/AppRun" "${DESTDIR}/usr/bin/qterminal"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
