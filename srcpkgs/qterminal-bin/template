# Template file for 'qterminal-bin'
pkgname=qterminal-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of QTerminal [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/QTerminal-AppImage"
distfiles="https://github.com/pkgforge-dev/QTerminal-AppImage/releases/download/2.4.0-1%402026-10-22_1792688495/QTerminal-2.4.0-1-anylinux-x86_64.AppImage>qterminal-bin-${version}.AppImage"
checksum=ddb5d2db0e16c22138cc3fd0cb536658bef965f16e966e830f9b665db12aa241
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/qterminal-bin
	vcopy "squashfs-root/*" opt/qterminal-bin
	chmod -R o-w "${DESTDIR}/opt/qterminal-bin"
	vmkdir usr/bin
	ln -sf "/opt/qterminal-bin/AppRun" "${DESTDIR}/usr/bin/qterminal"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
