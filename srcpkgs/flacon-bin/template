# Template file for 'flacon-bin'
pkgname=flacon-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Flacon [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Flacon-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Flacon-AppImage-Enhanced/releases/download/13.0.2%402026-10-22_1792688953/Flacon-13.0.2-anylinux-x86_64.AppImage>flacon-bin-${version}.AppImage"
checksum=34c23a5a7648b13df03f39e6425d32058b6803608e24f2e2dbe4e87d4532f480
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/flacon-bin
	vcopy "squashfs-root/*" opt/flacon-bin
	chmod -R o-w "${DESTDIR}/opt/flacon-bin"
	vmkdir usr/bin
	ln -sf "/opt/flacon-bin/AppRun" "${DESTDIR}/usr/bin/flacon"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
