# Template file for 'ghostty-bin'
pkgname=ghostty-bin
version=1.3.1
revision=1
archs="x86_64"
short_desc="AppImage for Ghostty Terminal Emulator [Maintainer=@psadi]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://appimage.github.io/Ghostty"
distfiles="https://github.com/pkgforge-dev/ghostty-appimage/releases/download/v${version}/Ghostty-${version}-x86_64.AppImage>ghostty-bin-${version}.AppImage"
checksum=fde48d2b716afd1978766879bbf1aae30dd305e8ad86a1037a2614a14d82dc28
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ghostty-bin
	vcopy "squashfs-root/*" opt/ghostty-bin
	vmkdir usr/bin
	ln -sf "/opt/ghostty-bin/AppRun" "${DESTDIR}/usr/bin/ghostty"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
