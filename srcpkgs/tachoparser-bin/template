# Template file for 'tachoparser-bin'
pkgname=tachoparser-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of tachoparser, CLI and GUI application for
 reading"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/tachoparser-AppImage"
distfiles="https://github.com/pkgforge-dev/tachoparser-AppImage/releases/download/0.2.0.0.gf108ac4-1%402026-10-01_1790876533/tachoparser-0.2.0.0.gf108ac4-1-anylinux-x86_64.AppImage>tachoparser-bin-${version}.AppImage"
checksum=3fac67ab8ea88ab13cb9550959333f9d4df15d31404bd34327f3bd8f9edeba9c
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/tachoparser-bin
	vcopy "squashfs-root/*" opt/tachoparser-bin
	vmkdir usr/bin
	ln -sf "/opt/tachoparser-bin/AppRun" "${DESTDIR}/usr/bin/tachoparser"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
