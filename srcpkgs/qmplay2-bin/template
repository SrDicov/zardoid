# Template file for 'qmplay2-bin'
pkgname=qmplay2-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of QMPlay2 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/QMPlay2-AppImage"
distfiles="https://github.com/pkgforge-dev/QMPlay2-AppImage/releases/download/1c39ae796%402026-10-01_1790875764/QMPlay2-1c39ae796-anylinux-x86_64.AppImage>qmplay2-bin-${version}.AppImage"
checksum=0a9a27694217c4de2579c215a72d64fc487fcafab1f85a510068963a79c5c609
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/qmplay2-bin
	vcopy "squashfs-root/*" opt/qmplay2-bin
	vmkdir usr/bin
	ln -sf "/opt/qmplay2-bin/AppRun" "${DESTDIR}/usr/bin/qmplay2"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
