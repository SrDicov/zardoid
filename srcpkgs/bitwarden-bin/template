# Template file for 'bitwarden-bin'
pkgname=bitwarden-bin
version=2026.9.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Bitwarden that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Bitwarden-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Bitwarden-AppImage-Enhanced/releases/download/v${version}%402026-10-01_1790874856/Bitwarden-v${version}-anylinux-x86_64.AppImage>bitwarden-bin-${version}.AppImage"
checksum=5721a97fcf1c873749de5daca0b0c76f82cefe49fd8ff0458790aeaa89547169
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/bitwarden-bin
	vcopy "squashfs-root/*" opt/bitwarden-bin
	vmkdir usr/bin
	ln -sf "/opt/bitwarden-bin/AppRun" "${DESTDIR}/usr/bin/bitwarden"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
