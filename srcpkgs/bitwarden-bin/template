# Template file for 'bitwarden-bin'
pkgname=bitwarden-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Bitwarden that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Bitwarden-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Bitwarden-AppImage-Enhanced/releases/download/v2026.10.0%402026-10-22_1792687855/Bitwarden-v2026.10.0-anylinux-x86_64.AppImage>bitwarden-bin-${version}.AppImage"
checksum=9b9a509bcfdd5b25528b6946250b8e64ce2c98e01604f308192e8fb41e44b2da
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/bitwarden-bin
	vcopy "squashfs-root/*" opt/bitwarden-bin
	chmod -R o-w "${DESTDIR}/opt/bitwarden-bin"
	vmkdir usr/bin
	ln -sf "/opt/bitwarden-bin/AppRun" "${DESTDIR}/usr/bin/bitwarden"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
