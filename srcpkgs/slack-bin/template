# Template file for 'slack-bin'
pkgname=slack-bin
version=4.52.162
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Slack [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Slack-AppImage"
distfiles="https://github.com/pkgforge-dev/Slack-AppImage/releases/download/${version}-1%402026-10-01_1790876246/Slack-${version}-1-anylinux-x86_64.AppImage>slack-bin-${version}.AppImage"
checksum=8ea7098d261795cecb574b4352cafc952a02e01f66b108b8efe7fe13234d77d8
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/slack-bin
	vcopy "squashfs-root/*" opt/slack-bin
	vmkdir usr/bin
	ln -sf "/opt/slack-bin/AppRun" "${DESTDIR}/usr/bin/slack"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
