# Template file for 'extremetuxracer-bin'
pkgname=extremetuxracer-bin
version=0.8.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Extreme Tux Racer [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ExtremeTuxRacer-AppImage"
distfiles="https://github.com/pkgforge-dev/ExtremeTuxRacer-AppImage/releases/download/${version}-3%402026-09-01_1788278360/Extreme_Tux_Racer-${version}-3-anylinux-x86_64.AppImage>extremetuxracer-bin-${version}.AppImage"
checksum=5a77eb6d440f2ff4d6e6dbac8b580efac957f9c2a13d68168d96ca74cc20db17
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/extremetuxracer-bin
	vcopy "squashfs-root/*" opt/extremetuxracer-bin
	vmkdir usr/bin
	ln -sf "/opt/extremetuxracer-bin/AppRun" "${DESTDIR}/usr/bin/extremetuxracer"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
