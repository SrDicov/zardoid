# Template file for 'ghostscript-bin'
pkgname=ghostscript-bin
version=10.08.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Ghostscript [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Ghostscript-AppImage"
distfiles="https://github.com/pkgforge-dev/Ghostscript-AppImage/releases/download/${version}-1%402026-10-01_1790874098/gs-${version}-1-anylinux-x86_64.AppImage>ghostscript-bin-${version}.AppImage"
checksum=769cf952eddb4c128defa80b3f19c859f98bf907dc9b1115b29c53f02a671beb
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ghostscript-bin
	vcopy "squashfs-root/*" opt/ghostscript-bin
	vmkdir usr/bin
	ln -sf "/opt/ghostscript-bin/AppRun" "${DESTDIR}/usr/bin/ghostscript"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
