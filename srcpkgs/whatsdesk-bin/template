# Template file for 'whatsdesk-bin'
pkgname=whatsdesk-bin
version=20261003
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of WhatsDesk [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/WhatsDesk-AppImage"
distfiles="https://github.com/pkgforge-dev/WhatsDesk-AppImage/releases/download/be622129a%402026-10-03_1791008832/whatsdesk-be622129a-anylinux-x86_64.AppImage>whatsdesk-bin-${version}.AppImage"
checksum=58844acb6313e3d4d650755337549b9363491c8aa6b7f4bbc31bfa4a60aa31ac
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/whatsdesk-bin
	vcopy "squashfs-root/*" opt/whatsdesk-bin
	vmkdir usr/bin
	ln -sf "/opt/whatsdesk-bin/AppRun" "${DESTDIR}/usr/bin/whatsdesk"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
