# Template file for 'banjorecomp-bin'
pkgname=banjorecomp-bin
version=1.0.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Banjo: Recompiled
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/BanjoRecomp-AppImage"
distfiles="https://github.com/pkgforge-dev/BanjoRecomp-AppImage/releases/download/${version}%402026-10-01_1790876454/BanjoRecompiled-${version}-anylinux-x86_64.AppImage>banjorecomp-bin-${version}.AppImage"
checksum=a3507df5a812f34ae7c906853173aa351304e13d92fd199c6dbcd74265f33afe
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/banjorecomp-bin
	vcopy "squashfs-root/*" opt/banjorecomp-bin
	vmkdir usr/bin
	ln -sf "/opt/banjorecomp-bin/AppRun" "${DESTDIR}/usr/bin/banjorecomp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
