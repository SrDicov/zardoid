# Template file for 'spaghettikart-bin'
pkgname=spaghettikart-bin
version=1.0.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of SpaghettiKart [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SpaghettiKart-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/SpaghettiKart-AppImage-Enhanced/releases/download/${version}%402026-10-01_1790876072/SpaghettiKart-${version}-anylinux-x86_64.AppImage>spaghettikart-bin-${version}.AppImage"
checksum=c3674cfca07dfdfb0652cbf01825fd13eb56590d0783fb7939e65036226ee851
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/spaghettikart-bin
	vcopy "squashfs-root/*" opt/spaghettikart-bin
	vmkdir usr/bin
	ln -sf "/opt/spaghettikart-bin/AppRun" "${DESTDIR}/usr/bin/spaghettikart"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
