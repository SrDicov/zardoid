# Template file for 'scummvm-bin'
pkgname=scummvm-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ScummVM [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ScummVM-AppImage"
distfiles="https://github.com/pkgforge-dev/ScummVM-AppImage/releases/download/2026.4.0-1%402026-10-22_1792688032/ScummVM-2026.4.0-1-anylinux-x86_64.AppImage>scummvm-bin-${version}.AppImage"
checksum=650e40d4c5143eee19461d3f0bc450e527899944cfd1e3560b7873e235dc0bac
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/scummvm-bin
	vcopy "squashfs-root/*" opt/scummvm-bin
	chmod -R o-w "${DESTDIR}/opt/scummvm-bin"
	vmkdir usr/bin
	ln -sf "/opt/scummvm-bin/AppRun" "${DESTDIR}/usr/bin/scummvm"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
