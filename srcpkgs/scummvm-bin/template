# Template file for 'scummvm-bin'
pkgname=scummvm-bin
version=2026.3.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ScummVM [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ScummVM-AppImage"
distfiles="https://github.com/pkgforge-dev/ScummVM-AppImage/releases/download/${version}-1%402026-10-01_1790875406/ScummVM-${version}-1-anylinux-x86_64.AppImage>scummvm-bin-${version}.AppImage"
checksum=3f873e5de99e1abe8b4454e6e0bcbdc20e7697d3a0a7145bac7093312c7ad86b
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/scummvm-bin
	vcopy "squashfs-root/*" opt/scummvm-bin
	vmkdir usr/bin
	ln -sf "/opt/scummvm-bin/AppRun" "${DESTDIR}/usr/bin/scummvm"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
