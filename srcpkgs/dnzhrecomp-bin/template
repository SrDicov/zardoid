# Template file for 'dnzhrecomp-bin'
pkgname=dnzhrecomp-bin
version=0.0.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Duke Nukem Zero Hour Recompiled"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/DNZHRecomp-AppImage"
distfiles="https://github.com/pkgforge-dev/DNZHRecomp-AppImage/releases/download/${version}%402026-10-01_1790876472/DNZHRecompiled-${version}-anylinux-x86_64.AppImage>dnzhrecomp-bin-${version}.AppImage"
checksum=d97cd3fe93a8e30202e05093d01e076b9bd9b580f3d8953bdff36d865c67e388
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dnzhrecomp-bin
	vcopy "squashfs-root/*" opt/dnzhrecomp-bin
	vmkdir usr/bin
	ln -sf "/opt/dnzhrecomp-bin/AppRun" "${DESTDIR}/usr/bin/dnzhrecomp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
