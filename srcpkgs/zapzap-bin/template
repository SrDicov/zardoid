# Template file for 'zapzap-bin'
pkgname=zapzap-bin
version=20260727
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ZapZap [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ZapZap-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/ZapZap-AppImage-Enhanced/releases/download/7.1-1%402026-07-27_1785187279/ZapZap-7.1-1-anylinux-x86_64.AppImage>zapzap-bin-${version}.AppImage"
checksum=4c3bc9e54aef80bd2ce0013af8b9e6e61789cb79b7d828e1c172408ec021c225
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/zapzap-bin
	vcopy "squashfs-root/*" opt/zapzap-bin
	vmkdir usr/bin
	ln -sf "/opt/zapzap-bin/AppRun" "${DESTDIR}/usr/bin/zapzap"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
