# Template file for 'dr-robotniks-ring-racers-bin'
pkgname=dr-robotniks-ring-racers-bin
version=2.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Dr. Robotnik's Ring Racers"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Dr-Robotniks-Ring-Racers-AppImage"
distfiles="https://github.com/pkgforge-dev/Dr-Robotniks-Ring-Racers-AppImage/releases/download/${version}%402026-10-01_1790876738/Dr._Robotnik.s_Ring_Racers-${version}-anylinux-x86_64.AppImage>dr-robotniks-ring-racers-bin-${version}.AppImage"
checksum=7b2e0edfb0b8092033f2e98181c0d829ec481f7d4ba243ef0085b174ea701b37
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dr-robotniks-ring-racers-bin
	vcopy "squashfs-root/*" opt/dr-robotniks-ring-racers-bin
	vmkdir usr/bin
	ln -sf "/opt/dr-robotniks-ring-racers-bin/AppRun" "${DESTDIR}/usr/bin/dr-robotniks-ring-racers"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
