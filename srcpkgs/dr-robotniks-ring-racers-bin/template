# Template file for 'dr-robotniks-ring-racers-bin'
pkgname=dr-robotniks-ring-racers-bin
version=20261024
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Dr. Robotnik's Ring Racers"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Dr-Robotniks-Ring-Racers-AppImage"
distfiles="https://github.com/pkgforge-dev/Dr-Robotniks-Ring-Racers-AppImage/releases/download/2.4%402026-10-24_1792826191/Dr._Robotnik.s_Ring_Racers-2.4-anylinux-x86_64.AppImage>dr-robotniks-ring-racers-bin-${version}.AppImage"
checksum=188f9562597872c3727a339a4d0f4cf7a2d9fd6068da47c1985a5cabdae640d6
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dr-robotniks-ring-racers-bin
	vcopy "squashfs-root/*" opt/dr-robotniks-ring-racers-bin
	chmod -R o-w "${DESTDIR}/opt/dr-robotniks-ring-racers-bin"
	vmkdir usr/bin
	ln -sf "/opt/dr-robotniks-ring-racers-bin/AppRun" "${DESTDIR}/usr/bin/dr-robotniks-ring-racers"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
