# Template file for 'supermodel-bin'
pkgname=supermodel-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Supermodel [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Supermodel-AppImage"
distfiles="https://github.com/pkgforge-dev/Supermodel-AppImage/releases/download/8b4de239b%402026-10-01_1790876616/Supermodel-8b4de239b-anylinux-x86_64.AppImage>supermodel-bin-${version}.AppImage"
checksum=b9f85b03c8a9491c06ee2407f8a6e0e7d529b6f810b0dcc43d760434c96f65ec
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/supermodel-bin
	vcopy "squashfs-root/*" opt/supermodel-bin
	vmkdir usr/bin
	ln -sf "/opt/supermodel-bin/AppRun" "${DESTDIR}/usr/bin/supermodel"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
