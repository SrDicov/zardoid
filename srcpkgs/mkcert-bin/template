# Template file for 'mkcert-bin'
pkgname=mkcert-bin
version=1.4.4
revision=1
archs="x86_64*"
short_desc="Simple zero-config tool to make locally trusted development"
maintainer="SrDicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://mkcert.dev"
distfiles="https://github.com/FiloSottile/mkcert/releases/download/v${version}/mkcert-v${version}-linux-amd64"
checksum=6d31c65b03972c6dc4a14ab429f2928300518b26503f58723e532d1b0a3bbb52
nopie=yes
noshlibprovides=yes
nostrip=yes
skip_extraction="mkcert-v1.4.4-linux-amd64"

post_extract() {
	local f='mkcert-v'${version}'-linux-amd64'
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	vbin 'mkcert-v'${version}'-linux-amd64' 'mkcert'
	vlicense "${FILESDIR}/LICENSE"
}
