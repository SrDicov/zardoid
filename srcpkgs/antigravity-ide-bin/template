# Template file for 'antigravity-ide-bin'
pkgname=antigravity-ide-bin
version=2.5.5
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Antigravity IDE [Maintainer=@mnalmahmud]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Antigravity-IDE-AppImage"
distfiles="https://github.com/pkgforge-dev/Antigravity-IDE-AppImage/releases/download/${version}%402026-10-01_1790876643/Antigravity_IDE-${version}-anylinux-x86_64.AppImage>antigravity-ide-bin-${version}.AppImage"
checksum=962045963de82a0486d6e9d540697d9b6ed2602ff52fa39930369b839561afc2
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/antigravity-ide-bin
	vcopy "squashfs-root/*" opt/antigravity-ide-bin
	vmkdir usr/bin
	ln -sf "/opt/antigravity-ide-bin/AppRun" "${DESTDIR}/usr/bin/antigravity-ide"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
