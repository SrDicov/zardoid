# Template file for 'sound-space-plus-bin'
pkgname=sound-space-plus-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of sound-space-plus game
 [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/sound-space-plus-AppImage"
distfiles="https://github.com/pkgforge-dev/sound-space-plus-AppImage/releases/download/jun21-2026%402026-09-01_1788278371/Sound_Space_Plus-jun21-2026-anylinux-x86_64.AppImage>sound-space-plus-bin-${version}.AppImage"
checksum=2306c15f8905cd3c59b68d1034e16c3f5234294bb4d22e27900fb8990b36e414
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/sound-space-plus-bin
	vcopy "squashfs-root/*" opt/sound-space-plus-bin
	vmkdir usr/bin
	ln -sf "/opt/sound-space-plus-bin/AppRun" "${DESTDIR}/usr/bin/sound-space-plus"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
