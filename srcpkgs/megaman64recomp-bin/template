# Template file for 'megaman64recomp-bin'
pkgname=megaman64recomp-bin
version=0.9.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Mega Man 64 Recompiled"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/MegaMan64Recomp-AppImage"
distfiles="https://github.com/pkgforge-dev/MegaMan64Recomp-AppImage/releases/download/${version}%402026-10-01_1790876490/MegaMan64Recompiled-${version}-anylinux-x86_64.AppImage>megaman64recomp-bin-${version}.AppImage"
checksum=e9b987b8e995521ea7f1b44f39096920f552d2b6abbfad8d0895750ed295ee04
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/megaman64recomp-bin
	vcopy "squashfs-root/*" opt/megaman64recomp-bin
	vmkdir usr/bin
	ln -sf "/opt/megaman64recomp-bin/AppRun" "${DESTDIR}/usr/bin/megaman64recomp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
