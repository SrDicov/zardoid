# Template file for 'torzu-bin'
pkgname=torzu-bin
version=20250814
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Torzu, with optimized builds for modern cpus"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/Torzu-AppImage"
distfiles="https://github.com/pkgforge-dev/Torzu-AppImage/releases/download/dee5dca%402025-08-14_1755136039/Torzu-dee5dca-anylinux-x86_64.AppImage>torzu-bin-${version}.AppImage"
checksum=80b6cb09dcb22342696c517dda928d6264196295a705e59b0d29cdd90a627376
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/torzu-bin
	vcopy "squashfs-root/*" opt/torzu-bin
	vmkdir usr/bin
	ln -sf "/opt/torzu-bin/AppRun" "${DESTDIR}/usr/bin/torzu"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
