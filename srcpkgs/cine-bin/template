# Template file for 'cine-bin'
pkgname=cine-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Cine [Maintainer=@TheRealYasri]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Cine-AppImage"
distfiles="https://github.com/pkgforge-dev/Cine-AppImage/releases/download/v1.8.6%402026-10-01_1790876179/Cine-v1.8.6-anylinux-x86_64.AppImage>cine-bin-${version}.AppImage"
checksum=ac9d1921e3d1d0ffe91c249b7eb95562504c8d40e3589fa37d71b77ffb4fe89c
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cine-bin
	vcopy "squashfs-root/*" opt/cine-bin
	vmkdir usr/bin
	ln -sf "/opt/cine-bin/AppRun" "${DESTDIR}/usr/bin/cine"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
