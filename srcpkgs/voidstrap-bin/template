# Template file for 'voidstrap-bin'
pkgname=voidstrap-bin
version=1.1.3.7
revision=1
archs="x86_64"
short_desc="Voidstrap is a simple yet advanced fork of Bloxstrap, advanced"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://voidstrapp.pages.dev"
distfiles="https://github.com/KloBraticc/Voidstrap/releases/download/v${version}/Voidstrap_${version}_x86_64.AppImage>voidstrap-bin-${version}.AppImage"
checksum=7ca1ac61778ebb5251630e1963e74400cc38f0d62e5365792ce1b3ab7183dd93
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/voidstrap-bin
	vcopy "squashfs-root/*" opt/voidstrap-bin
	chmod -R o-w "${DESTDIR}/opt/voidstrap-bin"
	vmkdir usr/bin
	ln -sf "/opt/voidstrap-bin/AppRun" "${DESTDIR}/usr/bin/voidstrap"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
