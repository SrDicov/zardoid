# Template file for 'pokemmo-bin'
pkgname=pokemmo-bin
version=4.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of PokeMMO [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/PokeMMO-AppImage"
distfiles="https://github.com/pkgforge-dev/PokeMMO-AppImage/releases/download/${version}%402026-10-01_1790876351/PokeMMO-${version}-anylinux-x86_64.AppImage>pokemmo-bin-${version}.AppImage"
checksum=7683d61e4326456ab3a8d0a985207da58f8188b4cb41fd8c4de6ca2a0abaf27f
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pokemmo-bin
	vcopy "squashfs-root/*" opt/pokemmo-bin
	vmkdir usr/bin
	ln -sf "/opt/pokemmo-bin/AppRun" "${DESTDIR}/usr/bin/pokemmo"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
