# Template file for 'pokemmo-bin'
pkgname=pokemmo-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of PokeMMO [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/PokeMMO-AppImage"
distfiles="https://github.com/pkgforge-dev/PokeMMO-AppImage/releases/download/4.0%402026-10-22_1792689204/PokeMMO-4.0-anylinux-x86_64.AppImage>pokemmo-bin-${version}.AppImage"
checksum=5811a4c894dcc252b145871252b8e368e6a518516c2ea17ec9434f894e100ca2
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pokemmo-bin
	vcopy "squashfs-root/*" opt/pokemmo-bin
	chmod -R o-w "${DESTDIR}/opt/pokemmo-bin"
	vmkdir usr/bin
	ln -sf "/opt/pokemmo-bin/AppRun" "${DESTDIR}/usr/bin/pokemmo"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
