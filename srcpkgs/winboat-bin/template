# Template file for 'winboat-bin'
pkgname=winboat-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of WinBoat [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/WinBoat-AppImage"
distfiles="https://github.com/pkgforge-dev/WinBoat-AppImage/releases/download/0.9.2-1%402026-10-01_1790876583/winboat-0.9.2-1-anylinux-x86_64.AppImage>winboat-bin-${version}.AppImage"
checksum=8021517dafdef42d73760beccb7974d50fb3a3906abbac03d89b5706acc4ec0c
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/winboat-bin
	vcopy "squashfs-root/*" opt/winboat-bin
	vmkdir usr/bin
	ln -sf "/opt/winboat-bin/AppRun" "${DESTDIR}/usr/bin/winboat"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
