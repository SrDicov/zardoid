# Template file for 'kolourpaint-bin'
pkgname=kolourpaint-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KolourPaint [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KolourPaint-AppImage"
distfiles="https://github.com/pkgforge-dev/KolourPaint-AppImage/releases/download/26.08.2-1%402026-10-22_1792688942/KolourPaint-26.08.2-1-anylinux-x86_64.AppImage>kolourpaint-bin-${version}.AppImage"
checksum=c6e0795a6f27ec6f56696cf7aeffb03a7c91208827b7c2ef8717872446145884
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kolourpaint-bin
	vcopy "squashfs-root/*" opt/kolourpaint-bin
	chmod -R o-w "${DESTDIR}/opt/kolourpaint-bin"
	vmkdir usr/bin
	ln -sf "/opt/kolourpaint-bin/AppRun" "${DESTDIR}/usr/bin/kolourpaint"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
