# Template file for 'extension-manager-bin'
pkgname=extension-manager-bin
version=0.6.5
revision=1
archs="x86_64"
short_desc="Extension-Manager-AppImage [Maintainer=@Shikakiben]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/mjakeman/extension-manager"
distfiles="https://github.com/pkgforge-dev/Extension-Manager-AppImage/releases/download/${version}-1%402026-10-01_1790876636/Extension_Manager-${version}-1-anylinux-x86_64.AppImage>extension-manager-bin-${version}.AppImage"
checksum=3f0f4f78531fa9dfbbf5456df5caf451e6def3af820d9ef5d967a06961bd694e
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/extension-manager-bin
	vcopy "squashfs-root/*" opt/extension-manager-bin
	vmkdir usr/bin
	ln -sf "/opt/extension-manager-bin/AppRun" "${DESTDIR}/usr/bin/extension-manager"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
