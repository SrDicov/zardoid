# Template file for 'extension-manager-bin'
pkgname=extension-manager-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Extension-Manager-AppImage [Maintainer=@Shikakiben]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/mjakeman/extension-manager"
distfiles="https://github.com/pkgforge-dev/Extension-Manager-AppImage/releases/download/0.6.5-1%402026-10-22_1792689413/Extension_Manager-0.6.5-1-anylinux-x86_64.AppImage>extension-manager-bin-${version}.AppImage"
checksum=672e7d038aedadf446f80beb322c1137ad852996e3ff3339231ad4bf614b0162
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/extension-manager-bin
	vcopy "squashfs-root/*" opt/extension-manager-bin
	chmod -R o-w "${DESTDIR}/opt/extension-manager-bin"
	vmkdir usr/bin
	ln -sf "/opt/extension-manager-bin/AppRun" "${DESTDIR}/usr/bin/extension-manager"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
