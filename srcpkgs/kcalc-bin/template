# Template file for 'kcalc-bin'
pkgname=kcalc-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KCalc [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KCalc-AppImage"
distfiles="https://github.com/pkgforge-dev/KCalc-AppImage/releases/download/26.08.2-1%402026-10-22_1792688721/KCalc-26.08.2-1-anylinux-x86_64.AppImage>kcalc-bin-${version}.AppImage"
checksum=cedc4e131c332f4e4a0bbfd04940a387693b981f3ef195400457f2b0478f87fa
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kcalc-bin
	vcopy "squashfs-root/*" opt/kcalc-bin
	chmod -R o-w "${DESTDIR}/opt/kcalc-bin"
	vmkdir usr/bin
	ln -sf "/opt/kcalc-bin/AppRun" "${DESTDIR}/usr/bin/kcalc"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
