# Template file for 'kcalc-bin'
pkgname=kcalc-bin
version=26.08.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KCalc [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KCalc-AppImage"
distfiles="https://github.com/pkgforge-dev/KCalc-AppImage/releases/download/${version}-1%402026-10-01_1790874267/KCalc-${version}-1-anylinux-x86_64.AppImage>kcalc-bin-${version}.AppImage"
checksum=20f8b5804e331ed177822a14e4fac22857c84e44ee3df9eeff30f969cc214144
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kcalc-bin
	vcopy "squashfs-root/*" opt/kcalc-bin
	vmkdir usr/bin
	ln -sf "/opt/kcalc-bin/AppRun" "${DESTDIR}/usr/bin/kcalc"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
