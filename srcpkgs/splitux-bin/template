# Template file for 'splitux-bin'
pkgname=splitux-bin
version=0.20.0
revision=1
archs="x86_64"
short_desc="Local co-op split-screen launcher for Linux"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/splitux-gg/splitux"
distfiles="https://github.com/splitux-gg/splitux/releases/download/v${version}/Splitux-v${version}-x86_64.AppImage>splitux-bin-${version}.AppImage"
checksum=2b653dfaacc0f6fee0233c905311de1704c5448d67981b79f6534fa222c4335a
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/splitux-bin
	vcopy "squashfs-root/*" opt/splitux-bin
	vmkdir usr/bin
	ln -sf "/opt/splitux-bin/AppRun" "${DESTDIR}/usr/bin/splitux"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
