# Template file for 'hp-15c-simulator-bin'
pkgname=hp-15c-simulator-bin
version=5.1.00
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of HP-15C Simulator
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/HP-15C-Simulator-AppImage"
distfiles="https://github.com/pkgforge-dev/HP-15C-Simulator-AppImage/releases/download/${version}%402026-10-01_1790876019/HP-15C-${version}-anylinux-x86_64.AppImage>hp-15c-simulator-bin-${version}.AppImage"
checksum=7aa86ac5309cfeb9e0b89a22f3edb23ff628bd59e75bc575b93b6a2ce8b60cc3
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/hp-15c-simulator-bin
	vcopy "squashfs-root/*" opt/hp-15c-simulator-bin
	vmkdir usr/bin
	ln -sf "/opt/hp-15c-simulator-bin/AppRun" "${DESTDIR}/usr/bin/hp-15c-simulator"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
