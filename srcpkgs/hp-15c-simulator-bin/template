# Template file for 'hp-15c-simulator-bin'
pkgname=hp-15c-simulator-bin
version=20261025
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of HP-15C Simulator
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/HP-15C-Simulator-AppImage"
distfiles="https://github.com/pkgforge-dev/HP-15C-Simulator-AppImage/releases/download/5.1.00%402026-10-25_1792907024/HP-15C-5.1.00-anylinux-x86_64.AppImage>hp-15c-simulator-bin-${version}.AppImage"
checksum=f5ec6835d8436b1c19958dc0ab6cb2091a2684a65c7e40cbc9144f1082aefe66
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/hp-15c-simulator-bin
	vcopy "squashfs-root/*" opt/hp-15c-simulator-bin
	chmod -R o-w "${DESTDIR}/opt/hp-15c-simulator-bin"
	vmkdir usr/bin
	ln -sf "/opt/hp-15c-simulator-bin/AppRun" "${DESTDIR}/usr/bin/hp-15c-simulator"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
