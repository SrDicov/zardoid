# Template file for 'gapless-bin'
pkgname=gapless-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Gapless aka G4Music music player"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Gapless-AppImage"
distfiles="https://github.com/pkgforge-dev/Gapless-AppImage/releases/download/4.6.2-1%402026-10-01_1790876658/Gapless-4.6.2-1-anylinux-x86_64.AppImage>gapless-bin-${version}.AppImage"
checksum=257a0694ae7cd16f90a74f283d5378779f204b561eb549f18af832f1e8fc8171
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gapless-bin
	vcopy "squashfs-root/*" opt/gapless-bin
	vmkdir usr/bin
	ln -sf "/opt/gapless-bin/AppRun" "${DESTDIR}/usr/bin/gapless"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
