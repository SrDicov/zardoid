# Template file for 'uad-ng-bin'
pkgname=uad-ng-bin
version=1.2.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of uad-ng [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/uad-ng-AppImage"
distfiles="https://github.com/pkgforge-dev/uad-ng-AppImage/releases/download/v${version}%402026-10-01_1790870877/Universal_Android_Debloater_Next_Generation-v${version}-anylinux-x86_64.AppImage>uad-ng-bin-${version}.AppImage"
checksum=91e9d87b29a80ed8515dd7c5a15423b7987031f671c9596150448d4b56e443ce
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/uad-ng-bin
	vcopy "squashfs-root/*" opt/uad-ng-bin
	vmkdir usr/bin
	ln -sf "/opt/uad-ng-bin/AppRun" "${DESTDIR}/usr/bin/uad-ng"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
