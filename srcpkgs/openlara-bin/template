# Template file for 'openlara-bin'
pkgname=openlara-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenLara [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenLara-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenLara-AppImage/releases/download/3b268ca4b%402026-10-22_1792689432/OpenLara-3b268ca4b-anylinux-x86_64.AppImage>openlara-bin-${version}.AppImage"
checksum=763a61e58819d7e179010035f551eb87b4c99b7f9c5b42a334e569a74aede921
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openlara-bin
	vcopy "squashfs-root/*" opt/openlara-bin
	chmod -R o-w "${DESTDIR}/opt/openlara-bin"
	vmkdir usr/bin
	ln -sf "/opt/openlara-bin/AppRun" "${DESTDIR}/usr/bin/openlara"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
