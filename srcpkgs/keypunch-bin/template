# Template file for 'keypunch-bin'
pkgname=keypunch-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Keypunch keyboard writing speed test
 application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Keypunch-AppImage"
distfiles="https://github.com/pkgforge-dev/Keypunch-AppImage/releases/download/v7.0%402026-10-22_1792689031/Keypunch-v7.0-anylinux-x86_64.AppImage>keypunch-bin-${version}.AppImage"
checksum=972c137cbde5c73b89f07ef7be64f3b5e696e4a7b378a16adbc3edf0a53d862a
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/keypunch-bin
	vcopy "squashfs-root/*" opt/keypunch-bin
	chmod -R o-w "${DESTDIR}/opt/keypunch-bin"
	vmkdir usr/bin
	ln -sf "/opt/keypunch-bin/AppRun" "${DESTDIR}/usr/bin/keypunch"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
