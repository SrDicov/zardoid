# Template file for 'keypunch-bin'
pkgname=keypunch-bin
version=7.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Keypunch keyboard writing speed test
 application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Keypunch-AppImage"
distfiles="https://github.com/pkgforge-dev/Keypunch-AppImage/releases/download/v${version}%402026-10-01_1790876172/Keypunch-v${version}-anylinux-x86_64.AppImage>keypunch-bin-${version}.AppImage"
checksum=181ddff05f75e8096df76a2ee5726973048012e9f2ac0b84aad6b8ce03d3dd4a
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/keypunch-bin
	vcopy "squashfs-root/*" opt/keypunch-bin
	vmkdir usr/bin
	ln -sf "/opt/keypunch-bin/AppRun" "${DESTDIR}/usr/bin/keypunch"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
