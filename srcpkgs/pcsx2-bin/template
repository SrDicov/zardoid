# Template file for 'pcsx2-bin'
pkgname=pcsx2-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of PCSX2 that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/PCSX2-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/PCSX2-AppImage-Enhanced/releases/download/2.9.93.r0.g94d86c8-1%402026-10-01_1790870869/PCSX2-2.9.93.r0.g94d86c8-1-anylinux-x86_64.AppImage>pcsx2-bin-${version}.AppImage"
checksum=f3db85835ffd17d26103f66a6e48702ca4e1254d8b79c4d61970367bd6614a64
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pcsx2-bin
	vcopy "squashfs-root/*" opt/pcsx2-bin
	vmkdir usr/bin
	ln -sf "/opt/pcsx2-bin/AppRun" "${DESTDIR}/usr/bin/pcsx2"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
