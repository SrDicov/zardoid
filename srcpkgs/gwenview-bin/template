# Template file for 'gwenview-bin'
pkgname=gwenview-bin
version=20260907
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Gwenview [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Gwenview-AppImage"
distfiles="https://github.com/pkgforge-dev/Gwenview-AppImage/releases/download/26.08.0-1%402026-09-07_1788786716/Gwenview-26.08.0-1-anylinux-x86_64.AppImage>gwenview-bin-${version}.AppImage"
checksum=073bbd4109bad00ab2503191cbb292acdfb17dcbe99d2d8d9ea2c2703f456a50
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gwenview-bin
	vcopy "squashfs-root/*" opt/gwenview-bin
	vmkdir usr/bin
	ln -sf "/opt/gwenview-bin/AppRun" "${DESTDIR}/usr/bin/gwenview"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
