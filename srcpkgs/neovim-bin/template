# Template file for 'neovim-bin'
pkgname=neovim-bin
version=0.12.6
revision=1
archs="x86_64"
short_desc="Vim-fork focused on extensibility and usability"
maintainer="SrDicov <SrDicov@gmail.com>"
license="Apache-2.0"
homepage="https://neovim.io"
distfiles="https://github.com/neovim/neovim/releases/download/v${version}/nvim-linux-x86_64.appimage>neovim-bin-${version}.AppImage"
checksum=b644d034746aed32f4e918be9fc6147408ce4ecd360fedd7130da543c35f29fb
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/neovim-bin
	vcopy "squashfs-root/*" opt/neovim-bin
	vmkdir usr/bin
	ln -sf "/opt/neovim-bin/AppRun" "${DESTDIR}/usr/bin/neovim"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
