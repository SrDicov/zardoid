# Template file for 'desmume-bin'
pkgname=desmume-bin
version=0.9.13
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the DeSmuME emulator.
 [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/DeSmuME-AppImage"
distfiles="https://github.com/pkgforge-dev/DeSmuME-AppImage/releases/download/${version}-2%402026-10-01_1790876326/DeSmuME-${version}-2-anylinux-x86_64.AppImage>desmume-bin-${version}.AppImage"
checksum=cd8b50891064f47eb74eef122ea905cb8cc4394dca5e4e28540279f28c192bed
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/desmume-bin
	vcopy "squashfs-root/*" opt/desmume-bin
	vmkdir usr/bin
	ln -sf "/opt/desmume-bin/AppRun" "${DESTDIR}/usr/bin/desmume"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
