# Template file for 'gearlever-bin'
pkgname=gearlever-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Gear Lever AppImage manager application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Gear-Lever-AppImage"
distfiles="https://github.com/pkgforge-dev/Gear-Lever-AppImage/releases/download/4.6.2-1%402026-10-01_1790876517/Gear_Lever-4.6.2-1-anylinux-x86_64.AppImage>gearlever-bin-${version}.AppImage"
checksum=ad121ffd2f3914666f9b516827e4d868b4ef79adc2ccacf3015c976393a216c0
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gearlever-bin
	vcopy "squashfs-root/*" opt/gearlever-bin
	vmkdir usr/bin
	ln -sf "/opt/gearlever-bin/AppRun" "${DESTDIR}/usr/bin/gearlever"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
