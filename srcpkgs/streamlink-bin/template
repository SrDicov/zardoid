# Template file for 'streamlink-bin'
pkgname=streamlink-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Streamlink [Maintainer=@domesya]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Streamlink-AppImage"
distfiles="https://github.com/pkgforge-dev/Streamlink-AppImage/releases/download/8.6.1-1%402026-10-01_1790876494/streamlink-8.6.1-1-anylinux-x86_64.AppImage>streamlink-bin-${version}.AppImage"
checksum=f0d9703d32544314dc46ae6acb74600aedc17388df01b27f86a4120112b695ce
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/streamlink-bin
	vcopy "squashfs-root/*" opt/streamlink-bin
	vmkdir usr/bin
	ln -sf "/opt/streamlink-bin/AppRun" "${DESTDIR}/usr/bin/streamlink"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
