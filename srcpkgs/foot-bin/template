# Template file for 'foot-bin'
pkgname=foot-bin
version=1.28.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of foot that can also work in x11"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/foot-AppImage"
distfiles="https://github.com/pkgforge-dev/foot-AppImage/releases/download/${version}-2%402026-10-01_1790876300/Foot-${version}-2-anylinux-x86_64.AppImage>foot-bin-${version}.AppImage"
checksum=4b8556cb5916ce5fcf9f88c41b6bef0307ad417bf350249c04fb47f420b01c19
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/foot-bin
	vcopy "squashfs-root/*" opt/foot-bin
	vmkdir usr/bin
	ln -sf "/opt/foot-bin/AppRun" "${DESTDIR}/usr/bin/foot"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
