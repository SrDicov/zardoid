# Template file for 'qelectrotech-bin'
pkgname=qelectrotech-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of QElectroTech. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/QElectroTech-AppImage"
distfiles="https://github.com/pkgforge-dev/QElectroTech-AppImage/releases/download/0.100-1%402026-10-22_1792689068/QElectroTech-0.100-1-anylinux-x86_64.AppImage>qelectrotech-bin-${version}.AppImage"
checksum=50fe3a3bb8f80eaee0a6b459d027848ae0507c7479562580b07168ba47252d06
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/qelectrotech-bin
	vcopy "squashfs-root/*" opt/qelectrotech-bin
	chmod -R o-w "${DESTDIR}/opt/qelectrotech-bin"
	vmkdir usr/bin
	ln -sf "/opt/qelectrotech-bin/AppRun" "${DESTDIR}/usr/bin/qelectrotech"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
