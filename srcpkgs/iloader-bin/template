# Template file for 'iloader-bin'
pkgname=iloader-bin
version=2.3.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of iloader that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/iloader-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/iloader-AppImage-Enhanced/releases/download/v${version}%402026-10-01_1790867368/iloader-v${version}-anylinux-x86_64.AppImage>iloader-bin-${version}.AppImage"
checksum=32f818d5fb008b4a0300fecae877a068b5478edbfb4f1d02405f5020fb238788
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/iloader-bin
	vcopy "squashfs-root/*" opt/iloader-bin
	vmkdir usr/bin
	ln -sf "/opt/iloader-bin/AppRun" "${DESTDIR}/usr/bin/iloader"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
