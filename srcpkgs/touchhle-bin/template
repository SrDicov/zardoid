# Template file for 'touchhle-bin'
pkgname=touchhle-bin
version=0.3.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of touchHLE [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/TouchHLE-AppImage"
distfiles="https://github.com/pkgforge-dev/TouchHLE-AppImage/releases/download/v${version}%402026-10-01_1790876273/touchHLE-v${version}-anylinux-x86_64.AppImage>touchhle-bin-${version}.AppImage"
checksum=ef1e6697a6cf59540db04bcc21c329498f47154fb6a15564e226ad16ab57a973
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/touchhle-bin
	vcopy "squashfs-root/*" opt/touchhle-bin
	vmkdir usr/bin
	ln -sf "/opt/touchhle-bin/AppRun" "${DESTDIR}/usr/bin/touchhle"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
