# Template file for 'openxray-bin'
pkgname=openxray-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenXRay [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenXRay-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenXRay-AppImage/releases/download/d4979c2bc%402026-10-01_1790876469/OpenXRay-d4979c2bc-anylinux-x86_64.AppImage>openxray-bin-${version}.AppImage"
checksum=c8397fd0d2bc76a7464f82517df2097b30b4fdd057920ab71e5d2d57ae3521e7
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openxray-bin
	vcopy "squashfs-root/*" opt/openxray-bin
	vmkdir usr/bin
	ln -sf "/opt/openxray-bin/AppRun" "${DESTDIR}/usr/bin/openxray"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
