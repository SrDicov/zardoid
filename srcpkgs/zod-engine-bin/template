# Template file for 'zod-engine-bin'
pkgname=zod-engine-bin
version=20110906
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Zod Engine [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Zod-Engine-AppImage"
distfiles="https://github.com/pkgforge-dev/Zod-Engine-AppImage/releases/download/2011-09-06%402026-09-01_1788265439/Zod_Engine-2011-09-06-anylinux-x86_64.AppImage>zod-engine-bin-${version}.AppImage"
checksum=810c1c7eb87eecb63ea3eecab18275d5e16e76fcf751b87084b87ecba0cef34d
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/zod-engine-bin
	vcopy "squashfs-root/*" opt/zod-engine-bin
	vmkdir usr/bin
	ln -sf "/opt/zod-engine-bin/AppRun" "${DESTDIR}/usr/bin/zod-engine"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
