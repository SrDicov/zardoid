# Template file for 'openjazz-bin'
pkgname=openjazz-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenJazz [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenJazz-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenJazz-AppImage/releases/download/a1626f4ed%402026-10-01_1790863901/OpenJazz-a1626f4ed-anylinux-x86_64.AppImage>openjazz-bin-${version}.AppImage"
checksum=fac090e7bd49445a3877fc71f954b84f113403c6a85ea77720470c10236e1b07
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openjazz-bin
	vcopy "squashfs-root/*" opt/openjazz-bin
	vmkdir usr/bin
	ln -sf "/opt/openjazz-bin/AppRun" "${DESTDIR}/usr/bin/openjazz"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
