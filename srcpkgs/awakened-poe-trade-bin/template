# Template file for 'awakened-poe-trade-bin'
pkgname=awakened-poe-trade-bin
version=3.29.108
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Awakened POE Trade [Maintainer=@fiftydinar]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Awakened-POE-Trade-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Awakened-POE-Trade-AppImage-Enhanced/releases/download/${version}%402026-10-01_1790876525/Awakened_PoE_Trade-${version}-anylinux-x86_64.AppImage>awakened-poe-trade-bin-${version}.AppImage"
checksum=9f5db89ec594a4cc979d2bb3bdf3f60d9ac1b6aa9a0d506fa58cd29ab0fc2b21
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/awakened-poe-trade-bin
	vcopy "squashfs-root/*" opt/awakened-poe-trade-bin
	vmkdir usr/bin
	ln -sf "/opt/awakened-poe-trade-bin/AppRun" "${DESTDIR}/usr/bin/awakened-poe-trade"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
