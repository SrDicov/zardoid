# Template file for 'awakened-poe-trade-bin'
pkgname=awakened-poe-trade-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Awakened POE Trade [Maintainer=@fiftydinar]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Awakened-POE-Trade-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Awakened-POE-Trade-AppImage-Enhanced/releases/download/3.29.108%402026-10-22_1792688414/Awakened_PoE_Trade-3.29.108-anylinux-x86_64.AppImage>awakened-poe-trade-bin-${version}.AppImage"
checksum=a67f207c4e12e8db19ebd9612da5c93cc1f90e981be1bcbaa0ae34a535a90216
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/awakened-poe-trade-bin
	vcopy "squashfs-root/*" opt/awakened-poe-trade-bin
	chmod -R o-w "${DESTDIR}/opt/awakened-poe-trade-bin"
	vmkdir usr/bin
	ln -sf "/opt/awakened-poe-trade-bin/AppRun" "${DESTDIR}/usr/bin/awakened-poe-trade"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
