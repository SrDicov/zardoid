# Template file for 'srb2-bin'
pkgname=srb2-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of SRB2 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SRB2-AppImage"
distfiles="https://github.com/pkgforge-dev/SRB2-AppImage/releases/download/2.2.15%402026-10-01_1790876573/Sonic_Robo_Blast_2-2.2.15-anylinux-x86_64.AppImage>srb2-bin-${version}.AppImage"
checksum=1d2cfcde56970e16684403d2e12542ab03897d9a406e1e996da4b932f3bd01aa
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/srb2-bin
	vcopy "squashfs-root/*" opt/srb2-bin
	chmod -R o-w "${DESTDIR}/opt/srb2-bin"
	vmkdir usr/bin
	ln -sf "/opt/srb2-bin/AppRun" "${DESTDIR}/usr/bin/srb2"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
