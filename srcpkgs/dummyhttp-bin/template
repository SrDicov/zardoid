# Template file for 'dummyhttp-bin'
pkgname=dummyhttp-bin
version=1.1.3
revision=1
archs="x86_64"
short_desc="Super simple HTTP server that replies a fixed body with a fixed
 response"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/svenstaro/dummyhttp"
distfiles="https://github.com/svenstaro/dummyhttp/releases/download/v${version}/dummyhttp-${version}-x86_64-unknown-linux-gnu"
checksum=2b315b5d79a7d1e30bd7747c361cf56a8d425a7c3901bf402146cbd4972375ff
noshlibprovides=yes
nostrip=yes
skip_extraction="dummyhttp-1.1.3-x86_64-unknown-linux-gnu"

post_extract() {
	local f='dummyhttp-'${version}'-x86_64-unknown-linux-gnu'
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	vbin 'dummyhttp-'${version}'-x86_64-unknown-linux-gnu' 'dummyhttp'
	vlicense "${FILESDIR}/LICENSE"
}
