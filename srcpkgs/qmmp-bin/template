# Template file for 'qmmp-bin'
pkgname=qmmp-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Qmmp [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Qmmp-AppImage"
distfiles="https://github.com/pkgforge-dev/Qmmp-AppImage/releases/download/2.4.2-1%402026-10-22_1792689219/Qmmp-2.4.2-1-anylinux-x86_64.AppImage>qmmp-bin-${version}.AppImage"
checksum=8551625b0012ba5c3d28e6713850b9a292965d9af207ccb5651bd7ac306bae41
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/qmmp-bin
	vcopy "squashfs-root/*" opt/qmmp-bin
	chmod -R o-w "${DESTDIR}/opt/qmmp-bin"
	vmkdir usr/bin
	ln -sf "/opt/qmmp-bin/AppRun" "${DESTDIR}/usr/bin/qmmp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
