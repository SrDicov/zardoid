# Template file for 'img2pdf-bin'
pkgname=img2pdf-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of im2pdf [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/img2pdf-AppImage"
distfiles="https://github.com/pkgforge-dev/img2pdf-AppImage/releases/download/0.6.3-1%402026-10-01_1790876610/img2pdf-0.6.3-1-anylinux-x86_64.AppImage>img2pdf-bin-${version}.AppImage"
checksum=55c9946c30e80e9d6d0b5b9728f75915d9b59ba70568ea79f47c764045fd0342
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/img2pdf-bin
	vcopy "squashfs-root/*" opt/img2pdf-bin
	vmkdir usr/bin
	ln -sf "/opt/img2pdf-bin/AppRun" "${DESTDIR}/usr/bin/img2pdf"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
