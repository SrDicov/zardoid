# Template file for 'newsflash-bin'
pkgname=newsflash-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the NewsFlash RSS reader"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/NewsFlash-AppImage"
distfiles="https://github.com/pkgforge-dev/NewsFlash-AppImage/releases/download/5.2.3-1%402026-10-22_1792688923/Newsflash-5.2.5-1-anylinux-x86_64.AppImage>newsflash-bin-${version}.AppImage"
checksum=cc2df8ca3b0be8e3f2252b57e529560633b577b393161420abc19e5e0189c41a
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/newsflash-bin
	vcopy "squashfs-root/*" opt/newsflash-bin
	chmod -R o-w "${DESTDIR}/opt/newsflash-bin"
	vmkdir usr/bin
	ln -sf "/opt/newsflash-bin/AppRun" "${DESTDIR}/usr/bin/newsflash"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
