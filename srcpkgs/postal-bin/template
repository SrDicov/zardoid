# Template file for 'postal-bin'
pkgname=postal-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of POSTAL [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/POSTAL-AppImage"
distfiles="https://github.com/pkgforge-dev/POSTAL-AppImage/releases/download/adb5a30c1%402026-10-01_1790876461/POSTAL-adb5a30c1-anylinux-x86_64.AppImage>postal-bin-${version}.AppImage"
checksum=41a46229e6b9ef7aac491ec410891fbb959ac70a4a4931fc55e0b32288d010fb
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/postal-bin
	vcopy "squashfs-root/*" opt/postal-bin
	vmkdir usr/bin
	ln -sf "/opt/postal-bin/AppRun" "${DESTDIR}/usr/bin/postal"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
