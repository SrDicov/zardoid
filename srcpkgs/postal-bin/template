# Template file for 'postal-bin'
pkgname=postal-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of POSTAL [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/POSTAL-AppImage"
distfiles="https://github.com/pkgforge-dev/POSTAL-AppImage/releases/download/adb5a30c1%402026-10-22_1792688999/POSTAL-adb5a30c1-anylinux-x86_64.AppImage>postal-bin-${version}.AppImage"
checksum=bbad2eff68865fd3ab36dc1ba6e63df58daa449401d2f8880cceca55f05e8da6
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/postal-bin
	vcopy "squashfs-root/*" opt/postal-bin
	chmod -R o-w "${DESTDIR}/opt/postal-bin"
	vmkdir usr/bin
	ln -sf "/opt/postal-bin/AppRun" "${DESTDIR}/usr/bin/postal"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
