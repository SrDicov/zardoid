# Template file for 'zen-browser-bin'
pkgname=zen-browser-bin
version=1.23.3b
revision=1
archs="x86_64"
short_desc="Welcome to a calmer internet"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MPL-2.0"
homepage="https://zen-browser.app"
distfiles="https://github.com/zen-browser/desktop/releases/download/${version}/zen-x86_64.AppImage>zen-browser-bin-${version}.AppImage"
checksum=8f6b7a55ae8fd013147f40f592d12188dd26f19f4a4748e01b51e9747bd44bac
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/zen-browser-bin
	vcopy "squashfs-root/*" opt/zen-browser-bin
	vmkdir usr/bin
	ln -sf "/opt/zen-browser-bin/AppRun" "${DESTDIR}/usr/bin/zen-browser"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
