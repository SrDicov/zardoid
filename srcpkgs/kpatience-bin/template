# Template file for 'kpatience-bin'
pkgname=kpatience-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KPatience [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KPatience-AppImage"
distfiles="https://github.com/pkgforge-dev/KPatience-AppImage/releases/download/26.08.2-1%402026-10-22_1792688818/KPatience-26.08.2-1-anylinux-x86_64.AppImage>kpatience-bin-${version}.AppImage"
checksum=8f9bcd9d312cd30a10c6e4908cfa59e64186428af534a7083423557ec0c4585e
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kpatience-bin
	vcopy "squashfs-root/*" opt/kpatience-bin
	chmod -R o-w "${DESTDIR}/opt/kpatience-bin"
	vmkdir usr/bin
	ln -sf "/opt/kpatience-bin/AppRun" "${DESTDIR}/usr/bin/kpatience"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
