# Template file for 'vibeprint-studio-bin'
pkgname=vibeprint-studio-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Vibeprint Studio
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Vibeprint-Studio-AppImage"
distfiles="https://github.com/pkgforge-dev/Vibeprint-Studio-AppImage/releases/download/4b1d0b3df%402026-10-22_1792688897/Vibeprint_Studio-4b1d0b3df-anylinux-x86_64.AppImage>vibeprint-studio-bin-${version}.AppImage"
checksum=2a4864f5aa60ee32619dc94979976a706f0a96c5929ccab01783f0c76ef80804
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/vibeprint-studio-bin
	vcopy "squashfs-root/*" opt/vibeprint-studio-bin
	chmod -R o-w "${DESTDIR}/opt/vibeprint-studio-bin"
	vmkdir usr/bin
	ln -sf "/opt/vibeprint-studio-bin/AppRun" "${DESTDIR}/usr/bin/vibeprint-studio"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
