# Template file for 'ktorrent-bin'
pkgname=ktorrent-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KTorrent [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KTorrent-AppImage"
distfiles="https://github.com/pkgforge-dev/KTorrent-AppImage/releases/download/26.08.2-1%402026-10-22_1792689027/KTorrent-26.08.2-1-anylinux-x86_64.AppImage>ktorrent-bin-${version}.AppImage"
checksum=13090ba1be6a648dcdf518a89b344e5e245fc8abbe380ab9acd1a2946c1a7028
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ktorrent-bin
	vcopy "squashfs-root/*" opt/ktorrent-bin
	chmod -R o-w "${DESTDIR}/opt/ktorrent-bin"
	vmkdir usr/bin
	ln -sf "/opt/ktorrent-bin/AppRun" "${DESTDIR}/usr/bin/ktorrent"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
