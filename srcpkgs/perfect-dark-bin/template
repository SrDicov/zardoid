# Template file for 'perfect-dark-bin'
pkgname=perfect-dark-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Perfect Dark [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Perfect-Dark-AppImage"
distfiles="https://github.com/pkgforge-dev/Perfect-Dark-AppImage/releases/download/32a1cb9f2%402026-10-01_1790876698/Perfect_Dark-32a1cb9f2-anylinux-x86_64.AppImage>perfect-dark-bin-${version}.AppImage"
checksum=34c87304b7045ac8c90ecfef495d4aea5cec71b36976dcfe0b7b05f8a524a9b9
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/perfect-dark-bin
	vcopy "squashfs-root/*" opt/perfect-dark-bin
	vmkdir usr/bin
	ln -sf "/opt/perfect-dark-bin/AppRun" "${DESTDIR}/usr/bin/perfect-dark"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
