# Template file for 'claude-desktop-bin'
pkgname=claude-desktop-bin
version=2.37337.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Claude Desktop [Maintainer=@mnalmahmud]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Claude-Desktop-AppImage"
distfiles="https://github.com/pkgforge-dev/Claude-Desktop-AppImage/releases/download/${version}%402026-10-15_1792067545/Claude-${version}-anylinux-x86_64.AppImage>claude-desktop-bin-${version}.AppImage"
checksum=ed6da5f4cd18794d6b316e548f32e9c78957ab697a7fefc5346dd3addcaf7781
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/claude-desktop-bin
	vcopy "squashfs-root/*" opt/claude-desktop-bin
	vmkdir usr/bin
	ln -sf "/opt/claude-desktop-bin/AppRun" "${DESTDIR}/usr/bin/claude-desktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
