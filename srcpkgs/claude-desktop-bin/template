# Template file for 'claude-desktop-bin'
pkgname=claude-desktop-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Claude Desktop [Maintainer=@mnalmahmud]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Claude-Desktop-AppImage"
distfiles="https://github.com/pkgforge-dev/Claude-Desktop-AppImage/releases/download/3.1623.4%402026-10-22_1792689049/Claude-3.1623.4-anylinux-x86_64.AppImage>claude-desktop-bin-${version}.AppImage"
checksum=b7dcd778f20079836179aa41703f8ac482a6dc7530fa78c6aef70553d75bb417
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/claude-desktop-bin
	vcopy "squashfs-root/*" opt/claude-desktop-bin
	chmod -R o-w "${DESTDIR}/opt/claude-desktop-bin"
	vmkdir usr/bin
	ln -sf "/opt/claude-desktop-bin/AppRun" "${DESTDIR}/usr/bin/claude-desktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
