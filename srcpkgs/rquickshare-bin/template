# Template file for 'rquickshare-bin'
pkgname=rquickshare-bin
version=0.11.5
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of rquickshare that can work on any linux
 system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/rquickshare-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/rquickshare-AppImage-Enhanced/releases/download/${version}-3%402026-10-01_1790876521/RQuickShare-${version}-3-anylinux-x86_64.AppImage>rquickshare-bin-${version}.AppImage"
checksum=317fbf3c72cd6feeba7391f63831c873213c0bbfe981a074d51bd4911563d58b
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rquickshare-bin
	vcopy "squashfs-root/*" opt/rquickshare-bin
	vmkdir usr/bin
	ln -sf "/opt/rquickshare-bin/AppRun" "${DESTDIR}/usr/bin/rquickshare"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
