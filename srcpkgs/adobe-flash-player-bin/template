# Template file for 'adobe-flash-player-bin'
pkgname=adobe-flash-player-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Over 67 billion devices use adobe flash player!
 [Maintainer=@fiftydinar]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Adobe-Flash-Player-AppImage"
distfiles="https://github.com/pkgforge-dev/Adobe-Flash-Player-AppImage/releases/download/32.0.0.465-1%402026-10-22_1792685844/Adobe_Flash_Player_Standalone-32.0.0.465-1-anylinux-x86_64.AppImage>adobe-flash-player-bin-${version}.AppImage"
checksum=7bd2eaea4fa79dab58c6691cde20cc8e46440c32aadfaefc881018a8b6d70636
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/adobe-flash-player-bin
	vcopy "squashfs-root/*" opt/adobe-flash-player-bin
	chmod -R o-w "${DESTDIR}/opt/adobe-flash-player-bin"
	vmkdir usr/bin
	ln -sf "/opt/adobe-flash-player-bin/AppRun" "${DESTDIR}/usr/bin/adobe-flash-player"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
