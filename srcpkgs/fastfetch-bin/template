	vinstall 'usr/share/zsh/site-functions/_fastfetch' 644 usr/share/zsh/site-functions
	vinstall 'usr/share/bash-completion/completions/fastfetch' 644 usr/share/bash-completion/completions 'fastfetch'
	vlicense 'usr/share/licenses/fastfetch/LICENSE'
}
