# Template file for 'prey2006-bin'
pkgname=prey2006-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Prey 2006 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Prey2006-AppImage"
distfiles="https://github.com/pkgforge-dev/Prey2006-AppImage/releases/download/983b171cf%402026-10-22_1792676297/Prey_2006-983b171cf-anylinux-x86_64.AppImage>prey2006-bin-${version}.AppImage"
checksum=d1637e8df459e173bd8f3995e7fc82ec334bf907a7a679429e7fa239fec233df
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/prey2006-bin
	vcopy "squashfs-root/*" opt/prey2006-bin
	chmod -R o-w "${DESTDIR}/opt/prey2006-bin"
	vmkdir usr/bin
	ln -sf "/opt/prey2006-bin/AppRun" "${DESTDIR}/usr/bin/prey2006"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
