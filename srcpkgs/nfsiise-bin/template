# Template file for 'nfsiise-bin'
pkgname=nfsiise-bin
version=20260911
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of NFSIISE [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/NFSIISE-AppImage"
distfiles="https://github.com/pkgforge-dev/NFSIISE-AppImage/releases/download/fde04b571%402026-09-11_1789102637/Need_For_Speed_II_SE-fde04b571-anylinux-x86_64.AppImage>nfsiise-bin-${version}.AppImage"
checksum=acc72070f371650a4c521dd53f02ece9f195d9e7a21218077936b272db2fbe04
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/nfsiise-bin
	vcopy "squashfs-root/*" opt/nfsiise-bin
	vmkdir usr/bin
	ln -sf "/opt/nfsiise-bin/AppRun" "${DESTDIR}/usr/bin/nfsiise"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
