# Template file for 'gimp-bin'
pkgname=gimp-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of GIMP that also includes PhotoGIMP"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/GIMP-and-PhotoGIMP-AppImage"
distfiles="https://github.com/pkgforge-dev/GIMP-and-PhotoGIMP-AppImage/releases/download/3.2.6-2%402026-10-01_1790873442/GIMP-3.2.6-2-anylinux-x86_64.AppImage>gimp-bin-${version}.AppImage"
checksum=31cf2253c3cf343a18b0b0119eb1ce27ec9cc2b60547d31df2e744af1d9b046e
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gimp-bin
	vcopy "squashfs-root/*" opt/gimp-bin
	vmkdir usr/bin
	ln -sf "/opt/gimp-bin/AppRun" "${DESTDIR}/usr/bin/gimp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
