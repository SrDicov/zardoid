# Template file for 'dreamm-bin'
pkgname=dreamm-bin
version=4.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of DREAMM [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/DREAMM-AppImage"
distfiles="https://github.com/pkgforge-dev/DREAMM-AppImage/releases/download/${version}%402026-09-01_1788277909/DREAMM-${version}-anylinux-x86_64.AppImage>dreamm-bin-${version}.AppImage"
checksum=840c0bd98b7537f69c92a4a44a08691c591e6e959e8f7b967ed57692a2f243c7
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dreamm-bin
	vcopy "squashfs-root/*" opt/dreamm-bin
	vmkdir usr/bin
	ln -sf "/opt/dreamm-bin/AppRun" "${DESTDIR}/usr/bin/dreamm"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
