# Template file for 'quantumlauncher-bin'
pkgname=quantumlauncher-bin
version=0.5.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of QuantumLauncher that is able to work on any
 linux"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/QuantumLauncher-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/QuantumLauncher-AppImage-Enhanced/releases/download/${version}-2%402026-10-01_1790866740/QuantumLauncher-${version}-2-anylinux-x86_64.AppImage>quantumlauncher-bin-${version}.AppImage"
checksum=3a2609ee9dd079be460109ec27fbf2433694e894b05b2e356f4ffe916975c2c7
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/quantumlauncher-bin
	vcopy "squashfs-root/*" opt/quantumlauncher-bin
	vmkdir usr/bin
	ln -sf "/opt/quantumlauncher-bin/AppRun" "${DESTDIR}/usr/bin/quantumlauncher"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
