# Template file for 'quantumlauncher-bin'
pkgname=quantumlauncher-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of QuantumLauncher that is able to work on any
 linux"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/QuantumLauncher-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/QuantumLauncher-AppImage-Enhanced/releases/download/0.5.1-2%402026-10-22_1792689264/QuantumLauncher-0.5.1-2-anylinux-x86_64.AppImage>quantumlauncher-bin-${version}.AppImage"
checksum=6f0070f128e3cbaefd71c9be1cac82d8d60f4d2b60be716257342633d054a97a
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/quantumlauncher-bin
	vcopy "squashfs-root/*" opt/quantumlauncher-bin
	chmod -R o-w "${DESTDIR}/opt/quantumlauncher-bin"
	vmkdir usr/bin
	ln -sf "/opt/quantumlauncher-bin/AppRun" "${DESTDIR}/usr/bin/quantumlauncher"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
