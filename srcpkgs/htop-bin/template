# Template file for 'htop-bin'
pkgname=htop-bin
version=3.5.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of htop. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/htop-AppImage"
distfiles="https://github.com/pkgforge-dev/htop-AppImage/releases/download/${version}%402026-10-02_1790947336/Htop-${version}-anylinux-x86_64.AppImage>htop-bin-${version}.AppImage"
checksum=6d5c48fb0a6f72be9e33f6b3746a37597aef36424bf620ef7d4413269bb7a248
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/htop-bin
	vcopy "squashfs-root/*" opt/htop-bin
	vmkdir usr/bin
	ln -sf "/opt/htop-bin/AppRun" "${DESTDIR}/usr/bin/htop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
