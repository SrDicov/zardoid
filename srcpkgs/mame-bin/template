# Template file for 'mame-bin'
pkgname=mame-bin
version=0.289
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of MAME [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/MAME-AppImage"
distfiles="https://github.com/pkgforge-dev/MAME-AppImage/releases/download/${version}-1%402026-09-01_1788278259/MAME-${version}-1-anylinux-x86_64.AppImage>mame-bin-${version}.AppImage"
checksum=af7595453acdab0d290c90699ce3f999d653f1fa2820182ef628eb7dd2111b51
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/mame-bin
	vcopy "squashfs-root/*" opt/mame-bin
	vmkdir usr/bin
	ln -sf "/opt/mame-bin/AppRun" "${DESTDIR}/usr/bin/mame"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
