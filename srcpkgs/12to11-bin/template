# Template file for '12to11-bin'
pkgname=12to11-bin
version=0.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of 12to11 [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/12to11-AppImage"
distfiles="https://github.com/pkgforge-dev/12to11-AppImage/releases/download/${version}-1%402026-09-01_1788277686/12to11-${version}-1-anylinux-x86_64.AppImage>12to11-bin-${version}.AppImage"
checksum=2cccd7b8aae3ad6e9f6f8d667b4d33c9b1184c63b3b8816993fbbd6333a95e77
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/12to11-bin
	vcopy "squashfs-root/*" opt/12to11-bin
	vmkdir usr/bin
	ln -sf "/opt/12to11-bin/AppRun" "${DESTDIR}/usr/bin/12to11"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
