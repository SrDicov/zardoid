# Template file for 'tux-football-bin'
pkgname=tux-football-bin
version=0.3.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Tux Football game [Maintainer=@fiftydinar]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Tux-Football-AppImage"
distfiles="https://github.com/pkgforge-dev/Tux-Football-AppImage/releases/download/${version}-1%402026-09-01_1788278343/Tux_Football-${version}-1-anylinux-x86_64.AppImage>tux-football-bin-${version}.AppImage"
checksum=e29ab0a52d2efa23597d0bb2570ea7c2abc8760207ef0f520f7a5cfbac0d0b43
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/tux-football-bin
	vcopy "squashfs-root/*" opt/tux-football-bin
	vmkdir usr/bin
	ln -sf "/opt/tux-football-bin/AppRun" "${DESTDIR}/usr/bin/tux-football"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
