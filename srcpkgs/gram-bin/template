# Template file for 'gram-bin'
pkgname=gram-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Gram [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Gram-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Gram-AppImage-Enhanced/releases/download/3.3.0%402026-10-22_1792689240/Gram-3.3.0-anylinux-x86_64.AppImage>gram-bin-${version}.AppImage"
checksum=a0d35200d8790a397c30c53349bd6bdb30636e0ab87df2ba44dec288ff12b2a1
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gram-bin
	vcopy "squashfs-root/*" opt/gram-bin
	chmod -R o-w "${DESTDIR}/opt/gram-bin"
	vmkdir usr/bin
	ln -sf "/opt/gram-bin/AppRun" "${DESTDIR}/usr/bin/gram"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
