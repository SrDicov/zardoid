# Template file for 'claude-code-bin'
pkgname=claude-code-bin
version=2.1.296
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of claude-code [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/claude-code-AppImage"
distfiles="https://github.com/pkgforge-dev/claude-code-AppImage/releases/download/${version}%402026-10-12_1791821877/claude-${version}-anylinux-x86_64.AppImage>claude-code-bin-${version}.AppImage"
checksum=efc626eedcbea8a4432d9051c27f19f23261fc4c694ee7eda81df2e173dd802c
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/claude-code-bin
	vcopy "squashfs-root/*" opt/claude-code-bin
	vmkdir usr/bin
	ln -sf "/opt/claude-code-bin/AppRun" "${DESTDIR}/usr/bin/claude-code"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
