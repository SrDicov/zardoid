# Template file for 'claude-code-bin'
pkgname=claude-code-bin
version=20261023
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of claude-code [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/claude-code-AppImage"
distfiles="https://github.com/pkgforge-dev/claude-code-AppImage/releases/download/2.1.309%402026-10-23_1792757849/claude-2.1.309-anylinux-x86_64.AppImage>claude-code-bin-${version}.AppImage"
checksum=8bcce89e85392408159d76810d23b1dc82b0fa7805ea2718c207e6ed72b40830
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/claude-code-bin
	vcopy "squashfs-root/*" opt/claude-code-bin
	chmod -R o-w "${DESTDIR}/opt/claude-code-bin"
	vmkdir usr/bin
	ln -sf "/opt/claude-code-bin/AppRun" "${DESTDIR}/usr/bin/claude-code"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
