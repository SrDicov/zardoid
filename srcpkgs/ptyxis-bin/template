# Template file for 'ptyxis-bin'
pkgname=ptyxis-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Ptyxis terminal [Maintainer=@domesya]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Ptyxis-AppImage"
distfiles="https://github.com/pkgforge-dev/Ptyxis-AppImage/releases/download/50.1-1%402026-10-22_1792688991/Ptyxis-50.1-1-anylinux-x86_64.AppImage>ptyxis-bin-${version}.AppImage"
checksum=8a9c8f20115d27c69db2367ab167a8ced5705f9e70542361e65d5e82d7737dc8
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ptyxis-bin
	vcopy "squashfs-root/*" opt/ptyxis-bin
	chmod -R o-w "${DESTDIR}/opt/ptyxis-bin"
	vmkdir usr/bin
	ln -sf "/opt/ptyxis-bin/AppRun" "${DESTDIR}/usr/bin/ptyxis"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
