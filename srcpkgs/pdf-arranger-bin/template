# Template file for 'pdf-arranger-bin'
pkgname=pdf-arranger-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of PDF Arranger [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/PDF-Arranger-AppImage"
distfiles="https://github.com/pkgforge-dev/PDF-Arranger-AppImage/releases/download/1.14.0-1%402026-10-01_1790865154/PDF_Arranger-1.14.0-1-anylinux-x86_64.AppImage>pdf-arranger-bin-${version}.AppImage"
checksum=231bf7f342fe727a21069dabfdd2c0d51de9120074d21f41857b26ac95aa44cc
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pdf-arranger-bin
	vcopy "squashfs-root/*" opt/pdf-arranger-bin
	vmkdir usr/bin
	ln -sf "/opt/pdf-arranger-bin/AppRun" "${DESTDIR}/usr/bin/pdf-arranger"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
