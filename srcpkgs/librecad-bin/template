# Template file for 'librecad-bin'
pkgname=librecad-bin
version=2.2.1.5
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of LibreCAD [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/LibreCAD-AppImage"
distfiles="https://github.com/pkgforge-dev/LibreCAD-AppImage/releases/download/${version}-3%402026-10-01_1790875712/LibreCAD-${version}-3-anylinux-x86_64.AppImage>librecad-bin-${version}.AppImage"
checksum=9611c76b2c38d3e76a92a4ec36ebf10e95a651a36a435013f08797b35e5abce8
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/librecad-bin
	vcopy "squashfs-root/*" opt/librecad-bin
	vmkdir usr/bin
	ln -sf "/opt/librecad-bin/AppRun" "${DESTDIR}/usr/bin/librecad"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
