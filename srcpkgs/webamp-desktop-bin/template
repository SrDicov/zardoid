# Template file for 'webamp-desktop-bin'
pkgname=webamp-desktop-bin
version=0.3.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Webamp-Desktop
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Webamp-Desktop-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Webamp-Desktop-AppImage-Enhanced/releases/download/${version}%402026-09-01_1788278041/Webamp_desktop-${version}-anylinux-x86_64.AppImage>webamp-desktop-bin-${version}.AppImage"
checksum=fc3fd687463cb32b384a845a96f9be76133d258504d3496f1fb83b01ca0872c3
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/webamp-desktop-bin
	vcopy "squashfs-root/*" opt/webamp-desktop-bin
	vmkdir usr/bin
	ln -sf "/opt/webamp-desktop-bin/AppRun" "${DESTDIR}/usr/bin/webamp-desktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
