# Template file for 'blender-bin'
pkgname=blender-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Blender [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Blender-AppImage"
distfiles="https://github.com/pkgforge-dev/Blender-AppImage/releases/download/5.2.2-3%402026-10-22_1792689207/Blender-5.2.2-3-anylinux-x86_64.AppImage>blender-bin-${version}.AppImage"
checksum=7192d0f4beb3d2261134e750fab9d6bcbeee1421a63a87baabb0541256f47cc1
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/blender-bin
	vcopy "squashfs-root/*" opt/blender-bin
	chmod -R o-w "${DESTDIR}/opt/blender-bin"
	vmkdir usr/bin
	ln -sf "/opt/blender-bin/AppRun" "${DESTDIR}/usr/bin/blender"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
