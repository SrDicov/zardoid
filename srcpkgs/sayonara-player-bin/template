# Template file for 'sayonara-player-bin'
pkgname=sayonara-player-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Sayonara Player
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Sayonara-Player-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Sayonara-Player-AppImage-Enhanced/releases/download/1.12.0-stable1%402026-10-01_1790876682/Sayonara-1.12.0-stable1-anylinux-x86_64.AppImage>sayonara-player-bin-${version}.AppImage"
checksum=95c2284be13967c7d009d315974a7068db87f4e7257267c5cd90fa5f3c2846c7
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/sayonara-player-bin
	vcopy "squashfs-root/*" opt/sayonara-player-bin
	vmkdir usr/bin
	ln -sf "/opt/sayonara-player-bin/AppRun" "${DESTDIR}/usr/bin/sayonara-player"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
