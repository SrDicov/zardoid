# Template file for 'asunder-bin'
pkgname=asunder-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Asunder [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Asunder-AppImage"
distfiles="https://github.com/pkgforge-dev/Asunder-AppImage/releases/download/3.0.2%402026-10-22_1792689052/Asunder_CD_Ripper-3.0.2-anylinux-x86_64.AppImage>asunder-bin-${version}.AppImage"
checksum=76fb56d35655a57b46db569a19c5f93ad1b35dd83bda2e35319879de9fce2592
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/asunder-bin
	vcopy "squashfs-root/*" opt/asunder-bin
	chmod -R o-w "${DESTDIR}/opt/asunder-bin"
	vmkdir usr/bin
	ln -sf "/opt/asunder-bin/AppRun" "${DESTDIR}/usr/bin/asunder"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
