# Template file for 'asunder-bin'
pkgname=asunder-bin
version=3.0.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Asunder [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Asunder-AppImage"
distfiles="https://github.com/pkgforge-dev/Asunder-AppImage/releases/download/${version}%402026-10-11_1791707965/Asunder_CD_Ripper-${version}-anylinux-x86_64.AppImage>asunder-bin-${version}.AppImage"
checksum=ce27f7716cff0b7dc092cbdf5186f89cd16da8c813b3598f8a36802f501d3e1c
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/asunder-bin
	vcopy "squashfs-root/*" opt/asunder-bin
	vmkdir usr/bin
	ln -sf "/opt/asunder-bin/AppRun" "${DESTDIR}/usr/bin/asunder"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
