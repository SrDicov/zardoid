# Template file for 'dillo-bin'
pkgname=dillo-bin
version=20261023
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Dillo [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Dillo-AppImage"
distfiles="https://github.com/pkgforge-dev/Dillo-AppImage/releases/download/3.3.0-1%402026-10-23_1792758806/Dillo-3.3.0-1-anylinux-x86_64.AppImage>dillo-bin-${version}.AppImage"
checksum=69bcabc131c2fbe35ce090c7d6df68eb66ac9e65abe756efe07937f052dd5ccf
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dillo-bin
	vcopy "squashfs-root/*" opt/dillo-bin
	chmod -R o-w "${DESTDIR}/opt/dillo-bin"
	vmkdir usr/bin
	ln -sf "/opt/dillo-bin/AppRun" "${DESTDIR}/usr/bin/dillo"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
