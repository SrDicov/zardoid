# Template file for 'dillo-bin'
pkgname=dillo-bin
version=3.3.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Dillo [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Dillo-AppImage"
distfiles="https://github.com/pkgforge-dev/Dillo-AppImage/releases/download/${version}-1%402026-10-12_1791823277/Dillo-${version}-1-anylinux-x86_64.AppImage>dillo-bin-${version}.AppImage"
checksum=501caca47398723c787190fc3533e07057dae3583f58051e0d4fb804680d967b
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dillo-bin
	vcopy "squashfs-root/*" opt/dillo-bin
	vmkdir usr/bin
	ln -sf "/opt/dillo-bin/AppRun" "${DESTDIR}/usr/bin/dillo"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
