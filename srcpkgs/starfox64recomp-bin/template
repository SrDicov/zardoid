# Template file for 'starfox64recomp-bin'
pkgname=starfox64recomp-bin
version=1.0.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Starfox 64 Recompiled"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Starfox64Recomp-AppImage"
distfiles="https://github.com/pkgforge-dev/Starfox64Recomp-AppImage/releases/download/${version}%402026-10-01_1790876529/Starfox_64_Recompiled-${version}-anylinux-x86_64.AppImage>starfox64recomp-bin-${version}.AppImage"
checksum=fa84a056aace1bb183a7ec470deb6a38901d27960d0969fc2e0cbcd654348df4
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/starfox64recomp-bin
	vcopy "squashfs-root/*" opt/starfox64recomp-bin
	vmkdir usr/bin
	ln -sf "/opt/starfox64recomp-bin/AppRun" "${DESTDIR}/usr/bin/starfox64recomp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
