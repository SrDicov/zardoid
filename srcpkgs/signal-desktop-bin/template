# Template file for 'signal-desktop-bin'
pkgname=signal-desktop-bin
version=8.28.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Signal that is able to work on any linux
 distro"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Signal-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Signal-AppImage-Enhanced/releases/download/${version}-1%402026-10-01_1790876559/Signal-${version}-1-anylinux-x86_64.AppImage>signal-desktop-bin-${version}.AppImage"
checksum=4029546bb79458732b5bcb6ddbe67c1cf305e5d747c1a234feb90fec49ba6377
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/signal-desktop-bin
	vcopy "squashfs-root/*" opt/signal-desktop-bin
	vmkdir usr/bin
	ln -sf "/opt/signal-desktop-bin/AppRun" "${DESTDIR}/usr/bin/signal-desktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
