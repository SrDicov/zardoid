# Template file for 'signal-desktop-bin'
pkgname=signal-desktop-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Signal that is able to work on any linux
 distro"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Signal-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Signal-AppImage-Enhanced/releases/download/8.32.0-1%402026-10-22_1792689186/Signal-8.32.0-1-anylinux-x86_64.AppImage>signal-desktop-bin-${version}.AppImage"
checksum=696a5eb0118c29da29fe96c3d515af64c72f6ac711dfd71797d7b22ce13271d8
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/signal-desktop-bin
	vcopy "squashfs-root/*" opt/signal-desktop-bin
	chmod -R o-w "${DESTDIR}/opt/signal-desktop-bin"
	vmkdir usr/bin
	ln -sf "/opt/signal-desktop-bin/AppRun" "${DESTDIR}/usr/bin/signal-desktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
