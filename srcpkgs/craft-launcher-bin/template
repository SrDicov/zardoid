# Template file for 'craft-launcher-bin'
pkgname=craft-launcher-bin
version=0.5.1
revision=1
archs="x86_64"
short_desc="Craft App Launcher"
maintainer="SrDicov <SrDicov@gmail.com>"
license="Apache-2.0"
homepage="https://github.com/storytold/craft-launcher"
distfiles="https://github.com/storytold/craft-launcher/releases/download/v${version}/artcraft-launcher-${version}-linux-x86_64.AppImage>craft-launcher-bin-${version}.AppImage"
checksum=d4298972955d1ed6c5fd7759fdd2e4dc4bc521b3d040cf7b4891b78707831f73
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/craft-launcher-bin
	vcopy "squashfs-root/*" opt/craft-launcher-bin
	vmkdir usr/bin
	ln -sf "/opt/craft-launcher-bin/AppRun" "${DESTDIR}/usr/bin/craft-launcher"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
