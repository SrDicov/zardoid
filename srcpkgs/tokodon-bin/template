# Template file for 'tokodon-bin'
pkgname=tokodon-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Tokodon [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Tokodon-AppImage"
distfiles="https://github.com/pkgforge-dev/Tokodon-AppImage/releases/download/26.08.1-1%402026-10-01_1790876252/Tokodon-26.08.1-1-anylinux-x86_64.AppImage>tokodon-bin-${version}.AppImage"
checksum=4c6c11f77a8f4aaacd50c7e0d02c7aca9b6547328900ffccda4338e0b1baa24b
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/tokodon-bin
	vcopy "squashfs-root/*" opt/tokodon-bin
	vmkdir usr/bin
	ln -sf "/opt/tokodon-bin/AppRun" "${DESTDIR}/usr/bin/tokodon"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
