# Template file for 'mgba-bin'
pkgname=mgba-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of mGBA [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/mGBA-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/mGBA-AppImage-Enhanced/releases/download/0.10.5-5%402026-10-22_1792689427/mGBA-0.10.5-5-anylinux-x86_64.AppImage>mgba-bin-${version}.AppImage"
checksum=dc5d6018b90efdc6b02354150cfa4feb24d30963b08c8a2ff19c54374a467f24
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/mgba-bin
	vcopy "squashfs-root/*" opt/mgba-bin
	chmod -R o-w "${DESTDIR}/opt/mgba-bin"
	vmkdir usr/bin
	ln -sf "/opt/mgba-bin/AppRun" "${DESTDIR}/usr/bin/mgba"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
