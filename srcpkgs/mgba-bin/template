# Template file for 'mgba-bin'
pkgname=mgba-bin
version=0.10.5
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of mGBA [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/mGBA-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/mGBA-AppImage-Enhanced/releases/download/${version}-5%402026-10-01_1790876690/mGBA-${version}-5-anylinux-x86_64.AppImage>mgba-bin-${version}.AppImage"
checksum=53e38cc9b21dffc14b4f50c3754a8bb2cb442dd6db4eb1494ce81348c8d288ac
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/mgba-bin
	vcopy "squashfs-root/*" opt/mgba-bin
	vmkdir usr/bin
	ln -sf "/opt/mgba-bin/AppRun" "${DESTDIR}/usr/bin/mgba"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
