# Template file for 'cursor-cli-bin'
pkgname=cursor-cli-bin
version=20260722
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of cursor-cli [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/cursor-cli-AppImage"
distfiles="https://github.com/pkgforge-dev/cursor-cli-AppImage/releases/download/2026.05.24.1.dda726e-1%402026-07-22_1784721360/cursor-agent-2026.05.24.1.dda726e-1-anylinux-x86_64.AppImage>cursor-cli-bin-${version}.AppImage"
checksum=73a9feea76197c5023e35ae4147346268159464cf4bb09edc5d6730a006d455d
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cursor-cli-bin
	vcopy "squashfs-root/*" opt/cursor-cli-bin
	vmkdir usr/bin
	ln -sf "/opt/cursor-cli-bin/AppRun" "${DESTDIR}/usr/bin/cursor-cli"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
