# Template file for 'clapper-bin'
pkgname=clapper-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Clapper video player"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/Clapper-AppImage"
distfiles="https://github.com/pkgforge-dev/Clapper-AppImage/releases/download/0.10.0%402026-10-01_1790876419/Clapper-0.10.0-anylinux-x86_64.AppImage>clapper-bin-${version}.AppImage"
checksum=612dc20583be039d2aff2f20a2a7fa811ea43225d2c569d825937ee96331ee80
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/clapper-bin
	vcopy "squashfs-root/*" opt/clapper-bin
	vmkdir usr/bin
	ln -sf "/opt/clapper-bin/AppRun" "${DESTDIR}/usr/bin/clapper"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
