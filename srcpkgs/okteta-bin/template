# Template file for 'okteta-bin'
pkgname=okteta-bin
version=0.26.28
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Okteta [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Okteta-AppImage"
distfiles="https://github.com/pkgforge-dev/Okteta-AppImage/releases/download/${version}-1%402026-10-01_1790876648/Okteta-${version}-1-anylinux-x86_64.AppImage>okteta-bin-${version}.AppImage"
checksum=1e03e6ff7526cbded5d3081f92ebca3ae8003aa3c7addb57d67f3e3adcb62a26
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/okteta-bin
	vcopy "squashfs-root/*" opt/okteta-bin
	vmkdir usr/bin
	ln -sf "/opt/okteta-bin/AppRun" "${DESTDIR}/usr/bin/okteta"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
