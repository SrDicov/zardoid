# Template file for 'unityhub-bin'
pkgname=unityhub-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage for Unity Hub [Maintainer=@crueter]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/UnityHub-AppImage"
distfiles="https://github.com/pkgforge-dev/UnityHub-AppImage/releases/download/3.21.0-1%402026-10-22_1792689242/Unity_Hub-3.21.0-1-anylinux-x86_64.AppImage>unityhub-bin-${version}.AppImage"
checksum=095f249adf3ac7786618becd9fb8e57b95ff9c5cca69a5bc1e933fa7fd72e6e8
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/unityhub-bin
	vcopy "squashfs-root/*" opt/unityhub-bin
	chmod -R o-w "${DESTDIR}/opt/unityhub-bin"
	vmkdir usr/bin
	ln -sf "/opt/unityhub-bin/AppRun" "${DESTDIR}/usr/bin/unityhub"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
