# Template file for 'zelda64recomp-bin'
pkgname=zelda64recomp-bin
version=1.2.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Zelda 64 Recompiled"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Zelda64Recomp-AppImage"
distfiles="https://github.com/pkgforge-dev/Zelda64Recomp-AppImage/releases/download/${version}%402026-10-01_1790876005/Zelda64Recompiled-${version}-anylinux-x86_64.AppImage>zelda64recomp-bin-${version}.AppImage"
checksum=49c51a8aad79965f84607881da7224671c5fce8b05093bafe1e38c351b821901
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/zelda64recomp-bin
	vcopy "squashfs-root/*" opt/zelda64recomp-bin
	vmkdir usr/bin
	ln -sf "/opt/zelda64recomp-bin/AppRun" "${DESTDIR}/usr/bin/zelda64recomp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
