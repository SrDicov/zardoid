# Template file for 'sacdextractgui-bin'
pkgname=sacdextractgui-bin
version=0.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of SACDExtractGUI
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SACDExtractGUI-AppImage"
distfiles="https://github.com/pkgforge-dev/SACDExtractGUI-AppImage/releases/download/${version}%402026-09-10_1789017294/SACDExtractGUI-${version}-anylinux-x86_64.AppImage>sacdextractgui-bin-${version}.AppImage"
checksum=eb8851d3f5d41ed9e5cb4ddd319034924d8fdf94a12fa04a327dd33f844dbc1d
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/sacdextractgui-bin
	vcopy "squashfs-root/*" opt/sacdextractgui-bin
	vmkdir usr/bin
	ln -sf "/opt/sacdextractgui-bin/AppRun" "${DESTDIR}/usr/bin/sacdextractgui"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
