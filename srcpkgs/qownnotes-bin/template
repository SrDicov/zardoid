# Template file for 'qownnotes-bin'
pkgname=qownnotes-bin
version=26.10.7.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of QOwnNotes [Maintainer=@QaidVoid]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/QOwnNotes-AppImage"
distfiles="https://github.com/pkgforge-dev/QOwnNotes-AppImage/releases/download/26.10.7-1/QOwnNotes-26.10.7-1-anylinux-x86_64.AppImage>qownnotes-bin-${version}.AppImage"
checksum=4fe2ad27eb2a462d88f5d9dd5036b49701ad70a8b7b40614a5f6b75003388e89
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/qownnotes-bin
	vcopy "squashfs-root/*" opt/qownnotes-bin
	chmod -R o-w "${DESTDIR}/opt/qownnotes-bin"
	vmkdir usr/bin
	ln -sf "/opt/qownnotes-bin/AppRun" "${DESTDIR}/usr/bin/qownnotes"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
