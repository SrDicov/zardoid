# Template file for 'myth-ii-bin'
pkgname=myth-ii-bin
version=1.8.5
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Myth II/Project Magma"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Myth-II-AppImage"
distfiles="https://github.com/pkgforge-dev/Myth-II-AppImage/releases/download/${version}%402026-10-07_1791382641/Myth_II-${version}-anylinux-x86_64.AppImage>myth-ii-bin-${version}.AppImage"
checksum=629b3e2a42cbc490ef9efa6198a61067abf6aacfe0304e712bf06cb51d03a941
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/myth-ii-bin
	vcopy "squashfs-root/*" opt/myth-ii-bin
	vmkdir usr/bin
	ln -sf "/opt/myth-ii-bin/AppRun" "${DESTDIR}/usr/bin/myth-ii"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
