# Template file for 'pattypan-bin'
pkgname=pattypan-bin
version=26.02
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Pattypan [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Pattypan-AppImage"
distfiles="https://github.com/pkgforge-dev/Pattypan-AppImage/releases/download/v${version}%402026-05-15_1778856962/Pattypan-v${version}-anylinux-x86_64.AppImage>pattypan-bin-${version}.AppImage"
checksum=7927739624ceeeeb08b9da8690d998f84b6decae66a28912ca5ea98c6d1eb188
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pattypan-bin
	vcopy "squashfs-root/*" opt/pattypan-bin
	vmkdir usr/bin
	ln -sf "/opt/pattypan-bin/AppRun" "${DESTDIR}/usr/bin/pattypan"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
