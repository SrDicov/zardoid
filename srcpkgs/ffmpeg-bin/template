# Template file for 'ffmpeg-bin'
pkgname=ffmpeg-bin
version=9.0.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ffmpeg [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ffmpeg-AppImage"
distfiles="https://github.com/pkgforge-dev/ffmpeg-AppImage/releases/download/${version}-1%402026-10-01_1790876674/ffmpeg-${version}-1-anylinux-x86_64.AppImage>ffmpeg-bin-${version}.AppImage"
checksum=77cfcf0de84805e1b9310184adf13dea0c047e1ac737788205547d61b48acd3a
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ffmpeg-bin
	vcopy "squashfs-root/*" opt/ffmpeg-bin
	vmkdir usr/bin
	ln -sf "/opt/ffmpeg-bin/AppRun" "${DESTDIR}/usr/bin/ffmpeg"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
