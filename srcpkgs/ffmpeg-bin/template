# Template file for 'ffmpeg-bin'
pkgname=ffmpeg-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ffmpeg [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ffmpeg-AppImage"
distfiles="https://github.com/pkgforge-dev/ffmpeg-AppImage/releases/download/9.0.2-2%402026-10-22_1792689487/ffmpeg-9.0.2-2-anylinux-x86_64.AppImage>ffmpeg-bin-${version}.AppImage"
checksum=07e22511138ea83ba0d569726d2a53b50dbc2fdf2613e6d8d15463a73e138fc9
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ffmpeg-bin
	vcopy "squashfs-root/*" opt/ffmpeg-bin
	chmod -R o-w "${DESTDIR}/opt/ffmpeg-bin"
	vmkdir usr/bin
	ln -sf "/opt/ffmpeg-bin/AppRun" "${DESTDIR}/usr/bin/ffmpeg"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
