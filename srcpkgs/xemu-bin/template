# Template file for 'xemu-bin'
pkgname=xemu-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of xemu [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/xemu-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/xemu-AppImage-Enhanced/releases/download/0.8.139%402026-10-22_1792688280/xemu-0.8.139-anylinux-x86_64.AppImage>xemu-bin-${version}.AppImage"
checksum=26620644f013d37c728e970276a0dd2f1b06a2f79eb96226d87cbfa7e0a98745
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/xemu-bin
	vcopy "squashfs-root/*" opt/xemu-bin
	chmod -R o-w "${DESTDIR}/opt/xemu-bin"
	vmkdir usr/bin
	ln -sf "/opt/xemu-bin/AppRun" "${DESTDIR}/usr/bin/xemu"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
