# Template file for 'arx-libertatis-bin'
pkgname=arx-libertatis-bin
version=20261021
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Arx Libertatis
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Arx-Libertatis-AppImage"
distfiles="https://github.com/pkgforge-dev/Arx-Libertatis-AppImage/releases/download/5b95e4c5c%402026-10-21_1792563343/Arx_Libertatis-5b95e4c5c-anylinux-x86_64.AppImage>arx-libertatis-bin-${version}.AppImage"
checksum=78bf85ed0bff6e033b324bfad0c91486ce62b7902f3c76c1c005be6b8520db40
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/arx-libertatis-bin
	vcopy "squashfs-root/*" opt/arx-libertatis-bin
	chmod -R o-w "${DESTDIR}/opt/arx-libertatis-bin"
	vmkdir usr/bin
	ln -sf "/opt/arx-libertatis-bin/AppRun" "${DESTDIR}/usr/bin/arx-libertatis"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
