# Template file for 'irpf2025-bin'
pkgname=irpf2025-bin
version=20260605
revision=1
archs="x86_64"
short_desc="Appimage não oficial do IRPF2025 [Mantenedor=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/IRPF2025-AppImage"
distfiles="https://github.com/pkgforge-dev/IRPF2025-AppImage/releases/download/1.8%402026-06-05_1780694138/IRPF_2025-1.8-anylinux-x86_64.AppImage>irpf2025-bin-${version}.AppImage"
checksum=4c9290a065bda7b31b33173e24539062b28ce60eb2a2309d4a50e2711c46ab2e
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/irpf2025-bin
	vcopy "squashfs-root/*" opt/irpf2025-bin
	chmod -R o-w "${DESTDIR}/opt/irpf2025-bin"
	vmkdir usr/bin
	ln -sf "/opt/irpf2025-bin/AppRun" "${DESTDIR}/usr/bin/irpf2025"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
