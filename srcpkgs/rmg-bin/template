# Template file for 'rmg-bin'
pkgname=rmg-bin
version=0.9.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of RMG, wtih x86-64-v3 optimizations and
 smaller"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/RMG-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/RMG-AppImage-Enhanced/releases/download/${version}-1%402026-10-01_1790876458/RMG-${version}-1-anylinux-x86_64.AppImage>rmg-bin-${version}.AppImage"
checksum=2e947a52a174be86a94db02d06137e60d39ac4805fd5ff41b42dea5d6ebb080e
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rmg-bin
	vcopy "squashfs-root/*" opt/rmg-bin
	vmkdir usr/bin
	ln -sf "/opt/rmg-bin/AppRun" "${DESTDIR}/usr/bin/rmg"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
