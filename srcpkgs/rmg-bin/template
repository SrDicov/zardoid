# Template file for 'rmg-bin'
pkgname=rmg-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of RMG, wtih x86-64-v3 optimizations and
 smaller"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/RMG-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/RMG-AppImage-Enhanced/releases/download/0.9.0-1%402026-10-22_1792689361/RMG-0.9.0-1-anylinux-x86_64.AppImage>rmg-bin-${version}.AppImage"
checksum=cc98b7c75fea70bc7ab2d42e12007aded099328772911dfa0eed5cd9eabd0c9d
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rmg-bin
	vcopy "squashfs-root/*" opt/rmg-bin
	chmod -R o-w "${DESTDIR}/opt/rmg-bin"
	vmkdir usr/bin
	ln -sf "/opt/rmg-bin/AppRun" "${DESTDIR}/usr/bin/rmg"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
