# Template file for 'rnote-bin'
pkgname=rnote-bin
version=0.14.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Rnote drawing application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/Rnote-AppImage"
distfiles="https://github.com/pkgforge-dev/Rnote-AppImage/releases/download/${version}-2%402026-10-01_1790876568/Rnote-${version}-2-anylinux-x86_64.AppImage>rnote-bin-${version}.AppImage"
checksum=19a46f4b5d20e583771fdf5f4d02a0db8de3412c9c3e67c932fdeddbd9247603
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rnote-bin
	vcopy "squashfs-root/*" opt/rnote-bin
	vmkdir usr/bin
	ln -sf "/opt/rnote-bin/AppRun" "${DESTDIR}/usr/bin/rnote"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
