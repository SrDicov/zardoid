# Template file for 'prism-launcher-bin'
pkgname=prism-launcher-bin
version=11.1.1
revision=1
archs="x86_64"
short_desc="Custom launcher for Minecraft that allows you to easily manage"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://prismlauncher.org"
distfiles="https://github.com/PrismLauncher/PrismLauncher/releases/download/${version}/PrismLauncher-Linux-x86_64.AppImage>prism-launcher-bin-${version}.AppImage"
checksum=bb81038c56a09e944659e4b808dbfbc52d52d5e3a3ffe32216689a3ca1508d3d
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/prism-launcher-bin
	vcopy "squashfs-root/*" opt/prism-launcher-bin
	chmod -R o-w "${DESTDIR}/opt/prism-launcher-bin"
	vmkdir usr/bin
	ln -sf "/opt/prism-launcher-bin/AppRun" "${DESTDIR}/usr/bin/prism-launcher"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
