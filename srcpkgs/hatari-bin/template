# Template file for 'hatari-bin'
pkgname=hatari-bin
version=2.6.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Hatari [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Hatari-AppImage"
distfiles="https://github.com/pkgforge-dev/Hatari-AppImage/releases/download/${version}-1%402026-10-01_1790864630/Hatari-${version}-1-anylinux-x86_64.AppImage>hatari-bin-${version}.AppImage"
checksum=a12595f749ef061adef6e7458f0f30e1812a353254465c374ff874870b2fb9a6
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/hatari-bin
	vcopy "squashfs-root/*" opt/hatari-bin
	vmkdir usr/bin
	ln -sf "/opt/hatari-bin/AppRun" "${DESTDIR}/usr/bin/hatari"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
