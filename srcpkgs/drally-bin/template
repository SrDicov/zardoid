# Template file for 'drally-bin'
pkgname=drally-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of dRally [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/dRally-AppImage"
distfiles="https://github.com/pkgforge-dev/dRally-AppImage/releases/download/920d85a7f%402026-09-01_1788264642/dRally-920d85a7f-anylinux-x86_64.AppImage>drally-bin-${version}.AppImage"
checksum=529be8b6b874a34016b29c2b7cd37824d4049af598dea8a6b0be0c7893be292a
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/drally-bin
	vcopy "squashfs-root/*" opt/drally-bin
	vmkdir usr/bin
	ln -sf "/opt/drally-bin/AppRun" "${DESTDIR}/usr/bin/drally"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
