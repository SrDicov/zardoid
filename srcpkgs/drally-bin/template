# Template file for 'drally-bin'
pkgname=drally-bin
version=20261024
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of dRally [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/dRally-AppImage"
distfiles="https://github.com/pkgforge-dev/dRally-AppImage/releases/download/920d85a7f%402026-10-24_1792823741/dRally-920d85a7f-anylinux-x86_64.AppImage>drally-bin-${version}.AppImage"
checksum=fbf9b6450a172384605302bae281ef0eeb318365d67b510758acf8ba2066a7b2
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/drally-bin
	vcopy "squashfs-root/*" opt/drally-bin
	chmod -R o-w "${DESTDIR}/opt/drally-bin"
	vmkdir usr/bin
	ln -sf "/opt/drally-bin/AppRun" "${DESTDIR}/usr/bin/drally"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
