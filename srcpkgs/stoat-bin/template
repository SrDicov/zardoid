# Template file for 'stoat-bin'
pkgname=stoat-bin
version=1.5.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Stoat Desktop client
 [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Stoat-AppImage"
distfiles="https://github.com/pkgforge-dev/Stoat-AppImage/releases/download/v${version}%402026-08-18_1787013175/Stoat-v${version}-anylinux-x86_64.AppImage>stoat-bin-${version}.AppImage"
checksum=3e870694ee1949e444f7c2f8aca9820312052ef49a4a5b6576f926de77de9445
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/stoat-bin
	vcopy "squashfs-root/*" opt/stoat-bin
	vmkdir usr/bin
	ln -sf "/opt/stoat-bin/AppRun" "${DESTDIR}/usr/bin/stoat"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
