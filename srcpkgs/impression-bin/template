# Template file for 'impression-bin'
pkgname=impression-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Impression USB image writer application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Impression-AppImage"
distfiles="https://github.com/pkgforge-dev/Impression-AppImage/releases/download/3.8.0-1%402026-10-22_1792689451/Impression-3.8.0-1-anylinux-x86_64.AppImage>impression-bin-${version}.AppImage"
checksum=de1ef32e242fa60a647605fe9ad7e4ea2cd33c4b3831c41e4d75cdba14658c2e
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/impression-bin
	vcopy "squashfs-root/*" opt/impression-bin
	chmod -R o-w "${DESTDIR}/opt/impression-bin"
	vmkdir usr/bin
	ln -sf "/opt/impression-bin/AppRun" "${DESTDIR}/usr/bin/impression"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
