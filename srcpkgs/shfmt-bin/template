nopie=yes
noshlibprovides=yes
nostrip=yes
skip_extraction="shfmt_v3.14.1_linux_amd64"

post_extract() {
	local f='shfmt_v'${version}'_linux_amd64'
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	vbin 'shfmt_v'${version}'_linux_amd64' 'shfmt'
	vlicense "${FILESDIR}/LICENSE"
}
