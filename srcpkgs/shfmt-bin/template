# Template file for 'shfmt-bin'
pkgname=shfmt-bin
version=3.14.1
revision=1
archs="x86_64*"
short_desc="Shell parser, formatter, and interpreter with bash and zsh support;"
maintainer="SrDicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://pkg.go.dev/mvdan.cc/sh/v3"
distfiles="https://github.com/mvdan/sh/releases/download/v${version}/shfmt_v${version}_linux_amd64"
