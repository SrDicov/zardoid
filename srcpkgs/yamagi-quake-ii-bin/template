# Template file for 'yamagi-quake-ii-bin'
pkgname=yamagi-quake-ii-bin
version=8.70
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Yamagi Quake II
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Yamagi-Quake-II-AppImage"
distfiles="https://github.com/pkgforge-dev/Yamagi-Quake-II-AppImage/releases/download/${version}%402026-10-01_1790875846/Yamagi_Quake_II-${version}-anylinux-x86_64.AppImage>yamagi-quake-ii-bin-${version}.AppImage"
checksum=073f376a5e95d26ab2571f2882fac63d13cc7dc5c6654a650a2ae0e4bd2d0faa
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/yamagi-quake-ii-bin
	vcopy "squashfs-root/*" opt/yamagi-quake-ii-bin
	vmkdir usr/bin
	ln -sf "/opt/yamagi-quake-ii-bin/AppRun" "${DESTDIR}/usr/bin/yamagi-quake-ii"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
