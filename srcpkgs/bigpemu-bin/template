# Template file for 'bigpemu-bin'
pkgname=bigpemu-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of BigPEmu [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/BigPEmu-AppImage"
distfiles="https://github.com/pkgforge-dev/BigPEmu-AppImage/releases/download/1.221%402026-09-01_1788278314/BigPEmu-1.221-anylinux-x86_64.AppImage>bigpemu-bin-${version}.AppImage"
checksum=3b4930d402de707b71563a26e20f901e84a49cb03b87d338a8ad79e507aa123b
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/bigpemu-bin
	vcopy "squashfs-root/*" opt/bigpemu-bin
	chmod -R o-w "${DESTDIR}/opt/bigpemu-bin"
	vmkdir usr/bin
	ln -sf "/opt/bigpemu-bin/AppRun" "${DESTDIR}/usr/bin/bigpemu"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
