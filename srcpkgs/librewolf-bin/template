# Template file for 'librewolf-bin'
pkgname=librewolf-bin
version=158.0
revision=1
archs="x86_64"
short_desc="Precompiled binaries for librewolf"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MPL-2.0"
homepage="https://dl.librewolf.net/librewolf/158.0-1/librewolf-158.0-1-linux-x86_64-appimage.AppImage"
distfiles="https://dl.librewolf.net/librewolf/${version}-1/librewolf-${version}-1-linux-x86_64-appimage.AppImage>librewolf-bin-${version}.AppImage"
checksum=6426e30fd7c66e7855dc17626e7d2dcc1d99e8bf7568d4ad25e3955981510843
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/librewolf-bin
	vcopy "squashfs-root/*" opt/librewolf-bin
	chmod -R o-w "${DESTDIR}/opt/librewolf-bin"
	vmkdir usr/bin
	ln -sf "/opt/librewolf-bin/AppRun" "${DESTDIR}/usr/bin/librewolf"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
