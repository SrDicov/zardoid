# Template file for 'video-trimmer-bin'
pkgname=video-trimmer-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Video Trimmer application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Video-Trimmer-AppImage"
distfiles="https://github.com/pkgforge-dev/Video-Trimmer-AppImage/releases/download/26.03.1-1%402026-10-22_1792689454/Video_Trimmer-26.03.1-1-anylinux-x86_64.AppImage>video-trimmer-bin-${version}.AppImage"
checksum=f66f8eceaa5741079cf359358cc44848342258e95006fa8d265496e4b5e5e686
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/video-trimmer-bin
	vcopy "squashfs-root/*" opt/video-trimmer-bin
	chmod -R o-w "${DESTDIR}/opt/video-trimmer-bin"
	vmkdir usr/bin
	ln -sf "/opt/video-trimmer-bin/AppRun" "${DESTDIR}/usr/bin/video-trimmer"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
