# Template file for 'openswe1r-bin'
pkgname=openswe1r-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenSWE1R [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenSWE1R-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenSWE1R-AppImage/releases/download/1fcb4a8e8%402026-09-01_1788277669/OpenSWE1R-1fcb4a8e8-anylinux-x86_64.AppImage>openswe1r-bin-${version}.AppImage"
checksum=a4f064d7be38aebd938bcc7f409c83dfc31e2682ba2d49c395704f597f98c928
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openswe1r-bin
	vcopy "squashfs-root/*" opt/openswe1r-bin
	vmkdir usr/bin
	ln -sf "/opt/openswe1r-bin/AppRun" "${DESTDIR}/usr/bin/openswe1r"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
