# Template file for 'cannonball-bin'
pkgname=cannonball-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Cannonball [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Cannonball-AppImage"
distfiles="https://github.com/pkgforge-dev/Cannonball-AppImage/releases/download/27493ebf6%402026-10-01_1790876479/CannonBall-27493ebf6-anylinux-x86_64.AppImage>cannonball-bin-${version}.AppImage"
checksum=1b6a9e9457145ed4d223d9d67babdc1467d7145cbb4b392bbbf3dc3e67bc8d65
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cannonball-bin
	vcopy "squashfs-root/*" opt/cannonball-bin
	vmkdir usr/bin
	ln -sf "/opt/cannonball-bin/AppRun" "${DESTDIR}/usr/bin/cannonball"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
