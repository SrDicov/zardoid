# Template file for 'servo-bin'
pkgname=servo-bin
version=0.6.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage builds of the servo browser engine"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MPL-2.0"
homepage="https://github.com/pkgforge-dev/servo-AppImage"
distfiles="https://github.com/pkgforge-dev/servo-AppImage/releases/download/v${version}%402026-10-01_1790876557/Servo-v${version}-anylinux-x86_64.AppImage>servo-bin-${version}.AppImage"
checksum=42152f051576baa62d064beb8f151a4313121d4769fded8e6de12384f2276492
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/servo-bin
	vcopy "squashfs-root/*" opt/servo-bin
	vmkdir usr/bin
	ln -sf "/opt/servo-bin/AppRun" "${DESTDIR}/usr/bin/servo"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
