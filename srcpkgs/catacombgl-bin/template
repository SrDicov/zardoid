# Template file for 'catacombgl-bin'
pkgname=catacombgl-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of CatacombGL [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/CatacombGL-AppImage"
distfiles="https://github.com/pkgforge-dev/CatacombGL-AppImage/releases/download/0.5.7-beta%402026-10-22_1792689898/CatacombGL-0.5.7-beta-anylinux-x86_64.AppImage>catacombgl-bin-${version}.AppImage"
checksum=008b7b1fe3292bb474a0e084d2d97f529c1d6ab5209b5f5fb8d2df606baf2935
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/catacombgl-bin
	vcopy "squashfs-root/*" opt/catacombgl-bin
	chmod -R o-w "${DESTDIR}/opt/catacombgl-bin"
	vmkdir usr/bin
	ln -sf "/opt/catacombgl-bin/AppRun" "${DESTDIR}/usr/bin/catacombgl"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
