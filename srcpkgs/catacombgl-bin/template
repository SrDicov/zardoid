# Template file for 'catacombgl-bin'
pkgname=catacombgl-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of CatacombGL [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/CatacombGL-AppImage"
distfiles="https://github.com/pkgforge-dev/CatacombGL-AppImage/releases/download/0.5.7-beta%402026-10-01_1790876669/CatacombGL-0.5.7-beta-anylinux-x86_64.AppImage>catacombgl-bin-${version}.AppImage"
checksum=b706f43dbfdec4b1ec58f3bf0835761d5a7d01d24883d9b55e86cfb503f73c89
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/catacombgl-bin
	vcopy "squashfs-root/*" opt/catacombgl-bin
	vmkdir usr/bin
	ln -sf "/opt/catacombgl-bin/AppRun" "${DESTDIR}/usr/bin/catacombgl"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
