# Template file for 'webcamoid-bin'
pkgname=webcamoid-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Webcamoid [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Webcamoid-AppImage"
distfiles="https://github.com/pkgforge-dev/Webcamoid-AppImage/releases/download/9.4.0-2%402026-10-22_1792689354/Webcamoid-9.4.0-2-anylinux-x86_64.AppImage>webcamoid-bin-${version}.AppImage"
checksum=d60697a3d99cf3328e348783b3e7ec8bb657821cb7e657a3317a547f0014443a
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/webcamoid-bin
	vcopy "squashfs-root/*" opt/webcamoid-bin
	chmod -R o-w "${DESTDIR}/opt/webcamoid-bin"
	vmkdir usr/bin
	ln -sf "/opt/webcamoid-bin/AppRun" "${DESTDIR}/usr/bin/webcamoid"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
