# Template file for 'xiphos-bin'
pkgname=xiphos-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Xiphos [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Xiphos-AppImage"
distfiles="https://github.com/pkgforge-dev/Xiphos-AppImage/releases/download/4.5.0-1%402026-10-01_1790876564/Xiphos_Bible_Guide-4.5.0-1-anylinux-x86_64.AppImage>xiphos-bin-${version}.AppImage"
checksum=03276b029e3cdafccd36c84aede1fbfd352905aa93512e248ee5f602f195b07c
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/xiphos-bin
	vcopy "squashfs-root/*" opt/xiphos-bin
	vmkdir usr/bin
	ln -sf "/opt/xiphos-bin/AppRun" "${DESTDIR}/usr/bin/xiphos"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
