# Template file for 'raptor-bin'
pkgname=raptor-bin
version=20260922
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Raptor [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Raptor-AppImage"
distfiles="https://github.com/pkgforge-dev/Raptor-AppImage/releases/download/0019c5dd8%402026-09-22_1790090461/Raptor-0019c5dd8-anylinux-x86_64.AppImage>raptor-bin-${version}.AppImage"
checksum=e2b53eab83e92605534e995ac570ef1c7cb084c41ddf46d16374045447fd67fd
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/raptor-bin
	vcopy "squashfs-root/*" opt/raptor-bin
	vmkdir usr/bin
	ln -sf "/opt/raptor-bin/AppRun" "${DESTDIR}/usr/bin/raptor"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
