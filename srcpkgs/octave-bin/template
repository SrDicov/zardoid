# Template file for 'octave-bin'
pkgname=octave-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of GNU Octave [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/GNU-Octave-AppImage"
distfiles="https://github.com/pkgforge-dev/GNU-Octave-AppImage/releases/download/11.3.0-1%402026-10-01_1790875878/GNU_Octave-11.3.0-1-anylinux-x86_64.AppImage>octave-bin-${version}.AppImage"
checksum=dc0f79434a805bd5fcd9eca0abbf1e7dd3e9ac335cb3d9eaf0f79e25c83bb924
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/octave-bin
	vcopy "squashfs-root/*" opt/octave-bin
	vmkdir usr/bin
	ln -sf "/opt/octave-bin/AppRun" "${DESTDIR}/usr/bin/octave"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
