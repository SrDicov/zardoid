# Template file for 'spek-bin'
pkgname=spek-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Spek [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Spek-AppImage"
distfiles="https://github.com/pkgforge-dev/Spek-AppImage/releases/download/0.8.5-4%402026-10-22_1792688856/Spek-0.8.5-4-anylinux-x86_64.AppImage>spek-bin-${version}.AppImage"
checksum=38f21eb0fd0251ce1f84f8bfcd835cc916081f55a704006e44cd65ea5bd342a2
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/spek-bin
	vcopy "squashfs-root/*" opt/spek-bin
	chmod -R o-w "${DESTDIR}/opt/spek-bin"
	vmkdir usr/bin
	ln -sf "/opt/spek-bin/AppRun" "${DESTDIR}/usr/bin/spek"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
