# Template file for 'azahar-bin'
pkgname=azahar-bin
version=2126.1.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Azahar, with optimized builds for modern
 cpus"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Azahar-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Azahar-AppImage-Enhanced/releases/download/${version}%402026-10-01_1790876552/Azahar-${version}-anylinux-x86_64.AppImage>azahar-bin-${version}.AppImage"
checksum=619e58b942e3ec9e0c618d70d062fa28d7f3c08cae621352e8eeaa65dc23f677
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/azahar-bin
	vcopy "squashfs-root/*" opt/azahar-bin
	vmkdir usr/bin
	ln -sf "/opt/azahar-bin/AppRun" "${DESTDIR}/usr/bin/azahar"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
