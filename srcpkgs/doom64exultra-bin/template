# Template file for 'doom64exultra-bin'
pkgname=doom64exultra-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of DOOM64EXUltra [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/DOOM64EXUltra-AppImage"
distfiles="https://github.com/pkgforge-dev/DOOM64EXUltra-AppImage/releases/download/ac890ce59%402026-09-01_1788278266/DOOM64EXUltra-ac890ce59-anylinux-x86_64.AppImage>doom64exultra-bin-${version}.AppImage"
checksum=e4509b1b248f3b08d15e32a01a8c96580f4088cde2f486f8bc299dda9158f657
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/doom64exultra-bin
	vcopy "squashfs-root/*" opt/doom64exultra-bin
	vmkdir usr/bin
	ln -sf "/opt/doom64exultra-bin/AppRun" "${DESTDIR}/usr/bin/doom64exultra"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
