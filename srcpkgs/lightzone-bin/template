# Template file for 'lightzone-bin'
pkgname=lightzone-bin
version=20260522
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of LighZone [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/LightZone-AppImage"
distfiles="https://github.com/pkgforge-dev/LightZone-AppImage/releases/download/5.0.0beta3-1%402026-05-22_1779457497/LightZone-5.0.0beta3-1-anylinux-x86_64.AppImage>lightzone-bin-${version}.AppImage"
checksum=a46cf0e5e2108ec936dae3eef3d1b20eb228c7ff1f272df410b2673567e340a2
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/lightzone-bin
	vcopy "squashfs-root/*" opt/lightzone-bin
	vmkdir usr/bin
	ln -sf "/opt/lightzone-bin/AppRun" "${DESTDIR}/usr/bin/lightzone"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
