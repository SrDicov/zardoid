# Template file for 'themix-gui-bin'
pkgname=themix-gui-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Themix-GUI [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Themix-GUI-AppImage"
distfiles="https://github.com/pkgforge-dev/Themix-GUI-AppImage/releases/download/1.15.1.r318.gc84791b3-1%402026-10-01_1790876627/Themix-1.15.1.r318.gc84791b3-1-anylinux-x86_64.AppImage>themix-gui-bin-${version}.AppImage"
checksum=97f2da2b685fca4b9b0ab465c864afba490363bfe78a4367cac59f55f7c87351
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/themix-gui-bin
	vcopy "squashfs-root/*" opt/themix-gui-bin
	vmkdir usr/bin
	ln -sf "/opt/themix-gui-bin/AppRun" "${DESTDIR}/usr/bin/themix-gui"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
