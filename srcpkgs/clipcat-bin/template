license="GPL-3.0-or-later"
homepage="https://github.com/xrelkd/clipcat"
distfiles="https://github.com/xrelkd/clipcat/releases/download/v${version}/clipcat-${version}-x86_64-unknown-linux-musl.tar.gz"
