do_install() {
	vbin 'bin/clipcat-menu'
	vbin 'bin/clipcat-notify'
	vbin 'bin/clipcatctl'
	vbin 'bin/clipcatd'
	vinstall 'share/zsh/site-functions/_clipcatctl' 644 usr/share/zsh/site-functions
	vinstall 'share/zsh/site-functions/_clipcat-menu' 644 usr/share/zsh/site-functions
	vinstall 'share/zsh/site-functions/_clipcat-notify' 644 usr/share/zsh/site-functions
	vinstall 'share/zsh/site-functions/_clipcatd' 644 usr/share/zsh/site-functions
	vinstall 'share/bash-completion/completions/clipcatd.bash' 644 usr/share/bash-completion/completions 'clipcatd'
	vinstall 'share/bash-completion/completions/clipcatctl.bash' 644 usr/share/bash-completion/completions 'clipcatctl'
	vinstall 'share/bash-completion/completions/clipcat-menu.bash' 644 usr/share/bash-completion/completions 'clipcat-menu'
	vinstall 'share/bash-completion/completions/clipcat-notify.bash' 644 usr/share/bash-completion/completions 'clipcat-notify'
	vinstall 'share/fish/vendor_completions.d/clipcat-menu.fish' 644 usr/share/fish/vendor_completions.d
	vinstall 'share/fish/vendor_completions.d/clipcatd.fish' 644 usr/share/fish/vendor_completions.d
	vinstall 'share/fish/vendor_completions.d/clipcat-notify.fish' 644 usr/share/fish/vendor_completions.d
	vinstall 'share/fish/vendor_completions.d/clipcatctl.fish' 644 usr/share/fish/vendor_completions.d
}
