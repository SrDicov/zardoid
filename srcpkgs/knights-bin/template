# Template file for 'knights-bin'
pkgname=knights-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Knights [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Knights-AppImage"
distfiles="https://github.com/pkgforge-dev/Knights-AppImage/releases/download/26.08.1-1%402026-10-01_1790876410/Knights-26.08.1-1-anylinux-x86_64.AppImage>knights-bin-${version}.AppImage"
checksum=0a92e2972fef2e5ac5b50365f5fb332730713e7591f9cf4c9bfbb4b59fdb07d0
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/knights-bin
	vcopy "squashfs-root/*" opt/knights-bin
	vmkdir usr/bin
	ln -sf "/opt/knights-bin/AppRun" "${DESTDIR}/usr/bin/knights"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
