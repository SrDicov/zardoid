# Template file for 'mariokart64recomp-bin'
pkgname=mariokart64recomp-bin
version=0.9.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of MarioKart 64 Recompiled"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/MarioKart64Recomp-AppImage"
distfiles="https://github.com/pkgforge-dev/MarioKart64Recomp-AppImage/releases/download/${version}%402026-10-01_1790864444/MarioKart64Recompiled-${version}-anylinux-x86_64.AppImage>mariokart64recomp-bin-${version}.AppImage"
checksum=59f82a749875c450bd5966dd4841ba09e815f0713664bdc5c23f912ea1ea9328
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/mariokart64recomp-bin
	vcopy "squashfs-root/*" opt/mariokart64recomp-bin
	vmkdir usr/bin
	ln -sf "/opt/mariokart64recomp-bin/AppRun" "${DESTDIR}/usr/bin/mariokart64recomp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
