# Template file for 'gearsystem-bin'
pkgname=gearsystem-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Gearsystem [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Gearsystem-AppImage"
distfiles="https://github.com/pkgforge-dev/Gearsystem-AppImage/releases/download/3.9.22%402026-10-22_1792689332/Gearsystem-3.9.22-anylinux-x86_64.AppImage>gearsystem-bin-${version}.AppImage"
checksum=94b9f0dbd903d41d352099e1187356ca037dff867137bfde3c75a806d225fbe7
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gearsystem-bin
	vcopy "squashfs-root/*" opt/gearsystem-bin
	chmod -R o-w "${DESTDIR}/opt/gearsystem-bin"
	vmkdir usr/bin
	ln -sf "/opt/gearsystem-bin/AppRun" "${DESTDIR}/usr/bin/gearsystem"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
