# Template file for 'bibletime-bin'
pkgname=bibletime-bin
version=3.2.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of BibleTime [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/BibleTime-AppImage"
distfiles="https://github.com/pkgforge-dev/BibleTime-AppImage/releases/download/${version}-3%402026-10-01_1790876460/BibleTime-${version}-3-anylinux-x86_64.AppImage>bibletime-bin-${version}.AppImage"
checksum=b9fabc3c1f17b3762ca672dc3a8cbda94fdbe5df342a49ff506b33cd1568e34b
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/bibletime-bin
	vcopy "squashfs-root/*" opt/bibletime-bin
	vmkdir usr/bin
	ln -sf "/opt/bibletime-bin/AppRun" "${DESTDIR}/usr/bin/bibletime"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
