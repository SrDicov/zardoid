# Template file for 'bibletime-bin'
pkgname=bibletime-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of BibleTime [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/BibleTime-AppImage"
distfiles="https://github.com/pkgforge-dev/BibleTime-AppImage/releases/download/3.2.0-3%402026-10-22_1792689150/BibleTime-3.2.0-3-anylinux-x86_64.AppImage>bibletime-bin-${version}.AppImage"
checksum=2794c5b5e04577c21ab94003f47f61b24c7c16b687e6315c8b01961ac951ceb9
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/bibletime-bin
	vcopy "squashfs-root/*" opt/bibletime-bin
	chmod -R o-w "${DESTDIR}/opt/bibletime-bin"
	vmkdir usr/bin
	ln -sf "/opt/bibletime-bin/AppRun" "${DESTDIR}/usr/bin/bibletime"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
