# Template file for 'linuxtoys-bin'
pkgname=linuxtoys-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of LinuxToys [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/LinuxToys-AppImage"
distfiles="https://github.com/pkgforge-dev/LinuxToys-AppImage/releases/download/7.4.3-1%402026-10-01_1790876308/LinuxToys-7.4.3-1-anylinux-x86_64.AppImage>linuxtoys-bin-${version}.AppImage"
checksum=ede37740c3542fe7a7f8bfa4976ef7726110754622b85217c7fa6adf00d6a6b3
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/linuxtoys-bin
	vcopy "squashfs-root/*" opt/linuxtoys-bin
	vmkdir usr/bin
	ln -sf "/opt/linuxtoys-bin/AppRun" "${DESTDIR}/usr/bin/linuxtoys"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
