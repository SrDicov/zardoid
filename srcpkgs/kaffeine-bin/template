# Template file for 'kaffeine-bin'
pkgname=kaffeine-bin
version=2.0.19
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of kaffeine [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/kaffeine-AppImage"
distfiles="https://github.com/pkgforge-dev/kaffeine-AppImage/releases/download/${version}-4%402026-10-07_1791382323/Kaffeine-${version}-4-anylinux-x86_64.AppImage>kaffeine-bin-${version}.AppImage"
checksum=791b22b65f13f64a53f8fded6e1479c103cdef4c919641fcef7bdcad051e414f
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kaffeine-bin
	vcopy "squashfs-root/*" opt/kaffeine-bin
	vmkdir usr/bin
	ln -sf "/opt/kaffeine-bin/AppRun" "${DESTDIR}/usr/bin/kaffeine"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
