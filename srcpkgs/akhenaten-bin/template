# Template file for 'akhenaten-bin'
pkgname=akhenaten-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Akhenaten [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Akhenaten-AppImage"
distfiles="https://github.com/pkgforge-dev/Akhenaten-AppImage/releases/download/ra2606%402026-10-22_1792689070/Akhenaten-ra2606-anylinux-x86_64.AppImage>akhenaten-bin-${version}.AppImage"
checksum=62e577347b06fcd697ed382d18abee6637fb6295e09fae6783b7da02870ed245
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/akhenaten-bin
	vcopy "squashfs-root/*" opt/akhenaten-bin
	chmod -R o-w "${DESTDIR}/opt/akhenaten-bin"
	vmkdir usr/bin
	ln -sf "/opt/akhenaten-bin/AppRun" "${DESTDIR}/usr/bin/akhenaten"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
