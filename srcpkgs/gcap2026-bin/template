# Template file for 'gcap2026-bin'
pkgname=gcap2026-bin
version=20260727
revision=1
archs="x86_64"
short_desc="Appimage não oficial do GCAP2026 [Mantenedor=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/GCAP2026-AppImage"
distfiles="https://github.com/pkgforge-dev/GCAP2026-AppImage/releases/download/1.2%402026-07-27_1785182338/GCAP_2026-1.2-anylinux-x86_64.AppImage>gcap2026-bin-${version}.AppImage"
checksum=7e4ebd6415a04d7f7efcd57fcaab824c19591ff59711ed32e6d25f4c09a76488
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gcap2026-bin
	vcopy "squashfs-root/*" opt/gcap2026-bin
	chmod -R o-w "${DESTDIR}/opt/gcap2026-bin"
	vmkdir usr/bin
	ln -sf "/opt/gcap2026-bin/AppRun" "${DESTDIR}/usr/bin/gcap2026"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
