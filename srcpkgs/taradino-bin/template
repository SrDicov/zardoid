# Template file for 'taradino-bin'
pkgname=taradino-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Taradino [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Taradino-AppImage"
distfiles="https://github.com/pkgforge-dev/Taradino-AppImage/releases/download/2b4ea3c6c%402026-09-01_1788278029/Taradino-2b4ea3c6c-anylinux-x86_64.AppImage>taradino-bin-${version}.AppImage"
checksum=66939f2ec0475b33b425ac871e3beacfe06c1c5fd70ade58164454d01063956b
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/taradino-bin
	vcopy "squashfs-root/*" opt/taradino-bin
	vmkdir usr/bin
	ln -sf "/opt/taradino-bin/AppRun" "${DESTDIR}/usr/bin/taradino"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
