# Template file for 'identity-bin'
pkgname=identity-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Identity application for comparing
 images and"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Identity-AppImage"
distfiles="https://github.com/pkgforge-dev/Identity-AppImage/releases/download/26.03-2%402026-10-22_1792689007/Identity-26.03-2-anylinux-x86_64.AppImage>identity-bin-${version}.AppImage"
checksum=09c8342e61d85462d886a2d60810347f288552c8a0089d4ac0da3d83810b323f
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/identity-bin
	vcopy "squashfs-root/*" opt/identity-bin
	chmod -R o-w "${DESTDIR}/opt/identity-bin"
	vmkdir usr/bin
	ln -sf "/opt/identity-bin/AppRun" "${DESTDIR}/usr/bin/identity"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
