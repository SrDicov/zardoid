# Template file for 'identity-bin'
pkgname=identity-bin
version=26.03
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Identity application for comparing
 images and"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Identity-AppImage"
distfiles="https://github.com/pkgforge-dev/Identity-AppImage/releases/download/${version}-2%402026-10-01_1790876178/Identity-${version}-2-anylinux-x86_64.AppImage>identity-bin-${version}.AppImage"
checksum=ecd3e2c0602eeb1593970e7841c9fb6ebe87881c5a01e3fc56de785852baf825
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/identity-bin
	vcopy "squashfs-root/*" opt/identity-bin
	vmkdir usr/bin
	ln -sf "/opt/identity-bin/AppRun" "${DESTDIR}/usr/bin/identity"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
