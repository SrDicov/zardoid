# Template file for 'playerctl-bin'
pkgname=playerctl-bin
version=2.4.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of playerctl [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/playerctl-AppImage"
distfiles="https://github.com/pkgforge-dev/playerctl-AppImage/releases/download/${version}%402026-07-07_1783390136/playerctl-${version}-anylinux-x86_64.AppImage>playerctl-bin-${version}.AppImage"
checksum=5399aea2140c8057fea71c41a3e3d1f8b9d8e19ec36babb5147effded1b8ffa9
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/playerctl-bin
	vcopy "squashfs-root/*" opt/playerctl-bin
	vmkdir usr/bin
	ln -sf "/opt/playerctl-bin/AppRun" "${DESTDIR}/usr/bin/playerctl"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
