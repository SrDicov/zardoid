# Template file for 'oversteer-bin'
pkgname=oversteer-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Oversteer [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Oversteer-AppImage"
distfiles="https://github.com/pkgforge-dev/Oversteer-AppImage/releases/download/v0.8.3%402026-09-01_1788231331/Oversteer-v0.8.3-anylinux-x86_64.AppImage>oversteer-bin-${version}.AppImage"
checksum=7730cb1066dc3f1cd07db621d6bd2066ef4f5e55db7032213138bb90cff472f2
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/oversteer-bin
	vcopy "squashfs-root/*" opt/oversteer-bin
	vmkdir usr/bin
	ln -sf "/opt/oversteer-bin/AppRun" "${DESTDIR}/usr/bin/oversteer"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
