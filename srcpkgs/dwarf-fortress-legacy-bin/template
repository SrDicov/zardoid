# Template file for 'dwarf-fortress-legacy-bin'
pkgname=dwarf-fortress-legacy-bin
version=0.47.5
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Dwarf Fortress Legacy"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Dwarf-Fortress-Legacy-AppImage"
distfiles="https://github.com/pkgforge-dev/Dwarf-Fortress-Legacy-AppImage/releases/download/${version}%402026-08-30_1788107151/Dwarf_Fortress_Legacy-${version}-anylinux-x86_64.AppImage>dwarf-fortress-legacy-bin-${version}.AppImage"
checksum=82c9b9d4125650d7dc9e8b84e0d6712aa6e0b0a7fa447731e5e9ef3275e3fa36
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dwarf-fortress-legacy-bin
	vcopy "squashfs-root/*" opt/dwarf-fortress-legacy-bin
	vmkdir usr/bin
	ln -sf "/opt/dwarf-fortress-legacy-bin/AppRun" "${DESTDIR}/usr/bin/dwarf-fortress-legacy"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
