# Template file for 'gnome-web-bin'
pkgname=gnome-web-bin
version=50.6
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Gnome Web aka Epiphany.
 [Maintainer=@fiftydinar]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Gnome-Web-AppImage"
distfiles="https://github.com/pkgforge-dev/Gnome-Web-AppImage/releases/download/${version}-1%402026-10-01_1790876094/Web-${version}-1-anylinux-x86_64.AppImage>gnome-web-bin-${version}.AppImage"
checksum=f849da662c61d1eb3fda2440dbb659a3033b5074bda334a230c2f00e50b168eb
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gnome-web-bin
	vcopy "squashfs-root/*" opt/gnome-web-bin
	vmkdir usr/bin
	ln -sf "/opt/gnome-web-bin/AppRun" "${DESTDIR}/usr/bin/gnome-web"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
