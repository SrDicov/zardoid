# Template file for 'cosign-bin'
pkgname=cosign-bin
version=3.1.3
revision=1
archs="x86_64*"
short_desc="Code signing and transparency for containers and binaries"
maintainer="SrDicov <SrDicov@gmail.com>"
license="Apache-2.0"
homepage="https://github.com/sigstore/cosign"
distfiles="https://github.com/sigstore/cosign/releases/download/v${version}/cosign-linux-amd64"
checksum=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71
nopie=yes
noshlibprovides=yes
nostrip=yes
skip_extraction="cosign-linux-amd64"

post_extract() {
	local f='cosign-linux-amd64'
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	vbin 'cosign-linux-amd64' 'cosign'
}
