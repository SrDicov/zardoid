# Template file for 'phoenix-x-server-bin'
pkgname=phoenix-x-server-bin
version=20261002
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Phoenix X server
 [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/phoenix-x-server-AppImage"
distfiles="https://github.com/pkgforge-dev/phoenix-x-server-AppImage/releases/download/r319.49faeb0-1%402026-10-02_1790948534/phoenix-r319.49faeb0-1-anylinux-x86_64.AppImage>phoenix-x-server-bin-${version}.AppImage"
checksum=6f27930300ba9dd0085252c765d3a24ef4f3c15bcc850f80aecf30e3bf7cc85a
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/phoenix-x-server-bin
	vcopy "squashfs-root/*" opt/phoenix-x-server-bin
	vmkdir usr/bin
	ln -sf "/opt/phoenix-x-server-bin/AppRun" "${DESTDIR}/usr/bin/phoenix-x-server"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
