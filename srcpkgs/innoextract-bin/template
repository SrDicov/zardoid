# Template file for 'innoextract-bin'
pkgname=innoextract-bin
version=20261025
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of innoextract [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/innoextract-AppImage"
distfiles="https://github.com/pkgforge-dev/innoextract-AppImage/releases/download/1.9-17%402026-10-25_1792907224/innoextract-1.9-17-anylinux-x86_64.AppImage>innoextract-bin-${version}.AppImage"
checksum=1aa07939eef301e43f16863e82c64be0fd41a17cf9cdb5087e3a151035fd6b16
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/innoextract-bin
	vcopy "squashfs-root/*" opt/innoextract-bin
	chmod -R o-w "${DESTDIR}/opt/innoextract-bin"
	vmkdir usr/bin
	ln -sf "/opt/innoextract-bin/AppRun" "${DESTDIR}/usr/bin/innoextract"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
