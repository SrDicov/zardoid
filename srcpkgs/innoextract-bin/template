# Template file for 'innoextract-bin'
pkgname=innoextract-bin
version=1.9
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of innoextract [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/innoextract-AppImage"
distfiles="https://github.com/pkgforge-dev/innoextract-AppImage/releases/download/${version}-17%402026-10-01_1790876661/innoextract-${version}-17-anylinux-x86_64.AppImage>innoextract-bin-${version}.AppImage"
checksum=571ddfabb54f798cf903a6d7eec155363085f27de8e84d85164147f2c9fe4cb9
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/innoextract-bin
	vcopy "squashfs-root/*" opt/innoextract-bin
	vmkdir usr/bin
	ln -sf "/opt/innoextract-bin/AppRun" "${DESTDIR}/usr/bin/innoextract"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
