# Template file for 'duckstation-gpl-bin'
pkgname=duckstation-gpl-bin
version=0.1.7465
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of DuckStation when it was still GPLv3"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/DuckStation-GPL-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/DuckStation-GPL-AppImage-Enhanced/releases/download/${version}-7%402026-05-01_1777674496/DuckStation-${version}-7-anylinux-x86_64.AppImage>duckstation-gpl-bin-${version}.AppImage"
checksum=3902115dbff11cdd44133b34c24c2dfbcac35cda092bab9c8e61604158304b2b
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/duckstation-gpl-bin
	vcopy "squashfs-root/*" opt/duckstation-gpl-bin
	vmkdir usr/bin
	ln -sf "/opt/duckstation-gpl-bin/AppRun" "${DESTDIR}/usr/bin/duckstation-gpl"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
