# Template file for 'rustdesk-bin'
pkgname=rustdesk-bin
version=1.4.9
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of rustdesk which is able to work on any linux"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/RustDesk-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/RustDesk-AppImage-Enhanced/releases/download/${version}-1%402026-10-01_1790876427/RustDesk-${version}-1-anylinux-x86_64.AppImage>rustdesk-bin-${version}.AppImage"
checksum=72d37bd4b65af9a15e2b063a0b58c2b0455f92bbf707460049815dadf604a0ff
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rustdesk-bin
	vcopy "squashfs-root/*" opt/rustdesk-bin
	vmkdir usr/bin
	ln -sf "/opt/rustdesk-bin/AppRun" "${DESTDIR}/usr/bin/rustdesk"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
