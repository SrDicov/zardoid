# Template file for 'rustdesk-bin'
pkgname=rustdesk-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of rustdesk which is able to work on any linux"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/RustDesk-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/RustDesk-AppImage-Enhanced/releases/download/1.5.0-1%402026-10-22_1792689332/RustDesk-1.5.0-1-anylinux-x86_64.AppImage>rustdesk-bin-${version}.AppImage"
checksum=6572deab8717691d2a4293cff3dc241e1d7d739aaad71e2b2a3eb72943fd16ee
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rustdesk-bin
	vcopy "squashfs-root/*" opt/rustdesk-bin
	chmod -R o-w "${DESTDIR}/opt/rustdesk-bin"
	vmkdir usr/bin
	ln -sf "/opt/rustdesk-bin/AppRun" "${DESTDIR}/usr/bin/rustdesk"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
