# Template file for 'openttd-bin'
pkgname=openttd-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenTTD [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenTTD-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenTTD-AppImage/releases/download/15.3-1%402026-10-22_1792689148/OpenTTD-15.3-1-anylinux-x86_64.AppImage>openttd-bin-${version}.AppImage"
checksum=14f074c64bd7d4f2dcdfd2ba35cdf28a285b1bb23fc8bee0b5337daa5b7f6416
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openttd-bin
	vcopy "squashfs-root/*" opt/openttd-bin
	chmod -R o-w "${DESTDIR}/opt/openttd-bin"
	vmkdir usr/bin
	ln -sf "/opt/openttd-bin/AppRun" "${DESTDIR}/usr/bin/openttd"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
