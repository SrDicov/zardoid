# Template file for 'openttd-bin'
pkgname=openttd-bin
version=15.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenTTD [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenTTD-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenTTD-AppImage/releases/download/${version}-1%402026-10-01_1790876107/OpenTTD-${version}-1-anylinux-x86_64.AppImage>openttd-bin-${version}.AppImage"
checksum=d85b181e3fc6f583f923464eb5c34b33033f5676bb4420bf940d6108f72c4d18
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openttd-bin
	vcopy "squashfs-root/*" opt/openttd-bin
	vmkdir usr/bin
	ln -sf "/opt/openttd-bin/AppRun" "${DESTDIR}/usr/bin/openttd"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
