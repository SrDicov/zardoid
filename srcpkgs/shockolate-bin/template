# Template file for 'shockolate-bin'
pkgname=shockolate-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Shockolate [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Shockolate-AppImage"
distfiles="https://github.com/pkgforge-dev/Shockolate-AppImage/releases/download/6c1fe472e%402026-10-01_1790876647/Shockolate-6c1fe472e-anylinux-x86_64.AppImage>shockolate-bin-${version}.AppImage"
checksum=227f4a45582aa4988b3bdb06965e4f7047a41f1f90571c67cbf1e94f2de1deb5
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/shockolate-bin
	vcopy "squashfs-root/*" opt/shockolate-bin
	vmkdir usr/bin
	ln -sf "/opt/shockolate-bin/AppRun" "${DESTDIR}/usr/bin/shockolate"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
