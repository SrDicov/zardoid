# Template file for 'itr2025-bin'
pkgname=itr2025-bin
version=20260911
revision=1
archs="x86_64"
short_desc="Appimage não oficial do ITR2025 [Mantenedor=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ITR2025-AppImage"
distfiles="https://github.com/pkgforge-dev/ITR2025-AppImage/releases/download/1.8%402026-09-11_1789094327/ITR_2025-1.8-anylinux-x86_64.AppImage>itr2025-bin-${version}.AppImage"
checksum=4d78497fdec06f06c55ac89ab7986771d51faa00854eb9d2abcca3c46d2d98fa
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/itr2025-bin
	vcopy "squashfs-root/*" opt/itr2025-bin
	chmod -R o-w "${DESTDIR}/opt/itr2025-bin"
	vmkdir usr/bin
	ln -sf "/opt/itr2025-bin/AppRun" "${DESTDIR}/usr/bin/itr2025"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
