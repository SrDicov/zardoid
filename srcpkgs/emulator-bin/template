# Template file for 'emulator-bin'
pkgname=emulator-bin
version=20260427
revision=1
archs="x86_64"
short_desc="Switch fell off https://citron-neo.org/"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/citron-neo/emulator"
distfiles="https://github.com/citron-neo/emulator/releases/download/2026-04-27/citron_nightly-0237a9b88-linux-x86_64.AppImage>emulator-bin-${version}.AppImage"
checksum=bf62002fd0f892ae1c25b8776461e5da59717ece016a9e50db207019ea6ea123
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/emulator-bin
	vcopy "squashfs-root/*" opt/emulator-bin
	chmod -R o-w "${DESTDIR}/opt/emulator-bin"
	vmkdir usr/bin
	ln -sf "/opt/emulator-bin/AppRun" "${DESTDIR}/usr/bin/emulator"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
