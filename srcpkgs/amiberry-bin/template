# Template file for 'amiberry-bin'
pkgname=amiberry-bin
version=8.3.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Amiberry [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Amiberry-AppImage"
distfiles="https://github.com/pkgforge-dev/Amiberry-AppImage/releases/download/${version}%402026-09-01_1788278384/Amiberry-${version}-anylinux-x86_64.AppImage>amiberry-bin-${version}.AppImage"
checksum=0d0677156a92cca1c6cc19e9680d0beab58bf1be05306e425fdfb96ae04cf155
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/amiberry-bin
	vcopy "squashfs-root/*" opt/amiberry-bin
	vmkdir usr/bin
	ln -sf "/opt/amiberry-bin/AppRun" "${DESTDIR}/usr/bin/amiberry"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
