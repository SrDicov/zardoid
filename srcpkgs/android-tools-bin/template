# Template file for 'android-tools-bin'
pkgname=android-tools-bin
version=37.0.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Android Platform Tools (adb, fastboot, etc).
 Can"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/android-tools-AppImage"
distfiles="https://github.com/pkgforge-dev/android-tools-AppImage/releases/download/${version}%402026-10-01_1790871631/Android_Tools-${version}-anylinux-x86_64.AppImage>android-tools-bin-${version}.AppImage"
checksum=f0f84cf812100f1763274c43776963e9994a83b1476df75b6f596f7bea7d4cdd
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/android-tools-bin
	vcopy "squashfs-root/*" opt/android-tools-bin
	vmkdir usr/bin
	ln -sf "/opt/android-tools-bin/AppRun" "${DESTDIR}/usr/bin/android-tools"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
