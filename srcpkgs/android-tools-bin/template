# Template file for 'android-tools-bin'
pkgname=android-tools-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Android Platform Tools (adb, fastboot, etc).
 Can"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/android-tools-AppImage"
distfiles="https://github.com/pkgforge-dev/android-tools-AppImage/releases/download/37.0.1%402026-10-22_1792682064/Android_Tools-37.0.1-anylinux-x86_64.AppImage>android-tools-bin-${version}.AppImage"
checksum=44cc40cc32f7750a365adb0ed7baef92e68f51bf8706eef03077f3bcd01f094f
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/android-tools-bin
	vcopy "squashfs-root/*" opt/android-tools-bin
	chmod -R o-w "${DESTDIR}/opt/android-tools-bin"
	vmkdir usr/bin
	ln -sf "/opt/android-tools-bin/AppRun" "${DESTDIR}/usr/bin/android-tools"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
