# Template file for 'xoreos-bin'
pkgname=xoreos-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of xoreos [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/xoreos-AppImage"
distfiles="https://github.com/pkgforge-dev/xoreos-AppImage/releases/download/6774724d5%402026-10-01_1790876643/xoreos-6774724d5-anylinux-x86_64.AppImage>xoreos-bin-${version}.AppImage"
checksum=16cfed87ef85cefdef701d47b06b7b0b1e1db258da0382bbbd2f1199263d072b
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/xoreos-bin
	vcopy "squashfs-root/*" opt/xoreos-bin
	vmkdir usr/bin
	ln -sf "/opt/xoreos-bin/AppRun" "${DESTDIR}/usr/bin/xoreos"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
