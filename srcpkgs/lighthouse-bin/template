# Template file for 'lighthouse-bin'
pkgname=lighthouse-bin
version=1.1.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Lighthouse [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Lighthouse-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Lighthouse-AppImage-Enhanced/releases/download/${version}%402026-09-22_1790090511/Lighthouse-${version}-anylinux-x86_64.AppImage>lighthouse-bin-${version}.AppImage"
checksum=678b1409f63e14aa5645ca8d4cf83e035f5b013913f7f1e4d55afdd5e9e7a81a
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/lighthouse-bin
	vcopy "squashfs-root/*" opt/lighthouse-bin
	vmkdir usr/bin
	ln -sf "/opt/lighthouse-bin/AppRun" "${DESTDIR}/usr/bin/lighthouse"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
