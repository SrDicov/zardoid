# Template file for 'classicube-bin'
pkgname=classicube-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ClassiCube [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ClassiCube-AppImage"
distfiles="https://github.com/pkgforge-dev/ClassiCube-AppImage/releases/download/bb0c45e89%402026-10-01_1790876545/ClassiCube-bb0c45e89-anylinux-x86_64.AppImage>classicube-bin-${version}.AppImage"
checksum=910731ecf62015a03a29d9a09e16ba1bf148b92176071b16d40197fd6a8581c0
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/classicube-bin
	vcopy "squashfs-root/*" opt/classicube-bin
	vmkdir usr/bin
	ln -sf "/opt/classicube-bin/AppRun" "${DESTDIR}/usr/bin/classicube"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
