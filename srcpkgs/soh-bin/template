# Template file for 'soh-bin'
pkgname=soh-bin
version=9.2.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Shipwright [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/soh-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/soh-AppImage-Enhanced/releases/download/${version}%402026-09-01_1788278441/SOH-${version}-anylinux-x86_64.AppImage>soh-bin-${version}.AppImage"
checksum=b7a12395e7f7844f3b54ac2c70be52e2bc95bae5ff363551452d3d391a5e8ddd
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/soh-bin
	vcopy "squashfs-root/*" opt/soh-bin
	vmkdir usr/bin
	ln -sf "/opt/soh-bin/AppRun" "${DESTDIR}/usr/bin/soh"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
