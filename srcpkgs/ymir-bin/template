# Template file for 'ymir-bin'
pkgname=ymir-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Ymir [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Ymir-AppImage"
distfiles="https://github.com/pkgforge-dev/Ymir-AppImage/releases/download/8292b1072%402026-10-01_1790876583/Ymir-8292b1072-anylinux-x86_64.AppImage>ymir-bin-${version}.AppImage"
checksum=1d5ea431e395a0d422b6704fe6514a989ea92f3f789844e98a67e1b1bb630919
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ymir-bin
	vcopy "squashfs-root/*" opt/ymir-bin
	vmkdir usr/bin
	ln -sf "/opt/ymir-bin/AppRun" "${DESTDIR}/usr/bin/ymir"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
