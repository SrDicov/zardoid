# Template file for 'contour-bin'
pkgname=contour-bin
version=0.7.0.8982
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Contour Terminal Emulator"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/contour-AppImage"
distfiles="https://github.com/pkgforge-dev/contour-AppImage/releases/download/${version}-1%402026-10-01_1790876390/Contour-${version}-1-anylinux-x86_64.AppImage>contour-bin-${version}.AppImage"
checksum=24e2411873ff6d7e49491159e57b56397a788b3d87c0c363caec5d5b8c0e138a
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/contour-bin
	vcopy "squashfs-root/*" opt/contour-bin
	vmkdir usr/bin
	ln -sf "/opt/contour-bin/AppRun" "${DESTDIR}/usr/bin/contour"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
