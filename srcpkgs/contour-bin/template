# Template file for 'contour-bin'
pkgname=contour-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Contour Terminal Emulator"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/contour-AppImage"
distfiles="https://github.com/pkgforge-dev/contour-AppImage/releases/download/0.7.0.8982-1%402026-10-22_1792688944/Contour-0.7.0.8982-1-anylinux-x86_64.AppImage>contour-bin-${version}.AppImage"
checksum=231d424cd550201b59a41b3f9c65239025a3a5b64329a7818b77c8a8719760b5
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/contour-bin
	vcopy "squashfs-root/*" opt/contour-bin
	chmod -R o-w "${DESTDIR}/opt/contour-bin"
	vmkdir usr/bin
	ln -sf "/opt/contour-bin/AppRun" "${DESTDIR}/usr/bin/contour"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
