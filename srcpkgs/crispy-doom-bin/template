# Template file for 'crispy-doom-bin'
pkgname=crispy-doom-bin
version=7.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Crispy Doom [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Crispy-Doom-AppImage"
distfiles="https://github.com/pkgforge-dev/Crispy-Doom-AppImage/releases/download/${version}%402026-10-18_1792290581/Crispy_Doom-${version}-anylinux-x86_64.AppImage>crispy-doom-bin-${version}.AppImage"
checksum=51814bea675f26311af2f6263a7cde38d34d68015273a18133b57bbbb120944d
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/crispy-doom-bin
	vcopy "squashfs-root/*" opt/crispy-doom-bin
	vmkdir usr/bin
	ln -sf "/opt/crispy-doom-bin/AppRun" "${DESTDIR}/usr/bin/crispy-doom"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
