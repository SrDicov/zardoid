# Template file for 'pinta-bin'
pkgname=pinta-bin
version=3.1.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Pinta [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Pinta-AppImage"
distfiles="https://github.com/pkgforge-dev/Pinta-AppImage/releases/download/${version}%402026-10-02_1790948980/Pinta-${version}-anylinux-x86_64.AppImage>pinta-bin-${version}.AppImage"
checksum=7cfd1a8b8a35d59de4be34bb7e320982cffce17f01efef8cd7992a4c7f07867c
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pinta-bin
	vcopy "squashfs-root/*" opt/pinta-bin
	vmkdir usr/bin
	ln -sf "/opt/pinta-bin/AppRun" "${DESTDIR}/usr/bin/pinta"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
