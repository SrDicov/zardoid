# Template file for 'flashrom-bin'
pkgname=flashrom-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of flashrom [Maintainer=@lucasmz1]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Flashrom-AppImage"
distfiles="https://github.com/pkgforge-dev/Flashrom-AppImage/releases/download/1.8.0-1%402026-10-22_1792689165/flashrom-1.8.0-1-anylinux-x86_64.AppImage>flashrom-bin-${version}.AppImage"
checksum=a4ad7762423867808f2ce6062160acb315f14cbfb56802fa48c9b6b96ff09d3d
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/flashrom-bin
	vcopy "squashfs-root/*" opt/flashrom-bin
	chmod -R o-w "${DESTDIR}/opt/flashrom-bin"
	vmkdir usr/bin
	ln -sf "/opt/flashrom-bin/AppRun" "${DESTDIR}/usr/bin/flashrom"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
