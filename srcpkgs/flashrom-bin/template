# Template file for 'flashrom-bin'
pkgname=flashrom-bin
version=1.8.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of flashrom [Maintainer=@lucasmz1]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Flashrom-AppImage"
distfiles="https://github.com/pkgforge-dev/Flashrom-AppImage/releases/download/${version}-1%402026-10-01_1790876393/flashrom-${version}-1-anylinux-x86_64.AppImage>flashrom-bin-${version}.AppImage"
checksum=d9fb578e74204239d5774746c4a088c854e62c95ae06585ea8b3a01bc14902fa
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/flashrom-bin
	vcopy "squashfs-root/*" opt/flashrom-bin
	vmkdir usr/bin
	ln -sf "/opt/flashrom-bin/AppRun" "${DESTDIR}/usr/bin/flashrom"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
