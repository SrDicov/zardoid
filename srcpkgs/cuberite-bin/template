# Template file for 'cuberite-bin'
pkgname=cuberite-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Cuberite [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Cuberite-AppImage"
distfiles="https://github.com/pkgforge-dev/Cuberite-AppImage/releases/download/r445%402026-10-01_1790874911/Cuberite-r445-anylinux-x86_64.AppImage>cuberite-bin-${version}.AppImage"
checksum=4bd442468b9e5586bb54d55b07037489477ed1b7c93f7b504fb9fa7697cfeb1b
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cuberite-bin
	vcopy "squashfs-root/*" opt/cuberite-bin
	vmkdir usr/bin
	ln -sf "/opt/cuberite-bin/AppRun" "${DESTDIR}/usr/bin/cuberite"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
