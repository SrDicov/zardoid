# Template file for 'kstars-bin'
pkgname=kstars-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KStars [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KStars-AppImage"
distfiles="https://github.com/pkgforge-dev/KStars-AppImage/releases/download/3.8.4.1-1%402026-10-01_1790875995/KStars-3.8.4.1-1-anylinux-x86_64.AppImage>kstars-bin-${version}.AppImage"
checksum=fc2a66db20d145df28b9015e155d1496c90e3c7ffe5a4433ad984ff2479c6de4
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kstars-bin
	vcopy "squashfs-root/*" opt/kstars-bin
	vmkdir usr/bin
	ln -sf "/opt/kstars-bin/AppRun" "${DESTDIR}/usr/bin/kstars"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
