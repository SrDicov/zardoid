# Template file for 'cdogs-sdl-bin'
pkgname=cdogs-sdl-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of C-Dogs SDL [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/C-Dogs_SDL-AppImage"
distfiles="https://github.com/pkgforge-dev/C-Dogs_SDL-AppImage/releases/download/2.5.0%402026-10-22_1792689142/C-Dogs_SDL-2.5.0-anylinux-x86_64.AppImage>cdogs-sdl-bin-${version}.AppImage"
checksum=7ac9f96671708033273b1dc860ba3fdc729e00c02e2b16736a21f4f34a5f5a33
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cdogs-sdl-bin
	vcopy "squashfs-root/*" opt/cdogs-sdl-bin
	chmod -R o-w "${DESTDIR}/opt/cdogs-sdl-bin"
	vmkdir usr/bin
	ln -sf "/opt/cdogs-sdl-bin/AppRun" "${DESTDIR}/usr/bin/cdogs-sdl"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
