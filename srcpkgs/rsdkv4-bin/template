# Template file for 'rsdkv4-bin'
pkgname=rsdkv4-bin
version=20261007
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of RSDKv4 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/RSDKv4-AppImage"
distfiles="https://github.com/pkgforge-dev/RSDKv4-AppImage/releases/download/a7f5195e2%402026-10-07_1791381840/RSDKv4-a7f5195e2-anylinux-x86_64.AppImage>rsdkv4-bin-${version}.AppImage"
checksum=10efe083aec62845f368b6cdf663b4b3b0e7aabb18cafab1e457fa74b88953cb
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rsdkv4-bin
	vcopy "squashfs-root/*" opt/rsdkv4-bin
	vmkdir usr/bin
	ln -sf "/opt/rsdkv4-bin/AppRun" "${DESTDIR}/usr/bin/rsdkv4"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
