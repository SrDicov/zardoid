# Template file for 'cursor-bin'
pkgname=cursor-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Cursor which is able to work on any linux
 distro"
maintainer="SrDicov <SrDicov@gmail.com>"
license="custom:Proprietary"
homepage="https://github.com/pkgforge-dev/Cursor-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Cursor-AppImage-Enhanced/releases/download/3.22.12%402026-10-01_1790875580/Cursor-3.22.12-anylinux-x86_64.AppImage>cursor-bin-${version}.AppImage"
checksum=c2f189272ea5ce071c49cf98d3949bd9930499d0bdc9920bb879f06ea782ec93
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cursor-bin
	vcopy "squashfs-root/*" opt/cursor-bin
	chmod -R o-w "${DESTDIR}/opt/cursor-bin"
	vmkdir usr/bin
	ln -sf "/opt/cursor-bin/AppRun" "${DESTDIR}/usr/bin/cursor"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
