# Template file for 'cursor-bin'
pkgname=cursor-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Cursor which is able to work on any linux
 distro"
maintainer="SrDicov <SrDicov@gmail.com>"
license="custom:Proprietary"
homepage="https://github.com/pkgforge-dev/Cursor-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Cursor-AppImage-Enhanced/releases/download/3.24.18%402026-10-22_1792687850/Cursor-3.24.18-anylinux-x86_64.AppImage>cursor-bin-${version}.AppImage"
checksum=187841199163bb313551a18ec13df6c68319379e3d13e7ee16e7d3812b93bc31
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cursor-bin
	vcopy "squashfs-root/*" opt/cursor-bin
	chmod -R o-w "${DESTDIR}/opt/cursor-bin"
	vmkdir usr/bin
	ln -sf "/opt/cursor-bin/AppRun" "${DESTDIR}/usr/bin/cursor"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
