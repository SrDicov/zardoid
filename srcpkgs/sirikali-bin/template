# Template file for 'sirikali-bin'
pkgname=sirikali-bin
version=1.8.6
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of SiriKali [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SiriKali-AppImage"
distfiles="https://github.com/pkgforge-dev/SiriKali-AppImage/releases/download/${version}-1%402026-10-01_1790876599/SiriKali-${version}-1-anylinux-x86_64.AppImage>sirikali-bin-${version}.AppImage"
checksum=2b51f217291e31133e35daae28f9fce580339bb60b0df78105e4541f1877b552
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/sirikali-bin
	vcopy "squashfs-root/*" opt/sirikali-bin
	vmkdir usr/bin
	ln -sf "/opt/sirikali-bin/AppRun" "${DESTDIR}/usr/bin/sirikali"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
