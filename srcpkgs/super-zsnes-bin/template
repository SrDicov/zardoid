# Template file for 'super-zsnes-bin'
pkgname=super-zsnes-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of SUPER ZSNES [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SUPER-ZSNES-AppImage"
distfiles="https://github.com/pkgforge-dev/SUPER-ZSNES-AppImage/releases/download/0.310%402026-10-22_1792689238/SUPER_ZSNES-0.310-anylinux-x86_64.AppImage>super-zsnes-bin-${version}.AppImage"
checksum=6c1d188f7269bd43ee6f6233debb756fc03742c40f5442d83b0570e8df6c663a
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/super-zsnes-bin
	vcopy "squashfs-root/*" opt/super-zsnes-bin
	chmod -R o-w "${DESTDIR}/opt/super-zsnes-bin"
	vmkdir usr/bin
	ln -sf "/opt/super-zsnes-bin/AppRun" "${DESTDIR}/usr/bin/super-zsnes"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
