# Template file for 'super-zsnes-bin'
pkgname=super-zsnes-bin
version=0.310
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of SUPER ZSNES [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SUPER-ZSNES-AppImage"
distfiles="https://github.com/pkgforge-dev/SUPER-ZSNES-AppImage/releases/download/${version}%402026-10-01_1790876507/SUPER_ZSNES-${version}-anylinux-x86_64.AppImage>super-zsnes-bin-${version}.AppImage"
checksum=5497098400630284c643ba19fdf57764e4ec6434694cd5f4cece1857af86f33e
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/super-zsnes-bin
	vcopy "squashfs-root/*" opt/super-zsnes-bin
	vmkdir usr/bin
	ln -sf "/opt/super-zsnes-bin/AppRun" "${DESTDIR}/usr/bin/super-zsnes"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
