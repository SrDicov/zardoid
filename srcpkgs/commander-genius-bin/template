# Template file for 'commander-genius-bin'
pkgname=commander-genius-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Commander-Genius
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Commander-Genius-AppImage"
distfiles="https://github.com/pkgforge-dev/Commander-Genius-AppImage/releases/download/58a3c4fd0%402026-10-01_1790876531/Commander_Genius-58a3c4fd0-anylinux-x86_64.AppImage>commander-genius-bin-${version}.AppImage"
checksum=0261f672002212419e62a60ff05de1ddd845ced12f97a3a065553530e45dd900
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/commander-genius-bin
	vcopy "squashfs-root/*" opt/commander-genius-bin
	vmkdir usr/bin
	ln -sf "/opt/commander-genius-bin/AppRun" "${DESTDIR}/usr/bin/commander-genius"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
