# Template file for 'iris-bin'
pkgname=iris-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Iris [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Iris-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Iris-AppImage-Enhanced/releases/download/0.20-alpha%402026-10-01_1790876476/Iris-0.20-alpha-anylinux-x86_64.AppImage>iris-bin-${version}.AppImage"
checksum=f216c2c04b849615b4cdd21991cdf81e69099e0d44756eb8705499ca4a846343
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/iris-bin
	vcopy "squashfs-root/*" opt/iris-bin
	vmkdir usr/bin
	ln -sf "/opt/iris-bin/AppRun" "${DESTDIR}/usr/bin/iris"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
