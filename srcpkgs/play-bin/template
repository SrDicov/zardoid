# Template file for 'play-bin'
pkgname=play-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Play! [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Play-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Play-AppImage-Enhanced/releases/download/83700b2c3%402026-10-01_1790876504/Play.-83700b2c3-anylinux-x86_64.AppImage>play-bin-${version}.AppImage"
checksum=9895814167790a92e7f8e087d0052fff277563ae55a8a337eccd05dc002d59af
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/play-bin
	vcopy "squashfs-root/*" opt/play-bin
	vmkdir usr/bin
	ln -sf "/opt/play-bin/AppRun" "${DESTDIR}/usr/bin/play"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
