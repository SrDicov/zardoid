# Template file for 'sview-bin'
pkgname=sview-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of sView. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/sView-AppImage"
distfiles="https://github.com/pkgforge-dev/sView-AppImage/releases/download/26_09%402026-10-22_1792689382/sView-26_09-anylinux-x86_64.AppImage>sview-bin-${version}.AppImage"
checksum=f72a97cb56dabd4fb7195cf1c6c3eb2be26cb18bc6d842ba801661a944331e99
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/sview-bin
	vcopy "squashfs-root/*" opt/sview-bin
	chmod -R o-w "${DESTDIR}/opt/sview-bin"
	vmkdir usr/bin
	ln -sf "/opt/sview-bin/AppRun" "${DESTDIR}/usr/bin/sview"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
