# Template file for 'openrct2-bin'
pkgname=openrct2-bin
version=0.5.6
revision=1
archs="x86_64"
short_desc="Open source re-implementation of RollerCoaster Tycoon 2 🎢"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://openrct2.io"
distfiles="https://github.com/OpenRCT2/OpenRCT2/releases/download/v${version}/OpenRCT2-v${version}-linux-x86_64.AppImage>openrct2-bin-${version}.AppImage"
checksum=8198b5ef8b9b07685fc860f3f04ce88a5f07ce6c1e5a9e2badffa811ed0f2eba
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openrct2-bin
	vcopy "squashfs-root/*" opt/openrct2-bin
	vmkdir usr/bin
	ln -sf "/opt/openrct2-bin/AppRun" "${DESTDIR}/usr/bin/openrct2"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
