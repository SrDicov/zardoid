# Template file for 'ladybird-bin'
pkgname=ladybird-bin
version=20260622
revision=1
archs="x86_64"
short_desc="AppImage for Ladybird Browser [Maintainer=@psadi]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="BSD-2-Clause"
homepage="https://github.com/pkgforge-dev/ladybird-appimage"
distfiles="https://github.com/pkgforge-dev/ladybird-appimage/releases/download/r79202.0be802797ac-1%402026-06-22_1782145637/Ladybird-r79202.0be802797ac-1-anylinux-x86_64.AppImage>ladybird-bin-${version}.AppImage"
checksum=9b8d97b41383057fd3cbe1f36c80f5fbabb5e4521136d45108cfdbdcb2c901df
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ladybird-bin
	vcopy "squashfs-root/*" opt/ladybird-bin
	chmod -R o-w "${DESTDIR}/opt/ladybird-bin"
	vmkdir usr/bin
	ln -sf "/opt/ladybird-bin/AppRun" "${DESTDIR}/usr/bin/ladybird"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
