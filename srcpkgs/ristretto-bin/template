# Template file for 'ristretto-bin'
pkgname=ristretto-bin
version=0.14.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Ristretto Image Viewer"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Ristretto-AppImage"
distfiles="https://github.com/pkgforge-dev/Ristretto-AppImage/releases/download/${version}-1%402026-09-07_1788786454/Ristretto-${version}-1-anylinux-x86_64.AppImage>ristretto-bin-${version}.AppImage"
checksum=70371278eedb8928fb2f67da8a18934699de089e6d37769e0dab87ddda667c3e
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ristretto-bin
	vcopy "squashfs-root/*" opt/ristretto-bin
	vmkdir usr/bin
	ln -sf "/opt/ristretto-bin/AppRun" "${DESTDIR}/usr/bin/ristretto"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
