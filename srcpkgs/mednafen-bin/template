# Template file for 'mednafen-bin'
pkgname=mednafen-bin
version=1.32.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the mednafen emulator"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/mednafen-AppImage"
distfiles="https://github.com/pkgforge-dev/mednafen-AppImage/releases/download/${version}%402026-09-25_1790380012/Mednafen_Emulator-${version}-anylinux-x86_64.AppImage>mednafen-bin-${version}.AppImage"
checksum=954e3b0038b5cc7bd1ca1dd0717075d07e0f0f2f97e82c693f728925589069c1
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/mednafen-bin
	vcopy "squashfs-root/*" opt/mednafen-bin
	vmkdir usr/bin
	ln -sf "/opt/mednafen-bin/AppRun" "${DESTDIR}/usr/bin/mednafen"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
