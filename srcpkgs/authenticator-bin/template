# Template file for 'authenticator-bin'
pkgname=authenticator-bin
version=4.6.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Authenticator 2FA code generator
 application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Authenticator-AppImage"
distfiles="https://github.com/pkgforge-dev/Authenticator-AppImage/releases/download/${version}-2%402026-10-01_1790876333/Authenticator-${version}-2-anylinux-x86_64.AppImage>authenticator-bin-${version}.AppImage"
checksum=53f0932008c35c20a14d2222366d595425c77487405b1edea8041bb5100bb6a5
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/authenticator-bin
	vcopy "squashfs-root/*" opt/authenticator-bin
	vmkdir usr/bin
	ln -sf "/opt/authenticator-bin/AppRun" "${DESTDIR}/usr/bin/authenticator"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
