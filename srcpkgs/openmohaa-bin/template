# Template file for 'openmohaa-bin'
pkgname=openmohaa-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenMoHAA [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenMoHAA-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenMoHAA-AppImage/releases/download/a2f340195%402026-10-22_1792688913/OpenMoHAA-a2f340195-anylinux-x86_64.AppImage>openmohaa-bin-${version}.AppImage"
checksum=f214ef8a2602669cf7d9d8f96eb4a73425d10a0d30e4990f3ca9dc5493b8cb43
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openmohaa-bin
	vcopy "squashfs-root/*" opt/openmohaa-bin
	chmod -R o-w "${DESTDIR}/opt/openmohaa-bin"
	vmkdir usr/bin
	ln -sf "/opt/openmohaa-bin/AppRun" "${DESTDIR}/usr/bin/openmohaa"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
