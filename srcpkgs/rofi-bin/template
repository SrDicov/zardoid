# Template file for 'rofi-bin'
pkgname=rofi-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of rofi. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/rofi-AppImage"
distfiles="https://github.com/pkgforge-dev/rofi-AppImage/releases/download/1ad1df6%402026-10-01_1790876520/rofi-1ad1df6-anylinux-x86_64.AppImage>rofi-bin-${version}.AppImage"
checksum=556e1e3b18702e42562dfce6d05434642bf85a8568828f8e43ddcb1ebb5f8e0a
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rofi-bin
	vcopy "squashfs-root/*" opt/rofi-bin
	vmkdir usr/bin
	ln -sf "/opt/rofi-bin/AppRun" "${DESTDIR}/usr/bin/rofi"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
