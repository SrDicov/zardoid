# Template file for 'kdenlive-bin'
pkgname=kdenlive-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of kdenlive which is able to work on any linux"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/kdenlive-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/kdenlive-AppImage-Enhanced/releases/download/26.08.1-1%402026-10-01_1790876508/Kdenlive-26.08.1-1-anylinux-x86_64.AppImage>kdenlive-bin-${version}.AppImage"
checksum=c4985a088fdaf57d6704430041ed17ed329d656dec579fb03b4757c797c8a440
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kdenlive-bin
	vcopy "squashfs-root/*" opt/kdenlive-bin
	vmkdir usr/bin
	ln -sf "/opt/kdenlive-bin/AppRun" "${DESTDIR}/usr/bin/kdenlive"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
