# Template file for 'pyglossary-bin'
pkgname=pyglossary-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of PyGlossary [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/PyGlossary-AppImage"
distfiles="https://github.com/pkgforge-dev/PyGlossary-AppImage/releases/download/5.2.1-1%402026-10-22_1792689386/PyGlossary-5.2.1-1-anylinux-x86_64.AppImage>pyglossary-bin-${version}.AppImage"
checksum=956ac7c256952b7517bc5481d856019726b18f07b8c212f3a85d000344d08075
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pyglossary-bin
	vcopy "squashfs-root/*" opt/pyglossary-bin
	chmod -R o-w "${DESTDIR}/opt/pyglossary-bin"
	vmkdir usr/bin
	ln -sf "/opt/pyglossary-bin/AppRun" "${DESTDIR}/usr/bin/pyglossary"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
