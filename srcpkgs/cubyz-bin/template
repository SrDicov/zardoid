# Template file for 'cubyz-bin'
pkgname=cubyz-bin
version=0.4.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Cubyz [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Cubyz-AppImage"
distfiles="https://github.com/pkgforge-dev/Cubyz-AppImage/releases/download/${version}-1%402026-10-01_1790869699/Cubyz-${version}-1-anylinux-x86_64.AppImage>cubyz-bin-${version}.AppImage"
checksum=f6937e56ad06d010578119d6e92125acf84716a62e73f772702ece370aaf7be0
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cubyz-bin
	vcopy "squashfs-root/*" opt/cubyz-bin
	vmkdir usr/bin
	ln -sf "/opt/cubyz-bin/AppRun" "${DESTDIR}/usr/bin/cubyz"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
