# Template file for 'anki-bin'
pkgname=anki-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of anki. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/anki-AppImage"
distfiles="https://github.com/pkgforge-dev/anki-AppImage/releases/download/26.09.3-1%402026-10-01_1790876613/Anki-26.09.3-1-anylinux-x86_64.AppImage>anki-bin-${version}.AppImage"
checksum=dad685787e4141557d1ab316fdd6e3495e07c73d67c877d90893b3b40f9133e0
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/anki-bin
	vcopy "squashfs-root/*" opt/anki-bin
	vmkdir usr/bin
	ln -sf "/opt/anki-bin/AppRun" "${DESTDIR}/usr/bin/anki"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
