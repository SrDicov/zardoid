# Template file for 'direnv-bin'
pkgname=direnv-bin
version=2.38.2
revision=1
archs="x86_64*"
short_desc="Unclutter your .profile"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="http://direnv.net"
distfiles="https://github.com/direnv/direnv/releases/download/v${version}/direnv.linux-amd64"
checksum=148820a187930d36ca6a204504e5cdb30d8396cd1a97e64c3b3f10d793c11247
allow_unknown_shlibs=yes
nopie=yes
noshlibprovides=yes
nostrip=yes
skip_extraction="direnv.linux-amd64"

post_extract() {
	local f='direnv.linux-amd64'
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	vbin 'direnv.linux-amd64' 'direnv'
	vlicense "${FILESDIR}/LICENSE"
}
