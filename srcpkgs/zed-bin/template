# Template file for 'zed-bin'
pkgname=zed-bin
version=1.22.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Zed [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Zed-AppImage"
distfiles="https://github.com/pkgforge-dev/Zed-AppImage/releases/download/v${version}%402026-10-01_1790869417/Zed-v${version}-anylinux-x86_64.AppImage>zed-bin-${version}.AppImage"
checksum=9384c6bc31d7e6e093eee115aef86bd3c3cd361401b199d35e414a89526d96a7
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/zed-bin
	vcopy "squashfs-root/*" opt/zed-bin
	vmkdir usr/bin
	ln -sf "/opt/zed-bin/AppRun" "${DESTDIR}/usr/bin/zed"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
