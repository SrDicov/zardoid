# Template file for 'eduke32-bin'
pkgname=eduke32-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of EDuke32 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/EDuke32-AppImage"
distfiles="https://github.com/pkgforge-dev/EDuke32-AppImage/releases/download/20260807-10669-ec5824db8%402026-10-22_1792689211/EDuke32-20260807-10669-ec5824db8-anylinux-x86_64.AppImage>eduke32-bin-${version}.AppImage"
checksum=6edc724a5d4ee7bdb9290afb81e60b41bb0f12f65058c1e1c5ce39bd9a72f4d6
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/eduke32-bin
	vcopy "squashfs-root/*" opt/eduke32-bin
	chmod -R o-w "${DESTDIR}/opt/eduke32-bin"
	vmkdir usr/bin
	ln -sf "/opt/eduke32-bin/AppRun" "${DESTDIR}/usr/bin/eduke32"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
