# Template file for 'strawberry-bin'
pkgname=strawberry-bin
version=1.2.30
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the strawberry music player"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/strawberry-AppImage"
distfiles="https://github.com/pkgforge-dev/strawberry-AppImage/releases/download/${version}-1%402026-10-01_1790876544/strawberry-${version}-1-anylinux-x86_64.AppImage>strawberry-bin-${version}.AppImage"
checksum=529254ea4a05c4780962ece1e76566b15ad48193cbdf2a0ff849ce94e9778eec
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/strawberry-bin
	vcopy "squashfs-root/*" opt/strawberry-bin
	vmkdir usr/bin
	ln -sf "/opt/strawberry-bin/AppRun" "${DESTDIR}/usr/bin/strawberry"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
