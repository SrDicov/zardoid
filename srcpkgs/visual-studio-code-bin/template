# Template file for 'visual-studio-code-bin'
pkgname=visual-studio-code-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Visual Studio Code
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Visual-Studio-Code-AppImage"
distfiles="https://github.com/pkgforge-dev/Visual-Studio-Code-AppImage/releases/download/1.143.0%402026-10-22_1792689053/Visual_Studio_Code-1.143.0-anylinux-x86_64.AppImage>visual-studio-code-bin-${version}.AppImage"
checksum=712c76b7c371b3a0fc8a529b8821af03e2e5bd2b9607636b294d520c490a237e
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/visual-studio-code-bin
	vcopy "squashfs-root/*" opt/visual-studio-code-bin
	chmod -R o-w "${DESTDIR}/opt/visual-studio-code-bin"
	vmkdir usr/bin
	ln -sf "/opt/visual-studio-code-bin/AppRun" "${DESTDIR}/usr/bin/visual-studio-code"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
