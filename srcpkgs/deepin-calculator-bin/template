# Template file for 'deepin-calculator-bin'
pkgname=deepin-calculator-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Deepin Calculator [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Deepin-Calculator-AppImage"
distfiles="https://github.com/pkgforge-dev/Deepin-Calculator-AppImage/releases/download/6.5.40-1%402026-10-22_1792689095/Deepin_Calculator-6.5.40-1-anylinux-x86_64.AppImage>deepin-calculator-bin-${version}.AppImage"
checksum=ee25ad5cfb2926ad4940e1cd95ca42764d086c922e319f53cbca88fb26299c61
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/deepin-calculator-bin
	vcopy "squashfs-root/*" opt/deepin-calculator-bin
	chmod -R o-w "${DESTDIR}/opt/deepin-calculator-bin"
	vmkdir usr/bin
	ln -sf "/opt/deepin-calculator-bin/AppRun" "${DESTDIR}/usr/bin/deepin-calculator"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
