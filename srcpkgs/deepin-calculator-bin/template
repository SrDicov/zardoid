# Template file for 'deepin-calculator-bin'
pkgname=deepin-calculator-bin
version=6.5.40
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Deepin Calculator [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Deepin-Calculator-AppImage"
distfiles="https://github.com/pkgforge-dev/Deepin-Calculator-AppImage/releases/download/${version}-1%402026-10-09_1791582986/Deepin_Calculator-${version}-1-anylinux-x86_64.AppImage>deepin-calculator-bin-${version}.AppImage"
checksum=f7607661cb3264f883e07428dfa69976f30ff3606966cce171fe6598a0b365bf
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/deepin-calculator-bin
	vcopy "squashfs-root/*" opt/deepin-calculator-bin
	vmkdir usr/bin
	ln -sf "/opt/deepin-calculator-bin/AppRun" "${DESTDIR}/usr/bin/deepin-calculator"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
