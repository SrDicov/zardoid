# Template file for 'antigravity-bin'
pkgname=antigravity-bin
version=2.21.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Antigravity [Maintainer=@mnalmahmud]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Antigravity-AppImage"
distfiles="https://github.com/pkgforge-dev/Antigravity-AppImage/releases/download/${version}%402026-10-08_1791469746/Antigravity-${version}-anylinux-x86_64.AppImage>antigravity-bin-${version}.AppImage"
checksum=29ea96b46c83ff6d495f077058cca0da92c34138f92671aa8f0884e9a2b8b39a
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/antigravity-bin
	vcopy "squashfs-root/*" opt/antigravity-bin
	vmkdir usr/bin
	ln -sf "/opt/antigravity-bin/AppRun" "${DESTDIR}/usr/bin/antigravity"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
