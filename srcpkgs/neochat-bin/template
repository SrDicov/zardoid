# Template file for 'neochat-bin'
pkgname=neochat-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of NeoChat [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/NeoChat-AppImage"
distfiles="https://github.com/pkgforge-dev/NeoChat-AppImage/releases/download/26.08.1-1%402026-10-01_1790876621/NeoChat-26.08.1-1-anylinux-x86_64.AppImage>neochat-bin-${version}.AppImage"
checksum=ab1bc1b98268801e398d99d53f7b22cc2d2ff16ed25183780590cdc8aa4bbe56
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/neochat-bin
	vcopy "squashfs-root/*" opt/neochat-bin
	vmkdir usr/bin
	ln -sf "/opt/neochat-bin/AppRun" "${DESTDIR}/usr/bin/neochat"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
