# Template file for 'maniadrive-bin'
pkgname=maniadrive-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ManiaDrive [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ManiaDrive-AppImage"
distfiles="https://github.com/pkgforge-dev/ManiaDrive-AppImage/releases/download/1.3custom%402026-09-01_1788278158/ManiaDrive-1.3custom-anylinux-x86_64.AppImage>maniadrive-bin-${version}.AppImage"
checksum=f5e1ebfffabbf88b50bf0aadb847170fcb778ce9e2b94b764dbf02608a3fdbfd
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/maniadrive-bin
	vcopy "squashfs-root/*" opt/maniadrive-bin
	vmkdir usr/bin
	ln -sf "/opt/maniadrive-bin/AppRun" "${DESTDIR}/usr/bin/maniadrive"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
