# Template file for 'openmsx-bin'
pkgname=openmsx-bin
version=21.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of openMSX [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/openMSX-AppImage"
distfiles="https://github.com/pkgforge-dev/openMSX-AppImage/releases/download/${version}%402026-09-01_1788277621/openMSX-${version}-anylinux-x86_64.AppImage>openmsx-bin-${version}.AppImage"
checksum=fa02f70c0f1c455ba1ee7cfab243dda9112ae8c46f33fa146b0a8df3b6059c36
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openmsx-bin
	vcopy "squashfs-root/*" opt/openmsx-bin
	vmkdir usr/bin
	ln -sf "/opt/openmsx-bin/AppRun" "${DESTDIR}/usr/bin/openmsx"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
