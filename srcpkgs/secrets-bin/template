# Template file for 'secrets-bin'
pkgname=secrets-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Secrets keepass and 2FA password manager"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Secrets-AppImage"
distfiles="https://github.com/pkgforge-dev/Secrets-AppImage/releases/download/13.0.1-1%402026-10-01_1790876410/Secrets-13.0.1-1-anylinux-x86_64.AppImage>secrets-bin-${version}.AppImage"
checksum=6621fb25d6c2f39df876af208f2ac826b4a4e69b6503e01960ba2422e9520ee0
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/secrets-bin
	vcopy "squashfs-root/*" opt/secrets-bin
	vmkdir usr/bin
	ln -sf "/opt/secrets-bin/AppRun" "${DESTDIR}/usr/bin/secrets"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
