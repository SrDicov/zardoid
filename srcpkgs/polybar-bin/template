# Template file for 'polybar-bin'
pkgname=polybar-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Polybar [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/Polybar-AppImage"
distfiles="https://github.com/pkgforge-dev/Polybar-AppImage/releases/download/3.7.2.r29.gf99e0b1c-1%402026-09-01_1788231711/polybar-3.7.2.r29.gf99e0b1c-1-anylinux-x86_64.AppImage>polybar-bin-${version}.AppImage"
checksum=4c7b4f26b7c2e237314dc6e648201f7f77c8d8de3a551f7efa7fe92b8cea097d
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/polybar-bin
	vcopy "squashfs-root/*" opt/polybar-bin
	vmkdir usr/bin
	ln -sf "/opt/polybar-bin/AppRun" "${DESTDIR}/usr/bin/polybar"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
