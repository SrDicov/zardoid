# Template file for 'omikuji-bin'
pkgname=omikuji-bin
version=0.20.6
revision=1
archs="x86_64"
short_desc="QtQuick based game launcher for Linux"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://omikuji-launcher.github.io/omikuji/"
distfiles="https://github.com/omikuji-launcher/omikuji/releases/download/v${version}/Omikuji-v${version}-anylinux-x86_64.AppImage>omikuji-bin-${version}.AppImage"
checksum=cc26dbea96a9cc6e73e8fe400ef5ef35f24cbf7cfa2cda892f0a3147cf1b230d
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/omikuji-bin
	vcopy "squashfs-root/*" opt/omikuji-bin
	vmkdir usr/bin
	ln -sf "/opt/omikuji-bin/AppRun" "${DESTDIR}/usr/bin/omikuji"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
