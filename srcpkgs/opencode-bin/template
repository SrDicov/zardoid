# Template file for 'opencode-bin'
pkgname=opencode-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of opencode CLI [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/opencode-cli-AppImage"
distfiles="https://github.com/pkgforge-dev/opencode-cli-AppImage/releases/download/v1.19.4%402026-10-22_1792688890/opencode-v1.19.4-anylinux-x86_64.AppImage>opencode-bin-${version}.AppImage"
checksum=7d35da1f9f3f0ce2afdb9d93b002cbc5c6529c3c13848fe1fc5d59a6107c3767
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/opencode-bin
	vcopy "squashfs-root/*" opt/opencode-bin
	chmod -R o-w "${DESTDIR}/opt/opencode-bin"
	vmkdir usr/bin
	ln -sf "/opt/opencode-bin/AppRun" "${DESTDIR}/usr/bin/opencode"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
