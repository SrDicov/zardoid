# Template file for 'simitone-bin'
pkgname=simitone-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Simitone [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Simitone-AppImage"
distfiles="https://github.com/pkgforge-dev/Simitone-AppImage/releases/download/0.8.22-forked%402026-10-22_1792681265/Simitone-0.8.22-forked-anylinux-x86_64.AppImage>simitone-bin-${version}.AppImage"
checksum=b915b60c65a50536d253279aa116487a13dc1e75d62996a8758a8dd29cf49bd6
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/simitone-bin
	vcopy "squashfs-root/*" opt/simitone-bin
	chmod -R o-w "${DESTDIR}/opt/simitone-bin"
	vmkdir usr/bin
	ln -sf "/opt/simitone-bin/AppRun" "${DESTDIR}/usr/bin/simitone"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
