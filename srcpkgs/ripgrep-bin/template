do_install() {
	vbin 'rg'
	vman 'doc/rg.1'
	vinstall 'complete/rg.bash' 644 usr/share/bash-completion/completions 'rg'
	vinstall 'complete/_rg' 644 usr/share/zsh/site-functions
	vinstall 'complete/rg.fish' 644 usr/share/fish/vendor_completions.d
}
