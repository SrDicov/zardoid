# Template file for 'ripgrep-bin'
pkgname=ripgrep-bin
version=15.2.0
revision=1
archs="x86_64*"
short_desc="Ripgrep recursively searches directories for a regex pattern while"
maintainer="SrDicov <SrDicov@gmail.com>"
license="Unlicense"
homepage="https://github.com/BurntSushi/ripgrep"
distfiles="https://github.com/BurntSushi/ripgrep/releases/download/${version}/ripgrep-${version}-x86_64-unknown-linux-musl.tar.gz"
