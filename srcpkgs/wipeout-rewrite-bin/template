# Template file for 'wipeout-rewrite-bin'
pkgname=wipeout-rewrite-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of wipEout Rewrite
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/wipEout-Rewrite-AppImage"
distfiles="https://github.com/pkgforge-dev/wipEout-Rewrite-AppImage/releases/download/b425ecb3b%402026-10-22_1792688994/wipEout_Rewrite-b425ecb3b-anylinux-x86_64.AppImage>wipeout-rewrite-bin-${version}.AppImage"
checksum=a455887304ba558ef31f0e01fc080ba1f467a7c7a4a560371c696fa00a90e1ea
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/wipeout-rewrite-bin
	vcopy "squashfs-root/*" opt/wipeout-rewrite-bin
	chmod -R o-w "${DESTDIR}/opt/wipeout-rewrite-bin"
	vmkdir usr/bin
	ln -sf "/opt/wipeout-rewrite-bin/AppRun" "${DESTDIR}/usr/bin/wipeout-rewrite"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
