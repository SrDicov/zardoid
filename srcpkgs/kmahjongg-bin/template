# Template file for 'kmahjongg-bin'
pkgname=kmahjongg-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KMahjongg [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KMahjongg-AppImage"
distfiles="https://github.com/pkgforge-dev/KMahjongg-AppImage/releases/download/26.08.2-1%402026-10-22_1792688896/KMahjongg-26.08.2-1-anylinux-x86_64.AppImage>kmahjongg-bin-${version}.AppImage"
checksum=db3903416f1fe6d4ea36d6ac37e2ca95c5b3628a4e5e80251f78a8b09daffc51
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kmahjongg-bin
	vcopy "squashfs-root/*" opt/kmahjongg-bin
	chmod -R o-w "${DESTDIR}/opt/kmahjongg-bin"
	vmkdir usr/bin
	ln -sf "/opt/kmahjongg-bin/AppRun" "${DESTDIR}/usr/bin/kmahjongg"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
