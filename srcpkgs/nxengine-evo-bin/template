# Template file for 'nxengine-evo-bin'
pkgname=nxengine-evo-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of NXEngine-evo [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/NXEngine-evo-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/NXEngine-evo-AppImage-Enhanced/releases/download/1f093d142%402026-10-01_1790875292/Cave_Story_NX-evo-1f093d142-anylinux-x86_64.AppImage>nxengine-evo-bin-${version}.AppImage"
checksum=b651d4d051dc178b883104831a700a936fc94f73633aac41634c2f08f142152b
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/nxengine-evo-bin
	vcopy "squashfs-root/*" opt/nxengine-evo-bin
	vmkdir usr/bin
	ln -sf "/opt/nxengine-evo-bin/AppRun" "${DESTDIR}/usr/bin/nxengine-evo"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
