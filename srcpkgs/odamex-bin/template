# Template file for 'odamex-bin'
pkgname=odamex-bin
version=12.3.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Odamex [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Odamex-AppImage"
distfiles="https://github.com/pkgforge-dev/Odamex-AppImage/releases/download/${version}%402026-10-13_1791903678/Odamex-${version}-anylinux-x86_64.AppImage>odamex-bin-${version}.AppImage"
checksum=709e88fa1106cfe9f55e0c6f2094a595093d29e912e0f683b91aad7d36580b74
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/odamex-bin
	vcopy "squashfs-root/*" opt/odamex-bin
	vmkdir usr/bin
	ln -sf "/opt/odamex-bin/AppRun" "${DESTDIR}/usr/bin/odamex"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
