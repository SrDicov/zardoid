# Template file for 'odamex-bin'
pkgname=odamex-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Odamex [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Odamex-AppImage"
distfiles="https://github.com/pkgforge-dev/Odamex-AppImage/releases/download/12.3.0%402026-10-22_1792689410/Odamex-12.3.0-anylinux-x86_64.AppImage>odamex-bin-${version}.AppImage"
checksum=45d214555386fbfa776ca19d7f98b95dd9d30c971100d4f830aa5d8fc928662c
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/odamex-bin
	vcopy "squashfs-root/*" opt/odamex-bin
	chmod -R o-w "${DESTDIR}/opt/odamex-bin"
	vmkdir usr/bin
	ln -sf "/opt/odamex-bin/AppRun" "${DESTDIR}/usr/bin/odamex"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
