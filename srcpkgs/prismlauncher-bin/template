# Template file for 'prismlauncher-bin'
pkgname=prismlauncher-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Prism Launcher
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/PrismLauncher-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/PrismLauncher-AppImage-Enhanced/releases/download/11.1.1-1%402026-10-22_1792688998/Prism_Launcher-11.1.1-1-anylinux-x86_64.AppImage>prismlauncher-bin-${version}.AppImage"
checksum=f0ede4ec915af41d0c02160542cfb6e1484f4bc1a9c372b96d85f3b94cc49708
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/prismlauncher-bin
	vcopy "squashfs-root/*" opt/prismlauncher-bin
	chmod -R o-w "${DESTDIR}/opt/prismlauncher-bin"
	vmkdir usr/bin
	ln -sf "/opt/prismlauncher-bin/AppRun" "${DESTDIR}/usr/bin/prismlauncher"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
