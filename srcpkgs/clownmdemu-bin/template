# Template file for 'clownmdemu-bin'
pkgname=clownmdemu-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ClownMDEmu [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ClownMDEmu-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/ClownMDEmu-AppImage-Enhanced/releases/download/1.6.12%402026-10-22_1792688666/ClownMDEmu-1.6.12-anylinux-x86_64.AppImage>clownmdemu-bin-${version}.AppImage"
checksum=ff59017c70f29ed499af998e2d03d495d7ccb48fceb046a1cfbfd4313239c6be
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/clownmdemu-bin
	vcopy "squashfs-root/*" opt/clownmdemu-bin
	chmod -R o-w "${DESTDIR}/opt/clownmdemu-bin"
	vmkdir usr/bin
	ln -sf "/opt/clownmdemu-bin/AppRun" "${DESTDIR}/usr/bin/clownmdemu"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
