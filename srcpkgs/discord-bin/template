# Template file for 'discord-bin'
pkgname=discord-bin
version=1.0.160
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Discord. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Discord-AppImage"
distfiles="https://github.com/pkgforge-dev/Discord-AppImage/releases/download/${version}-1%402026-10-01_1790876581/Discord-${version}-1-anylinux-x86_64.AppImage>discord-bin-${version}.AppImage"
checksum=475591ccfba6618a8f837e042e097527fe01407bddba48c17d453a614583a7df
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/discord-bin
	vcopy "squashfs-root/*" opt/discord-bin
	vmkdir usr/bin
	ln -sf "/opt/discord-bin/AppRun" "${DESTDIR}/usr/bin/discord"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
