# Template file for 'audacious-bin'
pkgname=audacious-bin
version=4.6.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Audacious [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Audacious-AppImage"
distfiles="https://github.com/pkgforge-dev/Audacious-AppImage/releases/download/${version}-2%402026-10-01_1790876692/Audacious-${version}-2-anylinux-x86_64.AppImage>audacious-bin-${version}.AppImage"
checksum=eb930ba8ab1c2c8c9bea65ffd36707efbcd957a7159cc479240ddf82a39904a9
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/audacious-bin
	vcopy "squashfs-root/*" opt/audacious-bin
	vmkdir usr/bin
	ln -sf "/opt/audacious-bin/AppRun" "${DESTDIR}/usr/bin/audacious"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
