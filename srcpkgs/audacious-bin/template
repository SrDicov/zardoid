# Template file for 'audacious-bin'
pkgname=audacious-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Audacious [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Audacious-AppImage"
distfiles="https://github.com/pkgforge-dev/Audacious-AppImage/releases/download/4.6.2-1%402026-10-22_1792689366/Audacious-4.6.2-1-anylinux-x86_64.AppImage>audacious-bin-${version}.AppImage"
checksum=e40c85298a817287490a16acd1e83d634a5dad4efc755f64beb7a68a4d5b955d
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/audacious-bin
	vcopy "squashfs-root/*" opt/audacious-bin
	chmod -R o-w "${DESTDIR}/opt/audacious-bin"
	vmkdir usr/bin
	ln -sf "/opt/audacious-bin/AppRun" "${DESTDIR}/usr/bin/audacious"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
