# Template file for 'collision-bin'
pkgname=collision-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Collision file hash comparator
 application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Collision-AppImage"
distfiles="https://github.com/pkgforge-dev/Collision-AppImage/releases/download/3.14.1-1%402026-10-22_1792689210/Collision-3.14.1-1-anylinux-x86_64.AppImage>collision-bin-${version}.AppImage"
checksum=f45df587b4023f32be61e4d3c564bd2f9936b4dde1d572cb7772291838c45b16
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/collision-bin
	vcopy "squashfs-root/*" opt/collision-bin
	chmod -R o-w "${DESTDIR}/opt/collision-bin"
	vmkdir usr/bin
	ln -sf "/opt/collision-bin/AppRun" "${DESTDIR}/usr/bin/collision"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
