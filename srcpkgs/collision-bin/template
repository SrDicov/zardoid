# Template file for 'collision-bin'
pkgname=collision-bin
version=3.14.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Collision file hash comparator
 application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Collision-AppImage"
distfiles="https://github.com/pkgforge-dev/Collision-AppImage/releases/download/${version}-1%402026-10-01_1790876644/Collision-${version}-1-anylinux-x86_64.AppImage>collision-bin-${version}.AppImage"
checksum=a6aec36e426ce6c1faa923aca47740547d605814e8612a11b7e755b83b87dec5
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/collision-bin
	vcopy "squashfs-root/*" opt/collision-bin
	vmkdir usr/bin
	ln -sf "/opt/collision-bin/AppRun" "${DESTDIR}/usr/bin/collision"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
