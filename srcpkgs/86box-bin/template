# Template file for '86box-bin'
pkgname=86box-bin
version=6.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of 86box [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/86box-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/86box-AppImage-Enhanced/releases/download/${version}%402026-10-12_1791805425/86Box-${version}-anylinux-x86_64.AppImage>86box-bin-${version}.AppImage"
checksum=0bd6c89f96cb979b04266bc69242f55c691f94cec30ee51b52c653f86a539734
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/86box-bin
	vcopy "squashfs-root/*" opt/86box-bin
	vmkdir usr/bin
	ln -sf "/opt/86box-bin/AppRun" "${DESTDIR}/usr/bin/86box"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
