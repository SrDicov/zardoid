# Template file for 'luanti-bin'
pkgname=luanti-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Luanti (Minetest) [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Luanti-AppImage"
distfiles="https://github.com/pkgforge-dev/Luanti-AppImage/releases/download/5.17.0-2%402026-10-22_1792688980/Luanti-5.17.0-2-anylinux-x86_64.AppImage>luanti-bin-${version}.AppImage"
checksum=a87face5608ef3ddf178ddfc7fe582a3df4a47714dce5d9ccf76b48402840de7
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/luanti-bin
	vcopy "squashfs-root/*" opt/luanti-bin
	chmod -R o-w "${DESTDIR}/opt/luanti-bin"
	vmkdir usr/bin
	ln -sf "/opt/luanti-bin/AppRun" "${DESTDIR}/usr/bin/luanti"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
