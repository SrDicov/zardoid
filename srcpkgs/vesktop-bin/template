# Template file for 'vesktop-bin'
pkgname=vesktop-bin
version=1.6.7
revision=1
short_desc="Vesktop is a custom Discord App aiming to give you better
 performance"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://vesktop.dev"
distfiles="https://github.com/Vencord/Vesktop/releases/download/v${version}/Vesktop-${version}.AppImage>vesktop-bin-${version}.AppImage"
checksum=855632b68bbaa724d76e9f3d9deab0410111f5d95b79da3cf024ceb54f4e6d81
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/vesktop-bin
	vcopy "squashfs-root/*" opt/vesktop-bin
	vmkdir usr/bin
	ln -sf "/opt/vesktop-bin/AppRun" "${DESTDIR}/usr/bin/vesktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
