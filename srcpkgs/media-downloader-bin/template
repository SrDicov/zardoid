# Template file for 'media-downloader-bin'
pkgname=media-downloader-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Media Downloader [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Media-Downloader-AppImage"
distfiles="https://github.com/pkgforge-dev/Media-Downloader-AppImage/releases/download/5.6.6%402026-10-22_1792687030/Media_Downloader-5.6.6-anylinux-x86_64.AppImage>media-downloader-bin-${version}.AppImage"
checksum=372c64ecbaed4b5ee2df074e5e258bcbcd9036928e6e11e3a6f8c91cf729e480
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/media-downloader-bin
	vcopy "squashfs-root/*" opt/media-downloader-bin
	chmod -R o-w "${DESTDIR}/opt/media-downloader-bin"
	vmkdir usr/bin
	ln -sf "/opt/media-downloader-bin/AppRun" "${DESTDIR}/usr/bin/media-downloader"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
