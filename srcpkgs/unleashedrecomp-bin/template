# Template file for 'unleashedrecomp-bin'
pkgname=unleashedrecomp-bin
version=1.0.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of UnleashedRecomp [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/UnleashedRecomp-AppImage"
distfiles="https://github.com/pkgforge-dev/UnleashedRecomp-AppImage/releases/download/v${version}%402026-09-01_1788264761/Unleashed_Recompiled-v${version}-anylinux-x86_64.AppImage>unleashedrecomp-bin-${version}.AppImage"
checksum=873140eb8d0404e7bfc8395e5841fd2a1f5c501b621dae1c6df963b6c3cfa667
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/unleashedrecomp-bin
	vcopy "squashfs-root/*" opt/unleashedrecomp-bin
	vmkdir usr/bin
	ln -sf "/opt/unleashedrecomp-bin/AppRun" "${DESTDIR}/usr/bin/unleashedrecomp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
