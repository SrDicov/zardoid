# Template file for 'nugget-doom-bin'
pkgname=nugget-doom-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Nugget Doom [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Nugget-Doom-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Nugget-Doom-AppImage-Enhanced/releases/download/6.1.0%402026-10-22_1792689393/Nugget_Doom-6.1.0-anylinux-x86_64.AppImage>nugget-doom-bin-${version}.AppImage"
checksum=d97b3d62772600ce24de712cf954a631c4f70d1ce3c6719e8c6448cb8efa0017
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/nugget-doom-bin
	vcopy "squashfs-root/*" opt/nugget-doom-bin
	chmod -R o-w "${DESTDIR}/opt/nugget-doom-bin"
	vmkdir usr/bin
	ln -sf "/opt/nugget-doom-bin/AppRun" "${DESTDIR}/usr/bin/nugget-doom"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
