# Template file for 'stella-bin'
pkgname=stella-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Stella [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Stella-AppImage"
distfiles="https://github.com/pkgforge-dev/Stella-AppImage/releases/download/7.0-1%402026-10-22_1792689228/Stella-7.0-1-anylinux-x86_64.AppImage>stella-bin-${version}.AppImage"
checksum=236cda939f7555b571f16e199f356fb820a9cb3929729a540b565002f5b7c2d0
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/stella-bin
	vcopy "squashfs-root/*" opt/stella-bin
	chmod -R o-w "${DESTDIR}/opt/stella-bin"
	vmkdir usr/bin
	ln -sf "/opt/stella-bin/AppRun" "${DESTDIR}/usr/bin/stella"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
