# Template file for 'eyedropper-bin'
pkgname=eyedropper-bin
version=2.2.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Eyedropper color picker application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Eyedropper-AppImage"
distfiles="https://github.com/pkgforge-dev/Eyedropper-AppImage/releases/download/${version}-1%402026-10-01_1790875954/Eyedropper-${version}-1-anylinux-x86_64.AppImage>eyedropper-bin-${version}.AppImage"
checksum=e9844a0d9a20c49b3a2dc4e7b512b423f575c1a914716cf7ee218afb9b82b607
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/eyedropper-bin
	vcopy "squashfs-root/*" opt/eyedropper-bin
	vmkdir usr/bin
	ln -sf "/opt/eyedropper-bin/AppRun" "${DESTDIR}/usr/bin/eyedropper"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
