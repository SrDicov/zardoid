# Template file for 'bmherorecomp-bin'
pkgname=bmherorecomp-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Bomberman Hero Recompiled"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/BMHeroRecomp-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/BMHeroRecomp-AppImage-Enhanced/releases/download/0.7.1%402026-10-22_1792686865/BMHeroRecompiled-0.7.1-anylinux-x86_64.AppImage>bmherorecomp-bin-${version}.AppImage"
checksum=f07490411717886cdd3e7c863c3f7c56903a2049b5c7e07cdb5792db879f32b0
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/bmherorecomp-bin
	vcopy "squashfs-root/*" opt/bmherorecomp-bin
	chmod -R o-w "${DESTDIR}/opt/bmherorecomp-bin"
	vmkdir usr/bin
	ln -sf "/opt/bmherorecomp-bin/AppRun" "${DESTDIR}/usr/bin/bmherorecomp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
