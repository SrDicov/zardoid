# Template file for 'bmherorecomp-bin'
pkgname=bmherorecomp-bin
version=0.7.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Bomberman Hero Recompiled"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/BMHeroRecomp-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/BMHeroRecomp-AppImage-Enhanced/releases/download/${version}%402026-10-01_1790875380/BMHeroRecompiled-${version}-anylinux-x86_64.AppImage>bmherorecomp-bin-${version}.AppImage"
checksum=3026b2ee7d47344b4e63bfb12096a78bc1fc67b4c0edf0462d02ca4122651caa
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/bmherorecomp-bin
	vcopy "squashfs-root/*" opt/bmherorecomp-bin
	vmkdir usr/bin
	ln -sf "/opt/bmherorecomp-bin/AppRun" "${DESTDIR}/usr/bin/bmherorecomp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
