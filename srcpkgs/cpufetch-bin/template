# Template file for 'cpufetch-bin'
pkgname=cpufetch-bin
version=1.07
revision=1
archs="x86_64*"
short_desc="Simple yet fancy CPU architecture fetching tool"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/Dr-Noob/cpufetch"
distfiles="https://github.com/Dr-Noob/cpufetch/releases/download/v${version}/cpufetch_x86-64_linux"
