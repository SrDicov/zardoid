nopie=yes
noshlibprovides=yes
nostrip=yes
skip_extraction="cpufetch_x86-64_linux"

post_extract() {
	local f='cpufetch_x86-64_linux'
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	vbin 'cpufetch_x86-64_linux' 'cpufetch'
}
