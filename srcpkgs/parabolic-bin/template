# Template file for 'parabolic-bin'
pkgname=parabolic-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Parabolic [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Parabolic-AppImage"
distfiles="https://github.com/pkgforge-dev/Parabolic-AppImage/releases/download/2026.5.0%402026-10-01_1790876128/Parabolic-2026.5.0-anylinux-x86_64.AppImage>parabolic-bin-${version}.AppImage"
checksum=af2a148a2964464f62c135cda98e3044a98863a7b4292c536b6b095e4065bed4
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/parabolic-bin
	vcopy "squashfs-root/*" opt/parabolic-bin
	vmkdir usr/bin
	ln -sf "/opt/parabolic-bin/AppRun" "${DESTDIR}/usr/bin/parabolic"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
