# Template file for 'rigs-of-rods-bin'
pkgname=rigs-of-rods-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Rigs of Rods [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Rigs-of-Rods-AppImage"
distfiles="https://github.com/pkgforge-dev/Rigs-of-Rods-AppImage/releases/download/2026.01%402026-10-22_1792689422/RoR-2026.01-anylinux-x86_64.AppImage>rigs-of-rods-bin-${version}.AppImage"
checksum=88e3d58d69794933c2bdf0eb944d39ab0c4979a5e71cecf66820051883d83a39
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rigs-of-rods-bin
	vcopy "squashfs-root/*" opt/rigs-of-rods-bin
	chmod -R o-w "${DESTDIR}/opt/rigs-of-rods-bin"
	vmkdir usr/bin
	ln -sf "/opt/rigs-of-rods-bin/AppRun" "${DESTDIR}/usr/bin/rigs-of-rods"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
