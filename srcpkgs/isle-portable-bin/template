# Template file for 'isle-portable-bin'
pkgname=isle-portable-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of isle-portable [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/isle-portable-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/isle-portable-AppImage-Enhanced/releases/download/587eabf79%402026-10-01_1790876186/Isle_Portable-587eabf79-anylinux-x86_64.AppImage>isle-portable-bin-${version}.AppImage"
checksum=42c033195a38653d977336b1be12e61a10687f53a370acb2bae99d33774e9f0f
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/isle-portable-bin
	vcopy "squashfs-root/*" opt/isle-portable-bin
	vmkdir usr/bin
	ln -sf "/opt/isle-portable-bin/AppRun" "${DESTDIR}/usr/bin/isle-portable"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
