# Template file for 'orcaslicer-bin'
pkgname=orcaslicer-bin
version=2.4.2
revision=1
archs="x86_64"
short_desc="Improved AppImage of OrcaSlicer which is able to work on any linux"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OrcaSlicer-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/OrcaSlicer-AppImage-Enhanced/releases/download/${version}-2%402026-10-01_1790878855/OrcaSlicer-${version}-2-anylinux-x86_64.AppImage>orcaslicer-bin-${version}.AppImage"
checksum=9a23c6fafe8eaffd608c7b6759973129afbdc082b22db9974617b43c2afc4a7d
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/orcaslicer-bin
	vcopy "squashfs-root/*" opt/orcaslicer-bin
	vmkdir usr/bin
	ln -sf "/opt/orcaslicer-bin/AppRun" "${DESTDIR}/usr/bin/orcaslicer"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
