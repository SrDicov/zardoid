# Template file for 'keepassxc-bin'
pkgname=keepassxc-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KeePassXC that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KeePassXC-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/KeePassXC-AppImage-Enhanced/releases/download/2.7.12-5%402026-10-22_1792689086/KeePassXC-2.7.12-5-anylinux-x86_64.AppImage>keepassxc-bin-${version}.AppImage"
checksum=6b94bdaf6929d17b7d5de62f881b15e619a5ae0b8e76181ad8a4d69ef1dafe89
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/keepassxc-bin
	vcopy "squashfs-root/*" opt/keepassxc-bin
	chmod -R o-w "${DESTDIR}/opt/keepassxc-bin"
	vmkdir usr/bin
	ln -sf "/opt/keepassxc-bin/AppRun" "${DESTDIR}/usr/bin/keepassxc"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
