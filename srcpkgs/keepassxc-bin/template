# Template file for 'keepassxc-bin'
pkgname=keepassxc-bin
version=2.7.12
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KeePassXC that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KeePassXC-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/KeePassXC-AppImage-Enhanced/releases/download/${version}-5%402026-10-01_1790876467/KeePassXC-${version}-5-anylinux-x86_64.AppImage>keepassxc-bin-${version}.AppImage"
checksum=7ad99387710bdc6d15a474d46e8309dd33abf4b78cedb3871a4e265181b30eeb
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/keepassxc-bin
	vcopy "squashfs-root/*" opt/keepassxc-bin
	vmkdir usr/bin
	ln -sf "/opt/keepassxc-bin/AppRun" "${DESTDIR}/usr/bin/keepassxc"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
