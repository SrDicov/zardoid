# Template file for 'gcstar-bin'
pkgname=gcstar-bin
version=1.8.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of GCstar [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/GCstar-AppImage"
distfiles="https://github.com/pkgforge-dev/GCstar-AppImage/releases/download/${version}-3%402026-10-01_1790876371/GCstar-${version}-3-anylinux-x86_64.AppImage>gcstar-bin-${version}.AppImage"
checksum=b7df8ea2f2c1103f73b9b94cdd0abc8e292867fb885b842dab5d43f4aa9a93d0
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gcstar-bin
	vcopy "squashfs-root/*" opt/gcstar-bin
	vmkdir usr/bin
	ln -sf "/opt/gcstar-bin/AppRun" "${DESTDIR}/usr/bin/gcstar"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
