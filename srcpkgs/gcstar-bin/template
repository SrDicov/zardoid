# Template file for 'gcstar-bin'
pkgname=gcstar-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of GCstar [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/GCstar-AppImage"
distfiles="https://github.com/pkgforge-dev/GCstar-AppImage/releases/download/1.8.0-3%402026-10-22_1792684862/GCstar-1.8.0-3-anylinux-x86_64.AppImage>gcstar-bin-${version}.AppImage"
checksum=82f37a706584e772a8637fb073f2f9c70834df1df70015617647d88ef9268366
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gcstar-bin
	vcopy "squashfs-root/*" opt/gcstar-bin
	chmod -R o-w "${DESTDIR}/opt/gcstar-bin"
	vmkdir usr/bin
	ln -sf "/opt/gcstar-bin/AppRun" "${DESTDIR}/usr/bin/gcstar"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
