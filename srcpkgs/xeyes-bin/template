# Template file for 'xeyes-bin'
pkgname=xeyes-bin
version=1.3.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of xeyes [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/xeyes-AppImage"
distfiles="https://github.com/pkgforge-dev/xeyes-AppImage/releases/download/${version}-1%402026-09-01_1788277573/Xeyes-${version}-1-anylinux-x86_64.AppImage>xeyes-bin-${version}.AppImage"
checksum=28aedb214dc06624256d22d2a4408d967ee78b550751dac7dbbf7ff8fc103007
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/xeyes-bin
	vcopy "squashfs-root/*" opt/xeyes-bin
	vmkdir usr/bin
	ln -sf "/opt/xeyes-bin/AppRun" "${DESTDIR}/usr/bin/xeyes"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
