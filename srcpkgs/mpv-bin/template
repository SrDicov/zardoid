# Template file for 'mpv-bin'
pkgname=mpv-bin
version=20261024
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of mpv [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/mpv-AppImage"
distfiles="https://github.com/pkgforge-dev/mpv-AppImage/releases/download/v0.41.0%402026-10-24_1792872329/mpv-v0.41.0-anylinux-x86_64.AppImage>mpv-bin-${version}.AppImage"
checksum=79264656f971c86aa46587bc2cd175e07fe9cb8155dc1d7445f80b773ef101d3
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/mpv-bin
	vcopy "squashfs-root/*" opt/mpv-bin
	chmod -R o-w "${DESTDIR}/opt/mpv-bin"
	vmkdir usr/bin
	ln -sf "/opt/mpv-bin/AppRun" "${DESTDIR}/usr/bin/mpv"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
