# Template file for 'taisei-project-bin'
pkgname=taisei-project-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Taisei-Project
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Taisei-Project-AppImage"
distfiles="https://github.com/pkgforge-dev/Taisei-Project-AppImage/releases/download/1.4.6%402026-10-22_1792673550/Taisei-1.4.6-anylinux-x86_64.AppImage>taisei-project-bin-${version}.AppImage"
checksum=57d23988ef2d91fda2545a1b271496ae3a08989deda88f8665ee75d0cb68af14
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/taisei-project-bin
	vcopy "squashfs-root/*" opt/taisei-project-bin
	chmod -R o-w "${DESTDIR}/opt/taisei-project-bin"
	vmkdir usr/bin
	ln -sf "/opt/taisei-project-bin/AppRun" "${DESTDIR}/usr/bin/taisei-project"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
