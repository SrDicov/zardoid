# Template file for 'ktouch-bin'
pkgname=ktouch-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KTouch [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KTouch-AppImage"
distfiles="https://github.com/pkgforge-dev/KTouch-AppImage/releases/download/26.08.1-1%402026-10-01_1790876407/KTouch-26.08.1-1-anylinux-x86_64.AppImage>ktouch-bin-${version}.AppImage"
checksum=b43acc6e733ec848292fc865c501445d31c3511be0a5ef6ab14318a619e047f6
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ktouch-bin
	vcopy "squashfs-root/*" opt/ktouch-bin
	vmkdir usr/bin
	ln -sf "/opt/ktouch-bin/AppRun" "${DESTDIR}/usr/bin/ktouch"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
