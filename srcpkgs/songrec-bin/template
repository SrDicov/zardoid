# Template file for 'songrec-bin'
pkgname=songrec-bin
version=0.7.5
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of SongRec [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SongRec-AppImage"
distfiles="https://github.com/pkgforge-dev/SongRec-AppImage/releases/download/${version}-1%402026-09-22_1790090225/SongRec-${version}-1-anylinux-x86_64.AppImage>songrec-bin-${version}.AppImage"
checksum=af64482a27e840c37b53fa106fc59d984f222e10aab081e2487e70ec18d3177c
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/songrec-bin
	vcopy "squashfs-root/*" opt/songrec-bin
	vmkdir usr/bin
	ln -sf "/opt/songrec-bin/AppRun" "${DESTDIR}/usr/bin/songrec"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
