# Template file for 'firefox-bin'
pkgname=firefox-bin
version=20261023
revision=1
archs="x86_64"
short_desc="Unofficial Anylinux AppImage of Firefox [Maintainer=@ArqamQazi]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Firefox-AppImage"
distfiles="https://github.com/pkgforge-dev/Firefox-AppImage/releases/download/158.0.1%402026-10-23_1792758956/Firefox-158.0.1-anylinux-x86_64.AppImage>firefox-bin-${version}.AppImage"
checksum=70ffad0d557dd6f2c805601fa398880620e65cee51549546e5dc16cd305c9f27
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/firefox-bin
	vcopy "squashfs-root/*" opt/firefox-bin
	chmod -R o-w "${DESTDIR}/opt/firefox-bin"
	vmkdir usr/bin
	ln -sf "/opt/firefox-bin/AppRun" "${DESTDIR}/usr/bin/firefox"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
