# Template file for 'shotwell-bin'
pkgname=shotwell-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Shotwell [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Shotwell-AppImage"
distfiles="https://github.com/pkgforge-dev/Shotwell-AppImage/releases/download/33.0-2%402026-10-22_1792688678/Shotwell-33.0-2-anylinux-x86_64.AppImage>shotwell-bin-${version}.AppImage"
checksum=20035afb04bf85b3372d191506e8a1beb97e051e9dc70f91b38f15fe7c3a61f8
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/shotwell-bin
	vcopy "squashfs-root/*" opt/shotwell-bin
	chmod -R o-w "${DESTDIR}/opt/shotwell-bin"
	vmkdir usr/bin
	ln -sf "/opt/shotwell-bin/AppRun" "${DESTDIR}/usr/bin/shotwell"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
