# Template file for 'shotwell-bin'
pkgname=shotwell-bin
version=0.32.17
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Shotwell [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Shotwell-AppImage"
distfiles="https://github.com/pkgforge-dev/Shotwell-AppImage/releases/download/${version}-1%402026-10-01_1790876224/Shotwell-${version}-1-anylinux-x86_64.AppImage>shotwell-bin-${version}.AppImage"
checksum=b4360b7205181ad5e1e956ff0ca1e44fbbfe5b16ec7aa442b8a2d14b4ccd8a4d
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/shotwell-bin
	vcopy "squashfs-root/*" opt/shotwell-bin
	vmkdir usr/bin
	ln -sf "/opt/shotwell-bin/AppRun" "${DESTDIR}/usr/bin/shotwell"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
