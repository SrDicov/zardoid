# Template file for 'nsz-bin'
pkgname=nsz-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the NSZ utility, GUI included"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/NSZ-AppImage"
distfiles="https://github.com/pkgforge-dev/NSZ-AppImage/releases/download/5.0.0-2%402026-10-22_1792688687/NSZ-5.0.0-2-anylinux-x86_64.AppImage>nsz-bin-${version}.AppImage"
checksum=40e444b1572f09ac583ffab806ef6050d6de4b24a2bb66d76519637d59c81e1e
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/nsz-bin
	vcopy "squashfs-root/*" opt/nsz-bin
	chmod -R o-w "${DESTDIR}/opt/nsz-bin"
	vmkdir usr/bin
	ln -sf "/opt/nsz-bin/AppRun" "${DESTDIR}/usr/bin/nsz"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
