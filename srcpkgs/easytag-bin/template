# Template file for 'easytag-bin'
pkgname=easytag-bin
version=2.4.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of EasyTAG [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/EasyTAG-AppImage"
distfiles="https://github.com/pkgforge-dev/EasyTAG-AppImage/releases/download/${version}-17%402026-10-01_1790875591/EasyTAG-${version}-17-anylinux-x86_64.AppImage>easytag-bin-${version}.AppImage"
checksum=920d6c21b5f30875d0a8cde33554f1fec4d666f8edb18f6a55f5294edfd1fcc0
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/easytag-bin
	vcopy "squashfs-root/*" opt/easytag-bin
	vmkdir usr/bin
	ln -sf "/opt/easytag-bin/AppRun" "${DESTDIR}/usr/bin/easytag"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
