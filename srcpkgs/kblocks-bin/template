# Template file for 'kblocks-bin'
pkgname=kblocks-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KBlocks [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KBlocks-AppImage"
distfiles="https://github.com/pkgforge-dev/KBlocks-AppImage/releases/download/26.08.1-1%402026-10-01_1790875830/KBlocks-26.08.1-1-anylinux-x86_64.AppImage>kblocks-bin-${version}.AppImage"
checksum=7b4e3381e1cf58cbdb2110311a30814e8a278cdf6b2e3da66ba4f042a534cee8
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kblocks-bin
	vcopy "squashfs-root/*" opt/kblocks-bin
	vmkdir usr/bin
	ln -sf "/opt/kblocks-bin/AppRun" "${DESTDIR}/usr/bin/kblocks"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
