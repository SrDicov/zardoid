# Template file for 'pavucontrol-qt-bin'
pkgname=pavucontrol-qt-bin
version=2.4.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of pavucontrol-qt [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/pavucontrol-qt-AppImage"
distfiles="https://github.com/pkgforge-dev/pavucontrol-qt-AppImage/releases/download/${version}-1%402026-10-01_1790876475/pavucontrol-qt-${version}-1-anylinux-x86_64.AppImage>pavucontrol-qt-bin-${version}.AppImage"
checksum=d46271060dd4ffad49fee96a4957b2033a16ff4f441a4d28729789a9fe9b9b86
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pavucontrol-qt-bin
	vcopy "squashfs-root/*" opt/pavucontrol-qt-bin
	vmkdir usr/bin
	ln -sf "/opt/pavucontrol-qt-bin/AppRun" "${DESTDIR}/usr/bin/pavucontrol-qt"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
