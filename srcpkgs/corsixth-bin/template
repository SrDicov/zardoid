# Template file for 'corsixth-bin'
pkgname=corsixth-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of CorsixTH [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/CorsixTH-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/CorsixTH-AppImage-Enhanced/releases/download/v0.70.1%402026-10-22_1792679819/CorsixTH-v0.70.1-anylinux-x86_64.AppImage>corsixth-bin-${version}.AppImage"
checksum=c510b75d6768fcdcbdd035220eeafc256e34c7295f0848c18a3587cb52be1d01
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/corsixth-bin
	vcopy "squashfs-root/*" opt/corsixth-bin
	chmod -R o-w "${DESTDIR}/opt/corsixth-bin"
	vmkdir usr/bin
	ln -sf "/opt/corsixth-bin/AppRun" "${DESTDIR}/usr/bin/corsixth"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
