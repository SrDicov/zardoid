# Template file for 'opengothic-bin'
pkgname=opengothic-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenGothic [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenGothic-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenGothic-AppImage/releases/download/26b7159%402026-10-01_1790876582/OpenGothic-26b7159-anylinux-x86_64.AppImage>opengothic-bin-${version}.AppImage"
checksum=d57c239835dd7194797a1dcf37479cfe73a136a8c1be59ef09a56739acb59288
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/opengothic-bin
	vcopy "squashfs-root/*" opt/opengothic-bin
	vmkdir usr/bin
	ln -sf "/opt/opengothic-bin/AppRun" "${DESTDIR}/usr/bin/opengothic"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
