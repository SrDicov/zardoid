# Template file for 'system-monitoring-center-bin'
pkgname=system-monitoring-center-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of system-monitoring-center"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/system-monitoring-center-AppImage"
distfiles="https://github.com/pkgforge-dev/system-monitoring-center-AppImage/releases/download/3.4.1-1%402026-09-01_1788278401/System_Monitoring_Center-3.4.1-1-anylinux-x86_64.AppImage>system-monitoring-center-bin-${version}.AppImage"
checksum=ba5537a1dbc077fb73935e579cbb38bf63542ffc834373a3559f74a2b7700964
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/system-monitoring-center-bin
	vcopy "squashfs-root/*" opt/system-monitoring-center-bin
	vmkdir usr/bin
	ln -sf "/opt/system-monitoring-center-bin/AppRun" "${DESTDIR}/usr/bin/system-monitoring-center"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
