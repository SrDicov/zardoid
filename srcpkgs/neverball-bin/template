# Template file for 'neverball-bin'
pkgname=neverball-bin
version=1.6.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Neverball [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Neverball-AppImage"
distfiles="https://github.com/pkgforge-dev/Neverball-AppImage/releases/download/${version}%402026-09-22_1790090877/Neverball-${version}-anylinux-x86_64.AppImage>neverball-bin-${version}.AppImage"
checksum=d895044ea1e0ffb0cbd0aba83485ebd2c8bb5643dce16b72d2d7438d79eb82ab
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/neverball-bin
	vcopy "squashfs-root/*" opt/neverball-bin
	vmkdir usr/bin
	ln -sf "/opt/neverball-bin/AppRun" "${DESTDIR}/usr/bin/neverball"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
