# Template file for 'augustus-bin'
pkgname=augustus-bin
version=4.0.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Augustus [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Augustus-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Augustus-AppImage-Enhanced/releases/download/${version}-2%402026-10-01_1790876223/Augustus-${version}-2-anylinux-x86_64.AppImage>augustus-bin-${version}.AppImage"
checksum=c408af0ee249cc0bc6b820b039364c1fc159fa66f3e9a7eb57bff4ed606deb48
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/augustus-bin
	vcopy "squashfs-root/*" opt/augustus-bin
	vmkdir usr/bin
	ln -sf "/opt/augustus-bin/AppRun" "${DESTDIR}/usr/bin/augustus"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
