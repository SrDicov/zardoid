# Template file for 'defold-bin'
pkgname=defold-bin
version=1.12.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Defold [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Defold-AppImage"
distfiles="https://github.com/pkgforge-dev/Defold-AppImage/releases/download/${version}%402026-06-22_1782145707/Defold-${version}-anylinux-x86_64.AppImage>defold-bin-${version}.AppImage"
checksum=5e029581e96508e97613f792c0e82a6d97da5da3440acd60b4ac6f235a45b3c3
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/defold-bin
	vcopy "squashfs-root/*" opt/defold-bin
	vmkdir usr/bin
	ln -sf "/opt/defold-bin/AppRun" "${DESTDIR}/usr/bin/defold"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
