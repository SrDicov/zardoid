# Template file for 'github-desktop-bin'
pkgname=github-desktop-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of GitHub Desktop Plus"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/GitHub-Desktop-Plus-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/GitHub-Desktop-Plus-AppImage-Enhanced/releases/download/3.6.6.1%402026-10-01_1790876050/Desktop_Plus-3.6.6.1-anylinux-x86_64.AppImage>github-desktop-bin-${version}.AppImage"
checksum=50ff9cd57d615fa0fcc7a570d61ee6f490c467bdc0c662592c2ae8bfd3529ded
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/github-desktop-bin
	vcopy "squashfs-root/*" opt/github-desktop-bin
	vmkdir usr/bin
	ln -sf "/opt/github-desktop-bin/AppRun" "${DESTDIR}/usr/bin/github-desktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
