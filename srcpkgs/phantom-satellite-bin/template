# Template file for 'phantom-satellite-bin'
pkgname=phantom-satellite-bin
version=34.2.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Phantom Satellite
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Phantom-Satellite-AppImage"
distfiles="https://github.com/pkgforge-dev/Phantom-Satellite-AppImage/releases/download/${version}%402026-05-12_1778621546/Phantom_Satellite-${version}-anylinux-x86_64.AppImage>phantom-satellite-bin-${version}.AppImage"
checksum=9c6c921e85d75af713336584c6cf56ee7802a653e9777a2fd32461bbb5134896
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/phantom-satellite-bin
	vcopy "squashfs-root/*" opt/phantom-satellite-bin
	vmkdir usr/bin
	ln -sf "/opt/phantom-satellite-bin/AppRun" "${DESTDIR}/usr/bin/phantom-satellite"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
