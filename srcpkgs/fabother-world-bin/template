# Template file for 'fabother-world-bin'
pkgname=fabother-world-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Fabother-World
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Fabother-World-AppImage"
distfiles="https://github.com/pkgforge-dev/Fabother-World-AppImage/releases/download/170b7d466%402026-10-22_1792682187/Fabother_World-170b7d466-anylinux-x86_64.AppImage>fabother-world-bin-${version}.AppImage"
checksum=8c1cb00cd67f8b2dcbd2bc154cf20a7fe274aa7894ded7afa329acbd5e9e46b3
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/fabother-world-bin
	vcopy "squashfs-root/*" opt/fabother-world-bin
	chmod -R o-w "${DESTDIR}/opt/fabother-world-bin"
	vmkdir usr/bin
	ln -sf "/opt/fabother-world-bin/AppRun" "${DESTDIR}/usr/bin/fabother-world"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
