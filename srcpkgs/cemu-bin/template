# Template file for 'cemu-bin'
pkgname=cemu-bin
version=2.6
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Cemu which is able to work on any linux
 distro"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MPL-2.0"
homepage="https://github.com/pkgforge-dev/Cemu-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Cemu-AppImage-Enhanced/releases/download/${version}-4%402026-02-01_1769935971/Cemu-${version}-4-anylinux-x86_64.AppImage>cemu-bin-${version}.AppImage"
checksum=4b9276df7fb56198c6a54dfaa3afba6b69f0fb33b09ddbbbd2db10508e311f04
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cemu-bin
	vcopy "squashfs-root/*" opt/cemu-bin
	vmkdir usr/bin
	ln -sf "/opt/cemu-bin/AppRun" "${DESTDIR}/usr/bin/cemu"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
