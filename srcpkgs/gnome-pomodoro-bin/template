# Template file for 'gnome-pomodoro-bin'
pkgname=gnome-pomodoro-bin
version=0.27.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage for Gnome Pomodoro [Maintainer: @psadi]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="http://gnomepomodoro.org"
distfiles="https://github.com/pkgforge-dev/gnome-pomodoro-appimage/releases/download/${version}/Gnome-Pomodoro-${version}-x86_64.AppImage>gnome-pomodoro-bin-${version}.AppImage"
checksum=7348fdcaafb480feb3a4f7793ed715e44534e79dd16fbf5dc45e040df98517d8
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gnome-pomodoro-bin
	vcopy "squashfs-root/*" opt/gnome-pomodoro-bin
	vmkdir usr/bin
	ln -sf "/opt/gnome-pomodoro-bin/AppRun" "${DESTDIR}/usr/bin/gnome-pomodoro"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
