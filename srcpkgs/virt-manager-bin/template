# Template file for 'virt-manager-bin'
pkgname=virt-manager-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of virt-manager. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/virt-manager-AppImage"
distfiles="https://github.com/pkgforge-dev/virt-manager-AppImage/releases/download/5.1.0-4%402026-10-01_1790876015/virt-manager-5.1.0-4-anylinux-x86_64.AppImage>virt-manager-bin-${version}.AppImage"
checksum=70cdd47af56b7c21c5e9440ab7c356cd69c7e63e8f9d9cc5b30ff994cdfd5c0e
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/virt-manager-bin
	vcopy "squashfs-root/*" opt/virt-manager-bin
	vmkdir usr/bin
	ln -sf "/opt/virt-manager-bin/AppRun" "${DESTDIR}/usr/bin/virt-manager"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
