# Template file for 'itgmania-bin'
pkgname=itgmania-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ITGmania [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ITGmania-AppImage"
distfiles="https://github.com/pkgforge-dev/ITGmania-AppImage/releases/download/1.3.0%402026-10-22_1792689331/ITGmania-1.3.0-anylinux-x86_64.AppImage>itgmania-bin-${version}.AppImage"
checksum=5772940a444e097f07ddeabc0ecae6a5bda8a7a69e6cdd93f99633cb5ad777ae
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/itgmania-bin
	vcopy "squashfs-root/*" opt/itgmania-bin
	chmod -R o-w "${DESTDIR}/opt/itgmania-bin"
	vmkdir usr/bin
	ln -sf "/opt/itgmania-bin/AppRun" "${DESTDIR}/usr/bin/itgmania"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
