# Template file for 'itgmania-bin'
pkgname=itgmania-bin
version=1.3.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ITGmania [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ITGmania-AppImage"
distfiles="https://github.com/pkgforge-dev/ITGmania-AppImage/releases/download/${version}%402026-10-14_1791947802/ITGmania-${version}-anylinux-x86_64.AppImage>itgmania-bin-${version}.AppImage"
checksum=2a8e0c2ec64487e8a28b8f39e7b0039bb40837ba5df864bfea26353a69671f1c
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/itgmania-bin
	vcopy "squashfs-root/*" opt/itgmania-bin
	vmkdir usr/bin
	ln -sf "/opt/itgmania-bin/AppRun" "${DESTDIR}/usr/bin/itgmania"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
