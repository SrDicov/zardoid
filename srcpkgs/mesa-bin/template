# Template file for 'mesa-bin'
pkgname=mesa-bin
version=26.2.4
revision=1
archs="x86_64"
short_desc="Experimental AppImage that lets you use the latest MESA with any
 binary"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/MESA-AppImage"
distfiles="https://github.com/pkgforge-dev/MESA-AppImage/releases/download/${version}-1%402026-10-10_1791637020/MESA-${version}-1-anylinux-x86_64.AppImage>mesa-bin-${version}.AppImage"
checksum=62da78e88fcd399a2311476b136520a4dac22e4ea4270c3604cc703ad1965591
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/mesa-bin
	vcopy "squashfs-root/*" opt/mesa-bin
	vmkdir usr/bin
	ln -sf "/opt/mesa-bin/AppRun" "${DESTDIR}/usr/bin/mesa"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
