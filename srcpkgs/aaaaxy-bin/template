# Template file for 'aaaaxy-bin'
pkgname=aaaaxy-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of AAAAXY game. [Maintainer=@fiftydinar]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/AAAAXY-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/AAAAXY-AppImage-Enhanced/releases/download/1.8.34-1%402026-10-22_1792688879/AAAAXY-1.8.34-1-anylinux-x86_64.AppImage>aaaaxy-bin-${version}.AppImage"
checksum=12b1a94ed6a1a89016f8982bfbb859546bd059dbce9aafa8f095d02302bcd09d
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/aaaaxy-bin
	vcopy "squashfs-root/*" opt/aaaaxy-bin
	chmod -R o-w "${DESTDIR}/opt/aaaaxy-bin"
	vmkdir usr/bin
	ln -sf "/opt/aaaaxy-bin/AppRun" "${DESTDIR}/usr/bin/aaaaxy"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
