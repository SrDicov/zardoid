# Template file for 'aaaaxy-bin'
pkgname=aaaaxy-bin
version=1.7.218
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of AAAAXY game. [Maintainer=@fiftydinar]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/AAAAXY-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/AAAAXY-AppImage-Enhanced/releases/download/${version}-1%402026-10-01_1790876259/AAAAXY-${version}-1-anylinux-x86_64.AppImage>aaaaxy-bin-${version}.AppImage"
checksum=5d486ac1970e048a81cfc0398be8ee5371a1a3b988ef0ac12c4cb3f031dd6462
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/aaaaxy-bin
	vcopy "squashfs-root/*" opt/aaaaxy-bin
	vmkdir usr/bin
	ln -sf "/opt/aaaaxy-bin/AppRun" "${DESTDIR}/usr/bin/aaaaxy"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
