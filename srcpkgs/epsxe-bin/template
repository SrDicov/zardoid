# Template file for 'epsxe-bin'
pkgname=epsxe-bin
version=2.0.5
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ePSXe. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ePSXe-AppImage"
distfiles="https://github.com/pkgforge-dev/ePSXe-AppImage/releases/download/${version}%402026-09-10_1789041788/ePSXe-${version}-anylinux-x86_64.AppImage>epsxe-bin-${version}.AppImage"
checksum=70ec1ec05b1d31387beebc4c701ecbb6cc44a9ddedc6c4dea60bc26578798713
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/epsxe-bin
	vcopy "squashfs-root/*" opt/epsxe-bin
	vmkdir usr/bin
	ln -sf "/opt/epsxe-bin/AppRun" "${DESTDIR}/usr/bin/epsxe"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
