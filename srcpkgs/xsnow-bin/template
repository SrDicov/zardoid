# Template file for 'xsnow-bin'
pkgname=xsnow-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Xsnow [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Xsnow-AppImage"
distfiles="https://github.com/pkgforge-dev/Xsnow-AppImage/releases/download/3.9.0%402026-10-22_1792689057/xsnow-3.9.0-anylinux-x86_64.AppImage>xsnow-bin-${version}.AppImage"
checksum=3f52fb405eb62569c2c6300be3fa119868a35c3fd9af0468f4376f8e1b9beac4
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/xsnow-bin
	vcopy "squashfs-root/*" opt/xsnow-bin
	chmod -R o-w "${DESTDIR}/opt/xsnow-bin"
	vmkdir usr/bin
	ln -sf "/opt/xsnow-bin/AppRun" "${DESTDIR}/usr/bin/xsnow"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
