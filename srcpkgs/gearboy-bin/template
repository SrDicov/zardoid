# Template file for 'gearboy-bin'
pkgname=gearboy-bin
version=3.8.16
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Gearboy [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Gearboy-AppImage"
distfiles="https://github.com/pkgforge-dev/Gearboy-AppImage/releases/download/${version}%402026-10-01_1790875612/Gearboy-${version}-anylinux-x86_64.AppImage>gearboy-bin-${version}.AppImage"
checksum=28ea295419ef53f28e86378d12bce3bd421d69e3b529594f8d56f5b52f491642
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gearboy-bin
	vcopy "squashfs-root/*" opt/gearboy-bin
	vmkdir usr/bin
	ln -sf "/opt/gearboy-bin/AppRun" "${DESTDIR}/usr/bin/gearboy"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
