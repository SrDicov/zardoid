# Template file for 'opencode-desktop-bin'
pkgname=opencode-desktop-bin
version=20261015
revision=1
archs="x86_64"
short_desc="Improved AppImage of opencode which is able to work on any linux
 system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/opencode-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/opencode-AppImage-Enhanced/releases/download/v1.19.0%402026-10-15_1792067384/OpenCode-v1.19.0-anylinux-x86_64.AppImage>opencode-desktop-bin-${version}.AppImage"
checksum=f2816190996d01b541d016dfe40ebd6e3589ec72dff5f72a9c33339235584273
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/opencode-desktop-bin
	vcopy "squashfs-root/*" opt/opencode-desktop-bin
	vmkdir usr/bin
	ln -sf "/opt/opencode-desktop-bin/AppRun" "${DESTDIR}/usr/bin/opencode-desktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
