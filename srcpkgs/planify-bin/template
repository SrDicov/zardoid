# Template file for 'planify-bin'
pkgname=planify-bin
version=4.20.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Planify [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Planify-AppImage"
distfiles="https://github.com/pkgforge-dev/Planify-AppImage/releases/download/v${version}%402026-09-29_1790721694/Planify-v${version}-anylinux-x86_64.AppImage>planify-bin-${version}.AppImage"
checksum=816b5f19c0fa0350883d4cbeeb6bb344865bc704f8be9a88c5cf14038960571f
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/planify-bin
	vcopy "squashfs-root/*" opt/planify-bin
	vmkdir usr/bin
	ln -sf "/opt/planify-bin/AppRun" "${DESTDIR}/usr/bin/planify"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
