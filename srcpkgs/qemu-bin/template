# Template file for 'qemu-bin'
pkgname=qemu-bin
version=11.1.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of QEMU to emulate all supported platforms"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/QEMU-AppImage"
distfiles="https://github.com/pkgforge-dev/QEMU-AppImage/releases/download/${version}-4%402026-10-01_1790875330/QEMU-${version}-4-anylinux-x86_64.AppImage>qemu-bin-${version}.AppImage"
checksum=61ab65257c2db116aa28489c725379ab147a3bd399535c823a10d485ebd70fbd
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/qemu-bin
	vcopy "squashfs-root/*" opt/qemu-bin
	vmkdir usr/bin
	ln -sf "/opt/qemu-bin/AppRun" "${DESTDIR}/usr/bin/qemu"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
