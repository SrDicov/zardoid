# Template file for 'vokoscreenng-bin'
pkgname=vokoscreenng-bin
version=4.10.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of vokoscreenNG [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/vokoscreenNG-AppImage"
distfiles="https://github.com/pkgforge-dev/vokoscreenNG-AppImage/releases/download/${version}-1%402026-10-01_1790876511/vokoscreenNG-${version}-1-anylinux-x86_64.AppImage>vokoscreenng-bin-${version}.AppImage"
checksum=ba353efd37ddf340a4546b7005292aa7e48ab37acea2c3066a5e3f07ff88e41e
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/vokoscreenng-bin
	vcopy "squashfs-root/*" opt/vokoscreenng-bin
	vmkdir usr/bin
	ln -sf "/opt/vokoscreenng-bin/AppRun" "${DESTDIR}/usr/bin/vokoscreenng"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
