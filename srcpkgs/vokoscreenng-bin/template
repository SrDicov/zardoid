# Template file for 'vokoscreenng-bin'
pkgname=vokoscreenng-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of vokoscreenNG [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/vokoscreenNG-AppImage"
distfiles="https://github.com/pkgforge-dev/vokoscreenNG-AppImage/releases/download/4.11.0-1%402026-10-22_1792689390/vokoscreenNG-4.11.0-1-anylinux-x86_64.AppImage>vokoscreenng-bin-${version}.AppImage"
checksum=90643c8dd779ae6e5d0681be6a83e35048eb67fb740f298228fca60726106cc4
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/vokoscreenng-bin
	vcopy "squashfs-root/*" opt/vokoscreenng-bin
	chmod -R o-w "${DESTDIR}/opt/vokoscreenng-bin"
	vmkdir usr/bin
	ln -sf "/opt/vokoscreenng-bin/AppRun" "${DESTDIR}/usr/bin/vokoscreenng"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
