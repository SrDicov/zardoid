# Template file for 'tagger-bin'
pkgname=tagger-bin
version=2024.6.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Tagger audio tagger application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Tagger-AppImage"
distfiles="https://github.com/pkgforge-dev/Tagger-AppImage/releases/download/${version}-3%402026-05-22_1779457989/Tagger-${version}-3-anylinux-x86_64.AppImage>tagger-bin-${version}.AppImage"
checksum=2c889af35009803c5911922959b299dfa119bee897220cf617e7cbd3e7d9ee71
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/tagger-bin
	vcopy "squashfs-root/*" opt/tagger-bin
	vmkdir usr/bin
	ln -sf "/opt/tagger-bin/AppRun" "${DESTDIR}/usr/bin/tagger"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
