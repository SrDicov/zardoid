# Template file for 'libation-bin'
pkgname=libation-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Libation [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Libation-AppImage"
distfiles="https://github.com/pkgforge-dev/Libation-AppImage/releases/download/14.2.2-1%402026-10-22_1792688859/Libation-14.2.2-1-anylinux-x86_64.AppImage>libation-bin-${version}.AppImage"
checksum=a82f82b60575b3011e5592644ea978ee6dd58820b4e34c973e4a1703c231b475
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/libation-bin
	vcopy "squashfs-root/*" opt/libation-bin
	chmod -R o-w "${DESTDIR}/opt/libation-bin"
	vmkdir usr/bin
	ln -sf "/opt/libation-bin/AppRun" "${DESTDIR}/usr/bin/libation"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
