# Template file for 'simplex-chat-bin'
pkgname=simplex-chat-bin
version=7.0.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Simplex Chat that can work on any linux
 system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SimpleX-Chat-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/SimpleX-Chat-AppImage-Enhanced/releases/download/v${version}%402026-10-01_1790876600/simplex-v${version}-anylinux-x86_64.AppImage>simplex-chat-bin-${version}.AppImage"
checksum=7bdf9a7f1402ff5aad39bf39450ccafdc07473d41b01e3d4b7a2481fa52d4db8
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/simplex-chat-bin
	vcopy "squashfs-root/*" opt/simplex-chat-bin
	vmkdir usr/bin
	ln -sf "/opt/simplex-chat-bin/AppRun" "${DESTDIR}/usr/bin/simplex-chat"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
