# Template file for 'vice-bin'
pkgname=vice-bin
version=3.10
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of VICE [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/VICE-AppImage"
distfiles="https://github.com/pkgforge-dev/VICE-AppImage/releases/download/${version}-3%402026-10-01_1790866415/VICE-${version}-3-anylinux-x86_64.AppImage>vice-bin-${version}.AppImage"
checksum=b6907bb9d7b4da46fad6cd30005d84dcca05e8cdbef6dbac35ba783aa0bd87a0
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/vice-bin
	vcopy "squashfs-root/*" opt/vice-bin
	vmkdir usr/bin
	ln -sf "/opt/vice-bin/AppRun" "${DESTDIR}/usr/bin/vice"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
