# Template file for 'deadbeef-bin'
pkgname=deadbeef-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the DeaDBeeF music player. (Stable and
 Nightly"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/DeaDBeeF-AppImage"
distfiles="https://github.com/pkgforge-dev/DeaDBeeF-AppImage/releases/download/1.10.3%402026-10-22_1792689140/DeaDBeeF-1.10.3-anylinux-x86_64.AppImage>deadbeef-bin-${version}.AppImage"
checksum=205d2129f145dbc8024a27f6a41161acf2d9f1e08385ef4796fd265ddc036d95
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/deadbeef-bin
	vcopy "squashfs-root/*" opt/deadbeef-bin
	chmod -R o-w "${DESTDIR}/opt/deadbeef-bin"
	vmkdir usr/bin
	ln -sf "/opt/deadbeef-bin/AppRun" "${DESTDIR}/usr/bin/deadbeef"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
