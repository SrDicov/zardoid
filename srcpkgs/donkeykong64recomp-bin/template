# Template file for 'donkeykong64recomp-bin'
pkgname=donkeykong64recomp-bin
version=1.0.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Donkey Kong 64 Recompiled"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/DonkeyKong64Recomp-AppImage"
distfiles="https://github.com/pkgforge-dev/DonkeyKong64Recomp-AppImage/releases/download/${version}%402026-10-01_1790875551/DK64Recompiled-${version}-anylinux-x86_64.AppImage>donkeykong64recomp-bin-${version}.AppImage"
checksum=95b5ad906149c10ca8e1c587596c3a8d9ec14220a67346ec9258a6683814fa0b
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/donkeykong64recomp-bin
	vcopy "squashfs-root/*" opt/donkeykong64recomp-bin
	vmkdir usr/bin
	ln -sf "/opt/donkeykong64recomp-bin/AppRun" "${DESTDIR}/usr/bin/donkeykong64recomp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
