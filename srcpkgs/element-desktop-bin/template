# Template file for 'element-desktop-bin'
pkgname=element-desktop-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Element Desktop [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Element-Desktop-AppImage"
distfiles="https://github.com/pkgforge-dev/Element-Desktop-AppImage/releases/download/1.12.32%402026-10-22_1792689082/Element-1.12.32-anylinux-x86_64.AppImage>element-desktop-bin-${version}.AppImage"
checksum=9d951ac01278835eb2ef87c4d0dcfab40c38564a133059ea5e6d87e6a975a477
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/element-desktop-bin
	vcopy "squashfs-root/*" opt/element-desktop-bin
	chmod -R o-w "${DESTDIR}/opt/element-desktop-bin"
	vmkdir usr/bin
	ln -sf "/opt/element-desktop-bin/AppRun" "${DESTDIR}/usr/bin/element-desktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
