# Template file for 'webcord-bin'
pkgname=webcord-bin
version=4.14.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of WebCord [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/WebCord-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/WebCord-AppImage-Enhanced/releases/download/${version}%402026-10-01_1790876704/WebCord-${version}-anylinux-x86_64.AppImage>webcord-bin-${version}.AppImage"
checksum=05541e9f356aed89f23654f239779617e8c43b8bffa2a84a27ba5d3a225742ce
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/webcord-bin
	vcopy "squashfs-root/*" opt/webcord-bin
	vmkdir usr/bin
	ln -sf "/opt/webcord-bin/AppRun" "${DESTDIR}/usr/bin/webcord"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
