# Template file for 'cartridges-bin'
pkgname=cartridges-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Cartridges game manager and launcher"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Cartridges-AppImage"
distfiles="https://github.com/pkgforge-dev/Cartridges-AppImage/releases/download/2.13.1-2%402026-10-22_1792689366/Cartridges-2.13.1-2-anylinux-x86_64.AppImage>cartridges-bin-${version}.AppImage"
checksum=2d0bc8b0c98f1c10c3b641a20a8d0d27dd6c59a15a3b8209370f7f9ffb7fe6ab
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/cartridges-bin
	vcopy "squashfs-root/*" opt/cartridges-bin
	chmod -R o-w "${DESTDIR}/opt/cartridges-bin"
	vmkdir usr/bin
	ln -sf "/opt/cartridges-bin/AppRun" "${DESTDIR}/usr/bin/cartridges"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
