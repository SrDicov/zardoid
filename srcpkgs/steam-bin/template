# Template file for 'steam-bin'
pkgname=steam-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial Steam AppImage built using Runimage"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/ivan-hc/AM"
distfiles="https://github.com/ivan-hc/Steam-appimage/releases/download/1.0.0.87-3%402026-10-01_1790856625/Steam-1.0.0.87-3-anylinux-x86_64.AppImage>steam-bin-${version}.AppImage"
checksum=a870636083ca6edc988ebe34869a187d9a746fce6d5fa4249868b640fc0c1695
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/steam-bin
	vcopy "squashfs-root/*" opt/steam-bin
	vmkdir usr/bin
	ln -sf "/opt/steam-bin/AppRun" "${DESTDIR}/usr/bin/steam"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
