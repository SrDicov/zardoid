# Template file for 'nitrogen-bin'
pkgname=nitrogen-bin
version=1.6.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Nitrogen [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Nitrogen-AppImage"
distfiles="https://github.com/pkgforge-dev/Nitrogen-AppImage/releases/download/${version}-6%402026-09-01_1788278110/nitrogen-${version}-6-anylinux-x86_64.AppImage>nitrogen-bin-${version}.AppImage"
checksum=9f4d3aec7208ec73afd19ff6c642a3a6b9d19cf0514e64bea98800b5f6f3a2c8
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/nitrogen-bin
	vcopy "squashfs-root/*" opt/nitrogen-bin
	vmkdir usr/bin
	ln -sf "/opt/nitrogen-bin/AppRun" "${DESTDIR}/usr/bin/nitrogen"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
