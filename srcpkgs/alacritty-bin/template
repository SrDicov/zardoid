# Template file for 'alacritty-bin'
pkgname=alacritty-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of alacritty [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/alacritty-AppImage"
distfiles="https://github.com/pkgforge-dev/alacritty-AppImage/releases/download/v0.17.0%402026-10-22_1792688955/Alacritty-v0.17.0-anylinux-x86_64.AppImage>alacritty-bin-${version}.AppImage"
checksum=b2e188249a76bedb7cae452e3984f852a95bbd4965c38f4092e46aa36cb03e1f
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/alacritty-bin
	vcopy "squashfs-root/*" opt/alacritty-bin
	chmod -R o-w "${DESTDIR}/opt/alacritty-bin"
	vmkdir usr/bin
	ln -sf "/opt/alacritty-bin/AppRun" "${DESTDIR}/usr/bin/alacritty"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
