# Template file for 'alacritty-bin'
pkgname=alacritty-bin
version=0.17.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of alacritty [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/alacritty-AppImage"
distfiles="https://github.com/pkgforge-dev/alacritty-AppImage/releases/download/v${version}%402026-10-01_1790876663/Alacritty-v${version}-anylinux-x86_64.AppImage>alacritty-bin-${version}.AppImage"
checksum=dd0263e678aa5e8dbe3606c7beb46b4dd815a1dd05c6b70ecf1567ec1c84ee5e
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/alacritty-bin
	vcopy "squashfs-root/*" opt/alacritty-bin
	vmkdir usr/bin
	ln -sf "/opt/alacritty-bin/AppRun" "${DESTDIR}/usr/bin/alacritty"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
