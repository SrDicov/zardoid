# Template file for 'sanicball-bin'
pkgname=sanicball-bin
version=0.8.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Sanicball [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Sanicball-AppImage"
distfiles="https://github.com/pkgforge-dev/Sanicball-AppImage/releases/download/${version}%402026-09-01_1788278183/Sanicball-${version}-anylinux-x86_64.AppImage>sanicball-bin-${version}.AppImage"
checksum=ed9bcbfa8841269925f68f700b6eb25ffccc9983a56022293ce1786c99f441b4
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/sanicball-bin
	vcopy "squashfs-root/*" opt/sanicball-bin
	vmkdir usr/bin
	ln -sf "/opt/sanicball-bin/AppRun" "${DESTDIR}/usr/bin/sanicball"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
