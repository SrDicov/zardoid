# Template file for 'telegram-desktop-bin'
pkgname=telegram-desktop-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Telegram [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Telegram-AppImage"
distfiles="https://github.com/pkgforge-dev/Telegram-AppImage/releases/download/7.3.2-1%402026-10-22_1792689327/Telegram-7.3.3-1-anylinux-x86_64.AppImage>telegram-desktop-bin-${version}.AppImage"
checksum=7697ee18afef950abe6dea9d31b3e2f981b18c591b54e1172e9a2e40e4f93645
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/telegram-desktop-bin
	vcopy "squashfs-root/*" opt/telegram-desktop-bin
	chmod -R o-w "${DESTDIR}/opt/telegram-desktop-bin"
	vmkdir usr/bin
	ln -sf "/opt/telegram-desktop-bin/AppRun" "${DESTDIR}/usr/bin/telegram-desktop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
