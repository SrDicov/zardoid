# Template file for 'diffpdf-bin'
pkgname=diffpdf-bin
version=2.1.3.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of DiffPDF [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/DiffPDF-AppImage"
distfiles="https://github.com/pkgforge-dev/DiffPDF-AppImage/releases/download/${version}-4%402026-10-01_1790876142/DiffPDF-${version}-5-anylinux-x86_64.AppImage>diffpdf-bin-${version}.AppImage"
checksum=d59c83a988f3778a2bc4553a318fab2e7f3bbf719103f017a6017c3d1290b4e4
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/diffpdf-bin
	vcopy "squashfs-root/*" opt/diffpdf-bin
	vmkdir usr/bin
	ln -sf "/opt/diffpdf-bin/AppRun" "${DESTDIR}/usr/bin/diffpdf"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
