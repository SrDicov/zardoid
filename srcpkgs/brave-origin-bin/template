# Template file for 'brave-origin-bin'
pkgname=brave-origin-bin
version=20261023
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Brave Origin [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Brave-Origin-AppImage"
distfiles="https://github.com/pkgforge-dev/Brave-Origin-AppImage/releases/download/1.98.60-1%402026-10-23_1792758562/Brave_Origin-1.98.60-1-anylinux-x86_64.AppImage>brave-origin-bin-${version}.AppImage"
checksum=665b1ff4f052ee096d45b352ec8a47319e4ab294c37def374931e8e9ce029a43
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/brave-origin-bin
	vcopy "squashfs-root/*" opt/brave-origin-bin
	chmod -R o-w "${DESTDIR}/opt/brave-origin-bin"
	vmkdir usr/bin
	ln -sf "/opt/brave-origin-bin/AppRun" "${DESTDIR}/usr/bin/brave-origin"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
