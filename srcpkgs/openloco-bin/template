# Template file for 'openloco-bin'
pkgname=openloco-bin
version=26.09
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenLoco [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenLoco-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenLoco-AppImage/releases/download/${version}%402026-10-01_1790876342/OpenLoco-${version}-anylinux-x86_64.AppImage>openloco-bin-${version}.AppImage"
checksum=f628346d575ce153d14355fca6033729f1ed3e8556af5fcd33a5c3f8825d0b28
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/openloco-bin
	vcopy "squashfs-root/*" opt/openloco-bin
	vmkdir usr/bin
	ln -sf "/opt/openloco-bin/AppRun" "${DESTDIR}/usr/bin/openloco"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
