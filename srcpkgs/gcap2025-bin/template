# Template file for 'gcap2025-bin'
pkgname=gcap2025-bin
version=20260606
revision=1
archs="x86_64"
short_desc="Appimage não oficial do GCAP2025 [Mantenedor=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/GCAP2025-AppImage"
distfiles="https://github.com/pkgforge-dev/GCAP2025-AppImage/releases/download/1.6%402026-06-06_1780706767/GCAP_2025-1.6-anylinux-x86_64.AppImage>gcap2025-bin-${version}.AppImage"
checksum=1fad05bd1443130fbab4ab35ce67f8d94a880458ad28f09510040a0c75874e91
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gcap2025-bin
	vcopy "squashfs-root/*" opt/gcap2025-bin
	chmod -R o-w "${DESTDIR}/opt/gcap2025-bin"
	vmkdir usr/bin
	ln -sf "/opt/gcap2025-bin/AppRun" "${DESTDIR}/usr/bin/gcap2025"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
