# Template file for 'gnome-system-monitor-bin'
pkgname=gnome-system-monitor-bin
version=50.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage for Gnome System Monitor
 [Maintainer=@fiftydinar]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Gnome-System-Monitor-AppImage"
distfiles="https://github.com/pkgforge-dev/Gnome-System-Monitor-AppImage/releases/download/${version}-1%402026-10-01_1790876443/System_Monitor-${version}-1-anylinux-x86_64.AppImage>gnome-system-monitor-bin-${version}.AppImage"
checksum=9c489af565fca61223b681c14574d1e651fec581489fd89f0c22810701e84445
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gnome-system-monitor-bin
	vcopy "squashfs-root/*" opt/gnome-system-monitor-bin
	vmkdir usr/bin
	ln -sf "/opt/gnome-system-monitor-bin/AppRun" "${DESTDIR}/usr/bin/gnome-system-monitor"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
