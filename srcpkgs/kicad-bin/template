# Template file for 'kicad-bin'
pkgname=kicad-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of KiCad [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/KiCad-AppImage"
distfiles="https://github.com/pkgforge-dev/KiCad-AppImage/releases/download/10.0.7-2%402026-10-22_1792689211/KiCad-10.0.7-2-anylinux-x86_64.AppImage>kicad-bin-${version}.AppImage"
checksum=0be1b8bd9a0acfb8fd54b8438fd2742284db4e3d9ec4f936d64f3bfea087c4af
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kicad-bin
	vcopy "squashfs-root/*" opt/kicad-bin
	chmod -R o-w "${DESTDIR}/opt/kicad-bin"
	vmkdir usr/bin
	ln -sf "/opt/kicad-bin/AppRun" "${DESTDIR}/usr/bin/kicad"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
