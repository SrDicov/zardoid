# Template file for 'localsend-bin'
pkgname=localsend-bin
version=1.18.2
revision=1
archs="x86_64"
short_desc="Open-source cross-platform alternative to AirDrop"
maintainer="SrDicov <SrDicov@gmail.com>"
license="Apache-2.0"
homepage="https://localsend.org"
distfiles="https://github.com/localsend/localsend/releases/download/v${version}/LocalSend-${version}-linux-x86-64.AppImage>localsend-bin-${version}.AppImage"
checksum=19f21613d1834f6caa69517113670461a3f10b80a2a315f86548c0663d9c0aaf
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/localsend-bin
	vcopy "squashfs-root/*" opt/localsend-bin
	vmkdir usr/bin
	ln -sf "/opt/localsend-bin/AppRun" "${DESTDIR}/usr/bin/localsend"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
