# Template file for 'legcord-bin'
pkgname=legcord-bin
version=1.3.1
revision=1
archs="x86_64"
short_desc="Legcord is a custom client designed to enhance your Discord
 experience"
maintainer="SrDicov <SrDicov@gmail.com>"
license="OSL-3.0"
homepage="https://legcord.app"
distfiles="https://github.com/Legcord/Legcord/releases/download/v${version}/Legcord-${version}-linux-x86_64.AppImage>legcord-bin-${version}.AppImage"
checksum=a4bd04f54424545f027e93ebee46fd1afaadc6e1e4cd152972d3bfafbc87ff95
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/legcord-bin
	vcopy "squashfs-root/*" opt/legcord-bin
	vmkdir usr/bin
	ln -sf "/opt/legcord-bin/AppRun" "${DESTDIR}/usr/bin/legcord"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
