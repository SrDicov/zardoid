# Template file for 'readest-bin'
pkgname=readest-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Readest [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Readest-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Readest-AppImage-Enhanced/releases/download/0.12.16-1%402026-10-22_1792689024/Readest-0.12.16-1-anylinux-x86_64.AppImage>readest-bin-${version}.AppImage"
checksum=0e32afabb0d85308a962fe2fd3d7b41e59bcc0fc6ccab90bf3203448801d6b17
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/readest-bin
	vcopy "squashfs-root/*" opt/readest-bin
	chmod -R o-w "${DESTDIR}/opt/readest-bin"
	vmkdir usr/bin
	ln -sf "/opt/readest-bin/AppRun" "${DESTDIR}/usr/bin/readest"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
