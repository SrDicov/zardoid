# Template file for 'pixelpulse2-bin'
pkgname=pixelpulse2-bin
version=25725434013
revision=1
archs="x86_64"
short_desc="Pixelpulse2 is a user interface for analog systems exploration"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MPL-2.0"
homepage="https://sounddrill31.github.io/Pixelpulse2/"
distfiles="https://github.com/pkgforge-dev/Pixelpulse2-AppImage/releases/download/${version}/Pixelpulse2-anylinux-x86_64.AppImage>pixelpulse2-bin-${version}.AppImage"
checksum=6ccc53c3a0de529a88cf1a7eaf6b531de03545112475e96a3451e3c583477a5e
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pixelpulse2-bin
	vcopy "squashfs-root/*" opt/pixelpulse2-bin
	vmkdir usr/bin
	ln -sf "/opt/pixelpulse2-bin/AppRun" "${DESTDIR}/usr/bin/pixelpulse2"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
