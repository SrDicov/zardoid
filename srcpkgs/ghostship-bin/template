# Template file for 'ghostship-bin'
pkgname=ghostship-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Ghostship [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Ghostship-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Ghostship-AppImage-Enhanced/releases/download/3.0.0%402026-10-22_1792688945/Ghostship-3.0.0-anylinux-x86_64.AppImage>ghostship-bin-${version}.AppImage"
checksum=535631048a6ad0672ce90354d612331df0e1a905b8b210436b0428c6d327936b
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ghostship-bin
	vcopy "squashfs-root/*" opt/ghostship-bin
	chmod -R o-w "${DESTDIR}/opt/ghostship-bin"
	vmkdir usr/bin
	ln -sf "/opt/ghostship-bin/AppRun" "${DESTDIR}/usr/bin/ghostship"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
