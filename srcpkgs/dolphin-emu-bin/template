# Template file for 'dolphin-emu-bin'
pkgname=dolphin-emu-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Dolphin emulator"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Dolphin-emu-AppImage"
distfiles="https://github.com/pkgforge-dev/Dolphin-emu-AppImage/releases/download/2609%402026-10-01_1790876487/Dolphin_Emulator-2609-anylinux-x86_64.AppImage>dolphin-emu-bin-${version}.AppImage"
checksum=d033d883870c3cd3224fa28b8b70ac932f464f4f6c3dea4e331f875c811d437a
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dolphin-emu-bin
	vcopy "squashfs-root/*" opt/dolphin-emu-bin
	chmod -R o-w "${DESTDIR}/opt/dolphin-emu-bin"
	vmkdir usr/bin
	ln -sf "/opt/dolphin-emu-bin/AppRun" "${DESTDIR}/usr/bin/dolphin-emu"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
