# Template file for 'rednukem-bin'
pkgname=rednukem-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Rednukem [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Rednukem-AppImage"
distfiles="https://github.com/pkgforge-dev/Rednukem-AppImage/releases/download/497385d64%402026-10-22_1792688606/Rednukem-497385d64-anylinux-x86_64.AppImage>rednukem-bin-${version}.AppImage"
checksum=141c0550d3b3ea5832930a437fe87c281a25d0c384769049637f4021b5e776bd
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rednukem-bin
	vcopy "squashfs-root/*" opt/rednukem-bin
	chmod -R o-w "${DESTDIR}/opt/rednukem-bin"
	vmkdir usr/bin
	ln -sf "/opt/rednukem-bin/AppRun" "${DESTDIR}/usr/bin/rednukem"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
