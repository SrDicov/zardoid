# Template file for 'opentyrian2000-bin'
pkgname=opentyrian2000-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OpenTyrian2000
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OpenTyrian2000-AppImage"
distfiles="https://github.com/pkgforge-dev/OpenTyrian2000-AppImage/releases/download/aad5aca01%402026-10-22_1792687400/OpenTyrian2000-aad5aca01-anylinux-x86_64.AppImage>opentyrian2000-bin-${version}.AppImage"
checksum=dc9b5c054c5be6edd10dc3f3f87de6ddcfd1acaf245619099a3cc190c6074c9c
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/opentyrian2000-bin
	vcopy "squashfs-root/*" opt/opentyrian2000-bin
	chmod -R o-w "${DESTDIR}/opt/opentyrian2000-bin"
	vmkdir usr/bin
	ln -sf "/opt/opentyrian2000-bin/AppRun" "${DESTDIR}/usr/bin/opentyrian2000"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
