# Template file for 'abaddon-bin'
pkgname=abaddon-bin
version=0.2.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Abaddon [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Abaddon-AppImage"
distfiles="https://github.com/pkgforge-dev/Abaddon-AppImage/releases/download/${version}%402026-10-01_1790876679/abaddon-${version}-anylinux-x86_64.AppImage>abaddon-bin-${version}.AppImage"
checksum=93744f19133d00c069bbfe88f181ed5e451d83f2d7a9e1c13954e2fc023c6819
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/abaddon-bin
	vcopy "squashfs-root/*" opt/abaddon-bin
	vmkdir usr/bin
	ln -sf "/opt/abaddon-bin/AppRun" "${DESTDIR}/usr/bin/abaddon"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
