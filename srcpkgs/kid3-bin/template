# Template file for 'kid3-bin'
pkgname=kid3-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Kid3. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Kid3-AppImage"
distfiles="https://github.com/pkgforge-dev/Kid3-AppImage/releases/download/3.10.2-1%402026-10-22_1792688434/Kid3-3.10.2-1-anylinux-x86_64.AppImage>kid3-bin-${version}.AppImage"
checksum=de2e170e94effdd4aab83a8953d6d2e24cca5ffc2da18244cc07ea9d4a9a8d02
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kid3-bin
	vcopy "squashfs-root/*" opt/kid3-bin
	chmod -R o-w "${DESTDIR}/opt/kid3-bin"
	vmkdir usr/bin
	ln -sf "/opt/kid3-bin/AppRun" "${DESTDIR}/usr/bin/kid3"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
