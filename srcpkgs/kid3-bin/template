# Template file for 'kid3-bin'
pkgname=kid3-bin
version=3.10.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Kid3. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Kid3-AppImage"
distfiles="https://github.com/pkgforge-dev/Kid3-AppImage/releases/download/${version}-2%402026-10-01_1790875637/Kid3-${version}-2-anylinux-x86_64.AppImage>kid3-bin-${version}.AppImage"
checksum=508747e1f9641114094531d06ccdfeabb996a713a31b76e6445a71ecc401d7b6
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kid3-bin
	vcopy "squashfs-root/*" opt/kid3-bin
	vmkdir usr/bin
	ln -sf "/opt/kid3-bin/AppRun" "${DESTDIR}/usr/bin/kid3"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
