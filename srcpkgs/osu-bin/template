# Template file for 'osu-bin'
pkgname=osu-bin
version=2026.1005.0.lazer
revision=1
short_desc="Rhythm is just a *click* away!"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://osu.ppy.sh"
distfiles="https://github.com/ppy/osu/releases/download/2026.1005.0-lazer/osu.AppImage>osu-bin-${version}.AppImage"
checksum=284108e65373a8339beeca40e2c14b1528c177bd6ce1eb21407639f8e508da2e
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/osu-bin
	vcopy "squashfs-root/*" opt/osu-bin
	chmod -R o-w "${DESTDIR}/opt/osu-bin"
	vmkdir usr/bin
	ln -sf "/opt/osu-bin/AppRun" "${DESTDIR}/usr/bin/osu"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
