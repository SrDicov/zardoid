# Template file for 'nblood-bin'
pkgname=nblood-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of NBlood [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/NBlood-AppImage"
distfiles="https://github.com/pkgforge-dev/NBlood-AppImage/releases/download/497385d64%402026-10-22_1792680086/NBlood-497385d64-anylinux-x86_64.AppImage>nblood-bin-${version}.AppImage"
checksum=3ee47de66bf1de42e53e6e6c3f070d3805f349452c55108f8bf2cbf77bf31ba4
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/nblood-bin
	vcopy "squashfs-root/*" opt/nblood-bin
	chmod -R o-w "${DESTDIR}/opt/nblood-bin"
	vmkdir usr/bin
	ln -sf "/opt/nblood-bin/AppRun" "${DESTDIR}/usr/bin/nblood"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
