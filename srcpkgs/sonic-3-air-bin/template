# Template file for 'sonic-3-air-bin'
pkgname=sonic-3-air-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Sonic 3 A.I.R.
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Sonic-3-AIR-AppImage"
distfiles="https://github.com/pkgforge-dev/Sonic-3-AIR-AppImage/releases/download/v26.03.28.0%402026-10-22_1792688597/Sonic_3_A.I.R.-v26.03.28.0-anylinux-x86_64.AppImage>sonic-3-air-bin-${version}.AppImage"
checksum=9ad92d09d9a43a132cd59d40fd975c407ec189c4042e9f2fac2f7b1ec8888be5
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/sonic-3-air-bin
	vcopy "squashfs-root/*" opt/sonic-3-air-bin
	chmod -R o-w "${DESTDIR}/opt/sonic-3-air-bin"
	vmkdir usr/bin
	ln -sf "/opt/sonic-3-air-bin/AppRun" "${DESTDIR}/usr/bin/sonic-3-air"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
