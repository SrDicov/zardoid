# Template file for 'gearlynx-bin'
pkgname=gearlynx-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Gearlynx [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Gearlynx-AppImage"
distfiles="https://github.com/pkgforge-dev/Gearlynx-AppImage/releases/download/1.2.35%402026-10-22_1792689339/Gearlynx-1.2.35-anylinux-x86_64.AppImage>gearlynx-bin-${version}.AppImage"
checksum=2cd41bc948d554d03269193f4a1b728bf891670f9b45547638f6d957dcab1790
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gearlynx-bin
	vcopy "squashfs-root/*" opt/gearlynx-bin
	chmod -R o-w "${DESTDIR}/opt/gearlynx-bin"
	vmkdir usr/bin
	ln -sf "/opt/gearlynx-bin/AppRun" "${DESTDIR}/usr/bin/gearlynx"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
