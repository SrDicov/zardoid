# Template file for 'xenia-canary-bin'
pkgname=xenia-canary-bin
version=20261015
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of xenia-canary [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="BSD-3-Clause"
homepage="https://github.com/pkgforge-dev/xenia-canary-AppImage"
distfiles="https://github.com/pkgforge-dev/xenia-canary-AppImage/releases/download/02d2cb5%402026-10-15_1792067126/Xenia_Canary-02d2cb5-anylinux-x86_64.AppImage>xenia-canary-bin-${version}.AppImage"
checksum=7145cc11bf022f19e47824b8c387e2e610739a4fd91f93c1a419e13eba264474
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/xenia-canary-bin
	vcopy "squashfs-root/*" opt/xenia-canary-bin
	vmkdir usr/bin
	ln -sf "/opt/xenia-canary-bin/AppRun" "${DESTDIR}/usr/bin/xenia-canary"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
