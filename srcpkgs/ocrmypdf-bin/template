# Template file for 'ocrmypdf-bin'
pkgname=ocrmypdf-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OCRmyPDF [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OCRmyPDF-AppImage"
distfiles="https://github.com/pkgforge-dev/OCRmyPDF-AppImage/releases/download/17.12.1-1%402026-10-01_1790876632/ocrmypdf-17.12.1-1-anylinux-x86_64.AppImage>ocrmypdf-bin-${version}.AppImage"
checksum=f592ccf2640d6c60a3c26d416ec00bc2bea65fad681bdd6a55fd2efc1c3fef11
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ocrmypdf-bin
	vcopy "squashfs-root/*" opt/ocrmypdf-bin
	vmkdir usr/bin
	ln -sf "/opt/ocrmypdf-bin/AppRun" "${DESTDIR}/usr/bin/ocrmypdf"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
