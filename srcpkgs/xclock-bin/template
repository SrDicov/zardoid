# Template file for 'xclock-bin'
pkgname=xclock-bin
version=1.2.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of xclock [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/xclock-AppImage"
distfiles="https://github.com/pkgforge-dev/xclock-AppImage/releases/download/${version}-1%402026-10-01_1790875599/xclock-${version}-1-anylinux-x86_64.AppImage>xclock-bin-${version}.AppImage"
checksum=bce2e29eaa1d9130d7a799e7f487fc695e4977512ebff8befc9658140eaf9f2c
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/xclock-bin
	vcopy "squashfs-root/*" opt/xclock-bin
	vmkdir usr/bin
	ln -sf "/opt/xclock-bin/AppRun" "${DESTDIR}/usr/bin/xclock"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
