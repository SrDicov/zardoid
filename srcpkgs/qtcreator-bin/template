# Template file for 'qtcreator-bin'
pkgname=qtcreator-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of QtCreator [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/QtCreator-AppImage"
distfiles="https://github.com/pkgforge-dev/QtCreator-AppImage/releases/download/20.0.2-3%402026-10-22_1792689447/Qt_Creator-20.0.2-3-anylinux-x86_64.AppImage>qtcreator-bin-${version}.AppImage"
checksum=2ab9f14897b310c957304cb24520caa556cd5a03dbe1ec593abe054fab9c422d
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/qtcreator-bin
	vcopy "squashfs-root/*" opt/qtcreator-bin
	chmod -R o-w "${DESTDIR}/opt/qtcreator-bin"
	vmkdir usr/bin
	ln -sf "/opt/qtcreator-bin/AppRun" "${DESTDIR}/usr/bin/qtcreator"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
