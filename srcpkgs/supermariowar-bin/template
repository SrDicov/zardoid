# Template file for 'supermariowar-bin'
pkgname=supermariowar-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Super Mario War
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Supermariowar-AppImage"
distfiles="https://github.com/pkgforge-dev/Supermariowar-AppImage/releases/download/1971b11c8%402026-10-01_1790876567/Super_Mario_War-1971b11c8-anylinux-x86_64.AppImage>supermariowar-bin-${version}.AppImage"
checksum=cc213a8e73938265eb43bc5a5662fa5aa66a44ff0266a1b2a7850042300bb69d
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/supermariowar-bin
	vcopy "squashfs-root/*" opt/supermariowar-bin
	vmkdir usr/bin
	ln -sf "/opt/supermariowar-bin/AppRun" "${DESTDIR}/usr/bin/supermariowar"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
