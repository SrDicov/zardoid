# Template file for 'dosbox-pure-unleashed-bin'
pkgname=dosbox-pure-unleashed-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of DOSBox Pure Unleashed"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/DOSBox-Pure-Unleashed-AppImage"
distfiles="https://github.com/pkgforge-dev/DOSBox-Pure-Unleashed-AppImage/releases/download/f0453b42b%402026-10-22_1792688442/DOSBox_Pure_Unleashed-f0453b42b-anylinux-x86_64.AppImage>dosbox-pure-unleashed-bin-${version}.AppImage"
checksum=bf4558ec334aa5897f674aea23f9b277f0ac9c50e49553a8e295066b7c617fff
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dosbox-pure-unleashed-bin
	vcopy "squashfs-root/*" opt/dosbox-pure-unleashed-bin
	chmod -R o-w "${DESTDIR}/opt/dosbox-pure-unleashed-bin"
	vmkdir usr/bin
	ln -sf "/opt/dosbox-pure-unleashed-bin/AppRun" "${DESTDIR}/usr/bin/dosbox-pure-unleashed"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
