# Template file for 'stirling-pdf-bin'
pkgname=stirling-pdf-bin
version=3.0.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Stirling-PDF. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Stirling-PDF-AppImage"
distfiles="https://github.com/pkgforge-dev/Stirling-PDF-AppImage/releases/download/v${version}%402026-10-01_1790876524/Stirling-PDF-v${version}-anylinux-x86_64.AppImage>stirling-pdf-bin-${version}.AppImage"
checksum=196a309276c01d05d286a251d084935d168c769ca2fd9e17c64a0c91ec68e848
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/stirling-pdf-bin
	vcopy "squashfs-root/*" opt/stirling-pdf-bin
	vmkdir usr/bin
	ln -sf "/opt/stirling-pdf-bin/AppRun" "${DESTDIR}/usr/bin/stirling-pdf"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
