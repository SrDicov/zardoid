# Template file for 'clonehero-bin'
pkgname=clonehero-bin
version=20260907
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Clone Hero [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/CloneHero-AppImage"
distfiles="https://github.com/pkgforge-dev/CloneHero-AppImage/releases/download/v1.1.0.6142-final%402026-09-07_1788786700/Clone_Hero-v1.1.0.6142-final-anylinux-x86_64.AppImage>clonehero-bin-${version}.AppImage"
checksum=b5de44cbf97320b7d5f865cfcfc4c7bb6678499a782c96fec32945d278237ce0
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/clonehero-bin
	vcopy "squashfs-root/*" opt/clonehero-bin
	chmod -R o-w "${DESTDIR}/opt/clonehero-bin"
	vmkdir usr/bin
	ln -sf "/opt/clonehero-bin/AppRun" "${DESTDIR}/usr/bin/clonehero"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
