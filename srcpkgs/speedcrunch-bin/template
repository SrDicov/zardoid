# Template file for 'speedcrunch-bin'
pkgname=speedcrunch-bin
version=0.12
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the SpeedCrunch Calculator"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/SpeedCrunch-AppImage"
distfiles="https://github.com/pkgforge-dev/SpeedCrunch-AppImage/releases/download/${version}%402026-09-01_1788265748/SpeedCrunch-${version}-anylinux-x86_64.AppImage>speedcrunch-bin-${version}.AppImage"
checksum=d969439c5eeae5adae2a52a5cb0adf117c519529743ba4bf5963b3d3873fbbe0
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/speedcrunch-bin
	vcopy "squashfs-root/*" opt/speedcrunch-bin
	vmkdir usr/bin
	ln -sf "/opt/speedcrunch-bin/AppRun" "${DESTDIR}/usr/bin/speedcrunch"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
