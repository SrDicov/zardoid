# Template file for 'st-bin'
pkgname=st-bin
version=0.9.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the suckless terminal st"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/st-AppImage"
distfiles="https://github.com/pkgforge-dev/st-AppImage/releases/download/${version}-1%402026-09-01_1788278288/st-${version}-1-anylinux-x86_64.AppImage>st-bin-${version}.AppImage"
checksum=980b7d1e7674f206c3bcb69bbec4832e0cbd2356cd2a346ff2b7f15121275a27
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/st-bin
	vcopy "squashfs-root/*" opt/st-bin
	vmkdir usr/bin
	ln -sf "/opt/st-bin/AppRun" "${DESTDIR}/usr/bin/st"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
