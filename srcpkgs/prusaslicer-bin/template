# Template file for 'prusaslicer-bin'
pkgname=prusaslicer-bin
version=20261021
revision=1
archs="x86_64"
short_desc="Unofficial AppImage for PrusaSlicer. [Maintainer=@sarrchri]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/PrusaSlicer-AppImage"
distfiles="https://github.com/pkgforge-dev/PrusaSlicer-AppImage/releases/download/2.9.6-5%402026-10-21_1792586224/PrusaSlicer-2.9.6-5-anylinux-x86_64.AppImage>prusaslicer-bin-${version}.AppImage"
checksum=b3f04d5520336292d68b278c625830189487e55d3f37cec6ab817b5d4a80bfd7
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/prusaslicer-bin
	vcopy "squashfs-root/*" opt/prusaslicer-bin
	chmod -R o-w "${DESTDIR}/opt/prusaslicer-bin"
	vmkdir usr/bin
	ln -sf "/opt/prusaslicer-bin/AppRun" "${DESTDIR}/usr/bin/prusaslicer"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
