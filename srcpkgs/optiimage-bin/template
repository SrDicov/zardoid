# Template file for 'optiimage-bin'
pkgname=optiimage-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OptiImage [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/OptiImage-AppImage"
distfiles="https://github.com/pkgforge-dev/OptiImage-AppImage/releases/download/1.0.0-4%402026-10-01_1790871892/OptiImage-1.0.0-4-anylinux-x86_64.AppImage>optiimage-bin-${version}.AppImage"
checksum=1fd1406c5981ca8a4fd07bf078a821e91fc3576977dd7a2f34606e7f956163eb
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/optiimage-bin
	vcopy "squashfs-root/*" opt/optiimage-bin
	vmkdir usr/bin
	ln -sf "/opt/optiimage-bin/AppRun" "${DESTDIR}/usr/bin/optiimage"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
