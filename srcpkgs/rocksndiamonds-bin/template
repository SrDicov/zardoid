# Template file for 'rocksndiamonds-bin'
pkgname=rocksndiamonds-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Rocks'n'Diamonds
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/RocksnDiamonds-AppImage"
distfiles="https://github.com/pkgforge-dev/RocksnDiamonds-AppImage/releases/download/4.4.2.4-1%402026-10-22_1792689033/Rocks.N.Diamonds-4.4.2.4-1-anylinux-x86_64.AppImage>rocksndiamonds-bin-${version}.AppImage"
checksum=b01707540bf4a3118a1c495419b047e4603c48ceec1f1fa3c6b20b3c9184fb9b
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rocksndiamonds-bin
	vcopy "squashfs-root/*" opt/rocksndiamonds-bin
	chmod -R o-w "${DESTDIR}/opt/rocksndiamonds-bin"
	vmkdir usr/bin
	ln -sf "/opt/rocksndiamonds-bin/AppRun" "${DESTDIR}/usr/bin/rocksndiamonds"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
