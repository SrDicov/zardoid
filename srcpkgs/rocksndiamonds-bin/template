# Template file for 'rocksndiamonds-bin'
pkgname=rocksndiamonds-bin
version=4.4.2.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Rocks'n'Diamonds
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/RocksnDiamonds-AppImage"
distfiles="https://github.com/pkgforge-dev/RocksnDiamonds-AppImage/releases/download/${version}-1%402026-10-01_1790876510/Rocks.N.Diamonds-${version}-1-anylinux-x86_64.AppImage>rocksndiamonds-bin-${version}.AppImage"
checksum=d9e791b6e8c9d34c674721e5971768a49c24b7e1772aecd7008d82a7a21baeb7
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rocksndiamonds-bin
	vcopy "squashfs-root/*" opt/rocksndiamonds-bin
	vmkdir usr/bin
	ln -sf "/opt/rocksndiamonds-bin/AppRun" "${DESTDIR}/usr/bin/rocksndiamonds"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
