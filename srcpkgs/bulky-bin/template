# Template file for 'bulky-bin'
pkgname=bulky-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Bulky [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Bulky-AppImage"
distfiles="https://github.com/pkgforge-dev/Bulky-AppImage/releases/download/4.2-1%402026-10-01_1790875604/Bulky-4.2-1-anylinux-x86_64.AppImage>bulky-bin-${version}.AppImage"
checksum=8717c43c9074b808cd25b1026885cc698daca48e88e763acfc1685c229e40c62
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/bulky-bin
	vcopy "squashfs-root/*" opt/bulky-bin
	vmkdir usr/bin
	ln -sf "/opt/bulky-bin/AppRun" "${DESTDIR}/usr/bin/bulky"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
