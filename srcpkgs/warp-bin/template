# Template file for 'warp-bin'
pkgname=warp-bin
version=1.0.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Warp file sharing application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Warp-AppImage"
distfiles="https://github.com/pkgforge-dev/Warp-AppImage/releases/download/${version}-1%402026-10-01_1790866758/Warp-${version}-1-anylinux-x86_64.AppImage>warp-bin-${version}.AppImage"
checksum=db70ce898dabc423342a1112d09273c071ead2ec205ca342575cfea172e8c8a5
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/warp-bin
	vcopy "squashfs-root/*" opt/warp-bin
	vmkdir usr/bin
	ln -sf "/opt/warp-bin/AppRun" "${DESTDIR}/usr/bin/warp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
