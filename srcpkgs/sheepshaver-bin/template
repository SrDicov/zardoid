# Template file for 'sheepshaver-bin'
pkgname=sheepshaver-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of SheepShaver [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SheepShaver-AppImage"
distfiles="https://github.com/pkgforge-dev/SheepShaver-AppImage/releases/download/892eeb74a%402026-10-01_1790876438/SheepShaver-892eeb74a-anylinux-x86_64.AppImage>sheepshaver-bin-${version}.AppImage"
checksum=2f21c29e4814da359479abeac218e83bb73cb58521453dcafaeb98a67d93d108
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/sheepshaver-bin
	vcopy "squashfs-root/*" opt/sheepshaver-bin
	vmkdir usr/bin
	ln -sf "/opt/sheepshaver-bin/AppRun" "${DESTDIR}/usr/bin/sheepshaver"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
