# Template file for 'melonds-bin'
pkgname=melonds-bin
version=1.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of melonDS that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/melonDS-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/melonDS-AppImage-Enhanced/releases/download/${version}-2%402026-10-01_1790875607/melonDS-${version}-2-anylinux-x86_64.AppImage>melonds-bin-${version}.AppImage"
checksum=41915deccde84e0dc65fdee3f45980e17249145a410497b68ecfa7b20d057eed
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/melonds-bin
	vcopy "squashfs-root/*" opt/melonds-bin
	vmkdir usr/bin
	ln -sf "/opt/melonds-bin/AppRun" "${DESTDIR}/usr/bin/melonds"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
