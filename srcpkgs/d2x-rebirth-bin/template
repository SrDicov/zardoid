# Template file for 'd2x-rebirth-bin'
pkgname=d2x-rebirth-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of D2X-Rebirth [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/D2X-Rebirth-AppImage"
distfiles="https://github.com/pkgforge-dev/D2X-Rebirth-AppImage/releases/download/db1996a7f%402026-10-01_1790874987/D2X-Rebirth-db1996a7f-anylinux-x86_64.AppImage>d2x-rebirth-bin-${version}.AppImage"
checksum=540ee90063ccbd7b50b7f3ec9d3435852ae3b6ec2f8ac95e9305c36851ece03a
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/d2x-rebirth-bin
	vcopy "squashfs-root/*" opt/d2x-rebirth-bin
	vmkdir usr/bin
	ln -sf "/opt/d2x-rebirth-bin/AppRun" "${DESTDIR}/usr/bin/d2x-rebirth"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
