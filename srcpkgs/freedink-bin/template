# Template file for 'freedink-bin'
pkgname=freedink-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of GNU FreeDink [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/GNU-FreeDink-AppImage"
distfiles="https://github.com/pkgforge-dev/GNU-FreeDink-AppImage/releases/download/109.6-2%402026-10-22_1792689303/FreeDink-109.6-2-anylinux-x86_64.AppImage>freedink-bin-${version}.AppImage"
checksum=960799a530ec0693679a74b1c3532a3f0444e950e1c63c855ea1f1a6219e8e7d
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/freedink-bin
	vcopy "squashfs-root/*" opt/freedink-bin
	chmod -R o-w "${DESTDIR}/opt/freedink-bin"
	vmkdir usr/bin
	ln -sf "/opt/freedink-bin/AppRun" "${DESTDIR}/usr/bin/freedink"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
