# Template file for 'freedink-bin'
pkgname=freedink-bin
version=109.6
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of GNU FreeDink [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/GNU-FreeDink-AppImage"
distfiles="https://github.com/pkgforge-dev/GNU-FreeDink-AppImage/releases/download/${version}-2%402026-10-01_1790876460/FreeDink-${version}-2-anylinux-x86_64.AppImage>freedink-bin-${version}.AppImage"
checksum=c913bc865d43539c28e902e51cbf55b0961d5a9c304271b711d29d4f05c0645c
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/freedink-bin
	vcopy "squashfs-root/*" opt/freedink-bin
	vmkdir usr/bin
	ln -sf "/opt/freedink-bin/AppRun" "${DESTDIR}/usr/bin/freedink"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
