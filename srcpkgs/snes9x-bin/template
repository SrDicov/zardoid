# Template file for 'snes9x-bin'
pkgname=snes9x-bin
version=1.63
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Snes9x [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Snes9x-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Snes9x-AppImage-Enhanced/releases/download/${version}-1%402026-10-01_1790876690/Snes9x-${version}-1-anylinux-x86_64.AppImage>snes9x-bin-${version}.AppImage"
checksum=1135e0f159309962cbc05faaaebacda6f12ac93cb1ceaeb43f4eb0583801deed
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/snes9x-bin
	vcopy "squashfs-root/*" opt/snes9x-bin
	vmkdir usr/bin
	ln -sf "/opt/snes9x-bin/AppRun" "${DESTDIR}/usr/bin/snes9x"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
