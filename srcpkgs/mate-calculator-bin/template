# Template file for 'mate-calculator-bin'
pkgname=mate-calculator-bin
version=1.28.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of MATE Calculator [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/MATE-Calculator-AppImage"
distfiles="https://github.com/pkgforge-dev/MATE-Calculator-AppImage/releases/download/${version}-3%402026-09-01_1788277962/MATE_Calculator-${version}-3-anylinux-x86_64.AppImage>mate-calculator-bin-${version}.AppImage"
checksum=3fca92a56b622f80b3aa35941236c257461aa0240fe597506d41b0cc48ffa9c8
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/mate-calculator-bin
	vcopy "squashfs-root/*" opt/mate-calculator-bin
	vmkdir usr/bin
	ln -sf "/opt/mate-calculator-bin/AppRun" "${DESTDIR}/usr/bin/mate-calculator"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
