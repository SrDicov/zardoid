# Template file for 'krita-bin'
pkgname=krita-bin
version=6.0.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Krita [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Krita-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Krita-AppImage-Enhanced/releases/download/${version}-2%402026-10-01_1790875983/Krita-${version}-2-anylinux-x86_64.AppImage>krita-bin-${version}.AppImage"
checksum=55176e91d11f5407cdd716699f92c97a59a5b24e8f95b9091533518b3c2887a3
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/krita-bin
	vcopy "squashfs-root/*" opt/krita-bin
	vmkdir usr/bin
	ln -sf "/opt/krita-bin/AppRun" "${DESTDIR}/usr/bin/krita"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
