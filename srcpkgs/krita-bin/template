# Template file for 'krita-bin'
pkgname=krita-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Krita [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Krita-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Krita-AppImage-Enhanced/releases/download/6.0.4.1-2%402026-10-22_1792688940/Krita-6.0.4.1-2-anylinux-x86_64.AppImage>krita-bin-${version}.AppImage"
checksum=0946af7e91effce3e965a2b2a4d8a507f0c45c41738cdf54b9814f02a359ebeb
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/krita-bin
	vcopy "squashfs-root/*" opt/krita-bin
	chmod -R o-w "${DESTDIR}/opt/krita-bin"
	vmkdir usr/bin
	ln -sf "/opt/krita-bin/AppRun" "${DESTDIR}/usr/bin/krita"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
