# Template file for 'ioquake3-bin'
pkgname=ioquake3-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ioquake3 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ioquake3-AppImage"
distfiles="https://github.com/pkgforge-dev/ioquake3-AppImage/releases/download/83a776283%402026-10-01_1790875295/Quake_III_Arena-83a776283-anylinux-x86_64.AppImage>ioquake3-bin-${version}.AppImage"
checksum=93b2f29f602f00d4930560270a587913819d501c226fc3b51d31b283c2e9f79e
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ioquake3-bin
	vcopy "squashfs-root/*" opt/ioquake3-bin
	vmkdir usr/bin
	ln -sf "/opt/ioquake3-bin/AppRun" "${DESTDIR}/usr/bin/ioquake3"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
