# Template file for 'audio-sharing-bin'
pkgname=audio-sharing-bin
version=0.2.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Audio Sharing application, using RTSP"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Audio-Sharing-AppImage"
distfiles="https://github.com/pkgforge-dev/Audio-Sharing-AppImage/releases/download/${version}-4%402026-10-01_1790865988/Audio_Sharing-${version}-4-anylinux-x86_64.AppImage>audio-sharing-bin-${version}.AppImage"
checksum=5ecb334e33954303e4c4e10fe4b254fb1946c36ee2334cbde1a47776dac89032
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/audio-sharing-bin
	vcopy "squashfs-root/*" opt/audio-sharing-bin
	vmkdir usr/bin
	ln -sf "/opt/audio-sharing-bin/AppRun" "${DESTDIR}/usr/bin/audio-sharing"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
