# Template file for 'audio-sharing-bin'
pkgname=audio-sharing-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Audio Sharing application, using RTSP"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Audio-Sharing-AppImage"
distfiles="https://github.com/pkgforge-dev/Audio-Sharing-AppImage/releases/download/0.2.4-4%402026-10-22_1792674689/Audio_Sharing-0.2.4-4-anylinux-x86_64.AppImage>audio-sharing-bin-${version}.AppImage"
checksum=b539273cb6fe449f0abf7907c56785f3e8854af92f34a9a0911a07782d434c15
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/audio-sharing-bin
	vcopy "squashfs-root/*" opt/audio-sharing-bin
	chmod -R o-w "${DESTDIR}/opt/audio-sharing-bin"
	vmkdir usr/bin
	ln -sf "/opt/audio-sharing-bin/AppRun" "${DESTDIR}/usr/bin/audio-sharing"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
