# Template file for 'android-translation-layer-bin'
pkgname=android-translation-layer-bin
version=20260922
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Android Translation Layer"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/android_translation_layer-AppImage"
distfiles="https://github.com/pkgforge-dev/android_translation_layer-AppImage/releases/download/3e686d14%402026-09-22_1790090775/Android_Translation_Layer-3e686d14-anylinux-x86_64.AppImage>android-translation-layer-bin-${version}.AppImage"
checksum=a71327d020851183d8b7ed9e1ed8e56c888c75dd1322c06361f86154bf01e16a
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/android-translation-layer-bin
	vcopy "squashfs-root/*" opt/android-translation-layer-bin
	vmkdir usr/bin
	ln -sf "/opt/android-translation-layer-bin/AppRun" "${DESTDIR}/usr/bin/android-translation-layer"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
