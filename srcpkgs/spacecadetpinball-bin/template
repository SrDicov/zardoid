# Template file for 'spacecadetpinball-bin'
pkgname=spacecadetpinball-bin
version=2.1.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of spacecadetpinball [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/spacecadetpinball-AppImage"
distfiles="https://github.com/pkgforge-dev/spacecadetpinball-AppImage/releases/download/${version}%402026-08-11_1786482748/SpaceCadetPinball-${version}-anylinux-x86_64.AppImage>spacecadetpinball-bin-${version}.AppImage"
checksum=9a7b6245bc3c112621292ef9d8d8e5b2e455c7ea9c634615b3dcbb55fb190277
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/spacecadetpinball-bin
	vcopy "squashfs-root/*" opt/spacecadetpinball-bin
	vmkdir usr/bin
	ln -sf "/opt/spacecadetpinball-bin/AppRun" "${DESTDIR}/usr/bin/spacecadetpinball"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
