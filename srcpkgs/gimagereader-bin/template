# Template file for 'gimagereader-bin'
pkgname=gimagereader-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of gImageReader [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/gImageReader-AppImage"
distfiles="https://github.com/pkgforge-dev/gImageReader-AppImage/releases/download/3.4.3-3%402026-10-22_1792689115/gImageReader-3.4.3-3-anylinux-x86_64.AppImage>gimagereader-bin-${version}.AppImage"
checksum=177e91aace15351bfeec3efa7cdc8afb837ece2efc07d3643a696cc55f667d9c
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gimagereader-bin
	vcopy "squashfs-root/*" opt/gimagereader-bin
	chmod -R o-w "${DESTDIR}/opt/gimagereader-bin"
	vmkdir usr/bin
	ln -sf "/opt/gimagereader-bin/AppRun" "${DESTDIR}/usr/bin/gimagereader"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
