# Template file for 'gimagereader-bin'
pkgname=gimagereader-bin
version=3.4.3
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of gImageReader [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/gImageReader-AppImage"
distfiles="https://github.com/pkgforge-dev/gImageReader-AppImage/releases/download/${version}-3%402026-10-01_1790876509/gImageReader-${version}-3-anylinux-x86_64.AppImage>gimagereader-bin-${version}.AppImage"
checksum=663f050fef513c101ad8826dde044c08220f2eb574ad733115237a03e39e44ab
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gimagereader-bin
	vcopy "squashfs-root/*" opt/gimagereader-bin
	vmkdir usr/bin
	ln -sf "/opt/gimagereader-bin/AppRun" "${DESTDIR}/usr/bin/gimagereader"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
