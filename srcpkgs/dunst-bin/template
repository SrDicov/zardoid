# Template file for 'dunst-bin'
pkgname=dunst-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of dunst [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/dunst-AppImage"
distfiles="https://github.com/pkgforge-dev/dunst-AppImage/releases/download/1.13.2-3%402026-10-22_1792688962/dunst-1.13.2-3-anylinux-x86_64.AppImage>dunst-bin-${version}.AppImage"
checksum=5a7d3fbb8bfd18e7abe81ef797e36a4dca59d2995664513c5630a50f4672ab7c
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dunst-bin
	vcopy "squashfs-root/*" opt/dunst-bin
	chmod -R o-w "${DESTDIR}/opt/dunst-bin"
	vmkdir usr/bin
	ln -sf "/opt/dunst-bin/AppRun" "${DESTDIR}/usr/bin/dunst"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
