# Template file for 'qimgv-bin'
pkgname=qimgv-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Qimgv. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Qimgv-AppImage"
distfiles="https://github.com/pkgforge-dev/Qimgv-AppImage/releases/download/v1.0.2%402026-10-22_1792688890/qimgv-v1.0.2-anylinux-x86_64.AppImage>qimgv-bin-${version}.AppImage"
checksum=7442208ea11fa3c5df80ea53302f9d0035c3cec895bd826f5dbebf7f2a59fdc9
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/qimgv-bin
	vcopy "squashfs-root/*" opt/qimgv-bin
	chmod -R o-w "${DESTDIR}/opt/qimgv-bin"
	vmkdir usr/bin
	ln -sf "/opt/qimgv-bin/AppRun" "${DESTDIR}/usr/bin/qimgv"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
