# Template file for 'quickshell-bin'
pkgname=quickshell-bin
version=0.3.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Quickshell [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Quickshell-AppImage"
distfiles="https://github.com/pkgforge-dev/Quickshell-AppImage/releases/download/${version}-1%402026-10-01_1790876646/quickshell-${version}-1-anylinux-x86_64.AppImage>quickshell-bin-${version}.AppImage"
checksum=e8b3d625608d464ad66e8ddb5f6e7aa80724298c9849652add11c9e7dddc41d8
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/quickshell-bin
	vcopy "squashfs-root/*" opt/quickshell-bin
	vmkdir usr/bin
	ln -sf "/opt/quickshell-bin/AppRun" "${DESTDIR}/usr/bin/quickshell"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
