# Template file for 'quickshell-bin'
pkgname=quickshell-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Quickshell [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Quickshell-AppImage"
distfiles="https://github.com/pkgforge-dev/Quickshell-AppImage/releases/download/0.3.2-1%402026-10-22_1792689125/quickshell-0.3.2-1-anylinux-x86_64.AppImage>quickshell-bin-${version}.AppImage"
checksum=65e542f9f2ef5c65cd9da5ebaed42d1ab5b3e9e6a1fc0a48b33e3f9d4e23c5b2
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/quickshell-bin
	vcopy "squashfs-root/*" opt/quickshell-bin
	chmod -R o-w "${DESTDIR}/opt/quickshell-bin"
	vmkdir usr/bin
	ln -sf "/opt/quickshell-bin/AppRun" "${DESTDIR}/usr/bin/quickshell"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
