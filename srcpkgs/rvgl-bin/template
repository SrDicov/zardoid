# Template file for 'rvgl-bin'
pkgname=rvgl-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of RVGL [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/RVGL-AppImage"
distfiles="https://github.com/pkgforge-dev/RVGL-AppImage/releases/download/0.1.23.1030a3%402026-10-01_1790876501/RVGL_Launcher-0.1.23.1030a3-anylinux-x86_64.AppImage>rvgl-bin-${version}.AppImage"
checksum=455f4aba82c02d25eca4b1542e7e95cb2befe85d1dd3bc724fd4e8ed3cd531fc
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rvgl-bin
	vcopy "squashfs-root/*" opt/rvgl-bin
	vmkdir usr/bin
	ln -sf "/opt/rvgl-bin/AppRun" "${DESTDIR}/usr/bin/rvgl"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
