# Template file for 'gradia-bin'
pkgname=gradia-bin
version=20261015
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Gradia, screenshot/picture editor and
 uploader"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Gradia-AppImage"
distfiles="https://github.com/pkgforge-dev/Gradia-AppImage/releases/download/1.13.0%402026-10-15_1792096718/Gradia-1.13.0-anylinux-x86_64.AppImage>gradia-bin-${version}.AppImage"
checksum=0b8de53e63c0dfac6b49592172044f995fc305d50d3eefcb54fcbaf816986d26
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gradia-bin
	vcopy "squashfs-root/*" opt/gradia-bin
	vmkdir usr/bin
	ln -sf "/opt/gradia-bin/AppRun" "${DESTDIR}/usr/bin/gradia"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
