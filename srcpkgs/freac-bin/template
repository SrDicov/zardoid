# Template file for 'freac-bin'
pkgname=freac-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of freac [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/freac-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/freac-AppImage-Enhanced/releases/download/9e283e301%402026-10-01_1790876574/fre_ac-9e283e301-anylinux-x86_64.AppImage>freac-bin-${version}.AppImage"
checksum=f36acadb2279dc6906718f74528984b8025eace5f8ee718de7dbea7b6e3b2160
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/freac-bin
	vcopy "squashfs-root/*" opt/freac-bin
	vmkdir usr/bin
	ln -sf "/opt/freac-bin/AppRun" "${DESTDIR}/usr/bin/freac"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
