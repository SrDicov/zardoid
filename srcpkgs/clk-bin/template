# Template file for 'clk-bin'
pkgname=clk-bin
version=20260407
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of CLK Clock Signal
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/CLK-AppImage"
distfiles="https://github.com/pkgforge-dev/CLK-AppImage/releases/download/2026-04-07%402026-05-01_1777637001/Clock_Signal-2026-04-07-anylinux-x86_64.AppImage>clk-bin-${version}.AppImage"
checksum=8e2d332281c6c19083d87ea9f28e10adeea7606136b79dbb1a5a043f409fc1ec
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/clk-bin
	vcopy "squashfs-root/*" opt/clk-bin
	vmkdir usr/bin
	ln -sf "/opt/clk-bin/AppRun" "${DESTDIR}/usr/bin/clk"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
