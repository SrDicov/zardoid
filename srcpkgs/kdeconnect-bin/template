# Template file for 'kdeconnect-bin'
pkgname=kdeconnect-bin
version=26.08.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of kdeconnect. [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/kdeconnect-AppImage"
distfiles="https://github.com/pkgforge-dev/kdeconnect-AppImage/releases/download/${version}-1%402026-10-07_1791383193/KDE_Connect-${version}-1-anylinux-x86_64.AppImage>kdeconnect-bin-${version}.AppImage"
checksum=bb10849958fd2b72d268ea636d825c73c92d3eb0417acf83ed038a218d73340b
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kdeconnect-bin
	vcopy "squashfs-root/*" opt/kdeconnect-bin
	vmkdir usr/bin
	ln -sf "/opt/kdeconnect-bin/AppRun" "${DESTDIR}/usr/bin/kdeconnect"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
