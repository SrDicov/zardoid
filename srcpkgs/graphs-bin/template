# Template file for 'graphs-bin'
pkgname=graphs-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Graphs data plot editor application"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Graphs-AppImage"
distfiles="https://github.com/pkgforge-dev/Graphs-AppImage/releases/download/2.0.7-1%402026-10-22_1792689244/Graphs-2.0.7-1-anylinux-x86_64.AppImage>graphs-bin-${version}.AppImage"
checksum=f53f7cf0bd43507fd1d9dd860eea6a9b922cdacf5266bb8bdd9143da5a61d117
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/graphs-bin
	vcopy "squashfs-root/*" opt/graphs-bin
	chmod -R o-w "${DESTDIR}/opt/graphs-bin"
	vmkdir usr/bin
	ln -sf "/opt/graphs-bin/AppRun" "${DESTDIR}/usr/bin/graphs"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
