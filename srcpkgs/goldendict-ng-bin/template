# Template file for 'goldendict-ng-bin'
pkgname=goldendict-ng-bin
version=26.8.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of GoldenDict-ng [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/GoldenDict-ng-AppImage"
distfiles="https://github.com/pkgforge-dev/GoldenDict-ng-AppImage/releases/download/${version}-1%402026-10-01_1790876360/GoldenDict-ng-${version}-1-anylinux-x86_64.AppImage>goldendict-ng-bin-${version}.AppImage"
checksum=e9c446bded9f58f52438d8e92e56b361d6105dc03614921b7eaac34230b6c293
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/goldendict-ng-bin
	vcopy "squashfs-root/*" opt/goldendict-ng-bin
	vmkdir usr/bin
	ln -sf "/opt/goldendict-ng-bin/AppRun" "${DESTDIR}/usr/bin/goldendict-ng"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
