# Template file for 'goldendict-ng-bin'
pkgname=goldendict-ng-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of GoldenDict-ng [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/GoldenDict-ng-AppImage"
distfiles="https://github.com/pkgforge-dev/GoldenDict-ng-AppImage/releases/download/26.8.0-1%402026-10-22_1792688778/GoldenDict-ng-26.8.0-1-anylinux-x86_64.AppImage>goldendict-ng-bin-${version}.AppImage"
checksum=db2b676f3f86fb6e0034c638bc5b897acdd3a9945e87f7f8af358dcb410e649a
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/goldendict-ng-bin
	vcopy "squashfs-root/*" opt/goldendict-ng-bin
	chmod -R o-w "${DESTDIR}/opt/goldendict-ng-bin"
	vmkdir usr/bin
	ln -sf "/opt/goldendict-ng-bin/AppRun" "${DESTDIR}/usr/bin/goldendict-ng"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
