# Template file for 'daggerfall-unity-bin'
pkgname=daggerfall-unity-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Daggerfall Unity
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Daggerfall-Unity-AppImage"
distfiles="https://github.com/pkgforge-dev/Daggerfall-Unity-AppImage/releases/download/1.1.1-1%402026-10-22_1792688951/Daggerfall-1.1.1-1-anylinux-x86_64.AppImage>daggerfall-unity-bin-${version}.AppImage"
checksum=77178cc9d5e06a36cfa59e14474c915f2a55d1ba1b359d2968e4642a9d294884
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/daggerfall-unity-bin
	vcopy "squashfs-root/*" opt/daggerfall-unity-bin
	chmod -R o-w "${DESTDIR}/opt/daggerfall-unity-bin"
	vmkdir usr/bin
	ln -sf "/opt/daggerfall-unity-bin/AppRun" "${DESTDIR}/usr/bin/daggerfall-unity"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
