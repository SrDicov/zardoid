# Template file for 'daggerfall-unity-bin'
pkgname=daggerfall-unity-bin
version=1.1.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Daggerfall Unity
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Daggerfall-Unity-AppImage"
distfiles="https://github.com/pkgforge-dev/Daggerfall-Unity-AppImage/releases/download/${version}-1%402026-10-01_1790876213/Daggerfall-${version}-1-anylinux-x86_64.AppImage>daggerfall-unity-bin-${version}.AppImage"
checksum=5330b9f50cbc8019e6f3a53b49652d30f770d8e1e51bcc4ee4d357febc175ae9
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/daggerfall-unity-bin
	vcopy "squashfs-root/*" opt/daggerfall-unity-bin
	vmkdir usr/bin
	ln -sf "/opt/daggerfall-unity-bin/AppRun" "${DESTDIR}/usr/bin/daggerfall-unity"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
