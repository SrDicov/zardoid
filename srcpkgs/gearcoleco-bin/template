# Template file for 'gearcoleco-bin'
pkgname=gearcoleco-bin
version=1.7.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Gearcoleco [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Gearcoleco-AppImage"
distfiles="https://github.com/pkgforge-dev/Gearcoleco-AppImage/releases/download/${version}%402026-10-01_1790876597/Gearcoleco-${version}-anylinux-x86_64.AppImage>gearcoleco-bin-${version}.AppImage"
checksum=ee24ce44a6804bfa1851ea34f63cb767072190b14a152fbafadf97504b0310c4
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gearcoleco-bin
	vcopy "squashfs-root/*" opt/gearcoleco-bin
	vmkdir usr/bin
	ln -sf "/opt/gearcoleco-bin/AppRun" "${DESTDIR}/usr/bin/gearcoleco"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
