# Template file for 'roller-bin'
pkgname=roller-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ROLLER [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ROLLER-AppImage"
distfiles="https://github.com/pkgforge-dev/ROLLER-AppImage/releases/download/d5b122129%402026-10-01_1790876432/Roller-d5b122129-anylinux-x86_64.AppImage>roller-bin-${version}.AppImage"
checksum=a1af6f279b28c86858335b2f04a35fa4b17108c5a8778b62c811d4ed57f210d8
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/roller-bin
	vcopy "squashfs-root/*" opt/roller-bin
	vmkdir usr/bin
	ln -sf "/opt/roller-bin/AppRun" "${DESTDIR}/usr/bin/roller"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
