# Template file for 'dorion-bin'
pkgname=dorion-bin
version=6.13.2
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Dorion [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Dorion-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Dorion-AppImage-Enhanced/releases/download/${version}%402026-10-01_1790876703/Dorion-${version}-anylinux-x86_64.AppImage>dorion-bin-${version}.AppImage"
checksum=f5afac165ffca068b0df19d0bf01b208e0c747d2bdab0657ff3d07aca506991d
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dorion-bin
	vcopy "squashfs-root/*" opt/dorion-bin
	vmkdir usr/bin
	ln -sf "/opt/dorion-bin/AppRun" "${DESTDIR}/usr/bin/dorion"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
