# Template file for 'amarok-bin'
pkgname=amarok-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Amarok [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Amarok-AppImage"
distfiles="https://github.com/pkgforge-dev/Amarok-AppImage/releases/download/3.3.3-1%402026-10-01_1790876576/Amarok-3.3.3-1-anylinux-x86_64.AppImage>amarok-bin-${version}.AppImage"
checksum=24ebf3fd3ae9ab1468a7a832e5520626b654673e776d6856839b8f1bdc069396
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/amarok-bin
	vcopy "squashfs-root/*" opt/amarok-bin
	vmkdir usr/bin
	ln -sf "/opt/amarok-bin/AppRun" "${DESTDIR}/usr/bin/amarok"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
