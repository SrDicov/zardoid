# Template file for 'fx-bin'
pkgname=fx-bin
version=40.0.0
revision=1
archs="x86_64*"
short_desc="Terminal JSON viewer & processor"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://fx.wtf"
distfiles="https://github.com/antonmedv/fx/releases/download/${version}/fx_linux_amd64"
checksum=c5cf146137d3d1819384356366913f1f98bcf5b334e5f100e4705c081f65ed8e
nopie=yes
noshlibprovides=yes
nostrip=yes
skip_extraction="fx_linux_amd64"

post_extract() {
	local f='fx_linux_amd64'
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	vbin 'fx_linux_amd64' 'fx'
	vlicense "${FILESDIR}/LICENSE"
}
