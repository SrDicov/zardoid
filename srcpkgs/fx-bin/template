post_extract() {
	local f='fx_linux_amd64'
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	vbin 'fx_linux_amd64' 'fx'
	vlicense "${FILESDIR}/LICENSE"
}
