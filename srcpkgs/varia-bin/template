# Template file for 'varia-bin'
pkgname=varia-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Varia advanced aria2-based download
 manager"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Varia-AppImage"
distfiles="https://github.com/pkgforge-dev/Varia-AppImage/releases/download/2026.8.5-1%402026-10-01_1790876026/Varia-2026.8.5-1-anylinux-x86_64.AppImage>varia-bin-${version}.AppImage"
checksum=ad808be8be3690c3bafbeb8361613ec9d01e6cf4e578ba0a259b81a74c71c7ac
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/varia-bin
	vcopy "squashfs-root/*" opt/varia-bin
	vmkdir usr/bin
	ln -sf "/opt/varia-bin/AppRun" "${DESTDIR}/usr/bin/varia"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
