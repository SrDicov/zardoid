# Template file for '2ship2harkinian-bin'
pkgname=2ship2harkinian-bin
version=5.0.1
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of 2ship2harkinian
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/2ship2harkinian-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/2ship2harkinian-AppImage-Enhanced/releases/download/${version}%402026-09-07_1788788271/2SHIP-${version}-anylinux-x86_64.AppImage>2ship2harkinian-bin-${version}.AppImage"
checksum=099e874493617f5279ea7eb228bc22e5874d4709072dbf7cf642992dcb8710e0
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/2ship2harkinian-bin
	vcopy "squashfs-root/*" opt/2ship2harkinian-bin
	vmkdir usr/bin
	ln -sf "/opt/2ship2harkinian-bin/AppRun" "${DESTDIR}/usr/bin/2ship2harkinian"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
