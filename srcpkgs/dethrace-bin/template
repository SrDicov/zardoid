# Template file for 'dethrace-bin'
pkgname=dethrace-bin
version=20261024
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of dethrace [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/dethrace-AppImage"
distfiles="https://github.com/pkgforge-dev/dethrace-AppImage/releases/download/a6d94174b%402026-10-24_1792810263/dethrace-a6d94174b-anylinux-x86_64.AppImage>dethrace-bin-${version}.AppImage"
checksum=fc3182501af0da5ed0d3f1902ab649e9a035db8a3ad4cd4787ae57100e514125
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dethrace-bin
	vcopy "squashfs-root/*" opt/dethrace-bin
	chmod -R o-w "${DESTDIR}/opt/dethrace-bin"
	vmkdir usr/bin
	ln -sf "/opt/dethrace-bin/AppRun" "${DESTDIR}/usr/bin/dethrace"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
