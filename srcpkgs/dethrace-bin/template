# Template file for 'dethrace-bin'
pkgname=dethrace-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of dethrace [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/dethrace-AppImage"
distfiles="https://github.com/pkgforge-dev/dethrace-AppImage/releases/download/a6d94174b%402026-10-01_1790876488/dethrace-a6d94174b-anylinux-x86_64.AppImage>dethrace-bin-${version}.AppImage"
checksum=781b51975a6102fbf357901c398833d20e4440c2dffcf87ea23ba8b44ae2da83
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dethrace-bin
	vcopy "squashfs-root/*" opt/dethrace-bin
	vmkdir usr/bin
	ln -sf "/opt/dethrace-bin/AppRun" "${DESTDIR}/usr/bin/dethrace"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
