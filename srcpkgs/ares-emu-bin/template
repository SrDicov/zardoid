# Template file for 'ares-emu-bin'
pkgname=ares-emu-bin
version=20260907
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the ares emulator"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ares-emu-appimage"
distfiles="https://github.com/pkgforge-dev/ares-emu-appimage/releases/download/v148%402026-09-07_1788787887/ares-v148-anylinux-x86_64.AppImage>ares-emu-bin-${version}.AppImage"
checksum=ffb281c5b99ab3bdb4e3deb0d094aceb2e95a1e83e81d75ab1cf9caf6f3d59df
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ares-emu-bin
	vcopy "squashfs-root/*" opt/ares-emu-bin
	vmkdir usr/bin
	ln -sf "/opt/ares-emu-bin/AppRun" "${DESTDIR}/usr/bin/ares-emu"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
