# Template file for 'dwarf-fortress-bin'
pkgname=dwarf-fortress-bin
version=20261024
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Dwarf Fortress
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Dwarf-Fortress-AppImage"
distfiles="https://github.com/pkgforge-dev/Dwarf-Fortress-AppImage/releases/download/53.16-1%402026-10-24_1792824642/Dwarf_Fortress-53.16-1-anylinux-x86_64.AppImage>dwarf-fortress-bin-${version}.AppImage"
checksum=19f7c2949c25db83a6c371f5d25afb2c654872e26cf255f026d040f2e05786b2
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/dwarf-fortress-bin
	vcopy "squashfs-root/*" opt/dwarf-fortress-bin
	chmod -R o-w "${DESTDIR}/opt/dwarf-fortress-bin"
	vmkdir usr/bin
	ln -sf "/opt/dwarf-fortress-bin/AppRun" "${DESTDIR}/usr/bin/dwarf-fortress"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
