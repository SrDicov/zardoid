# Template file for 'shiru-bin'
pkgname=shiru-bin
version=6.8.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Shiru [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Shiru-AppImage"
distfiles="https://github.com/pkgforge-dev/Shiru-AppImage/releases/download/v${version}%402026-09-22_1790085680/Shiru-v${version}-anylinux-x86_64.AppImage>shiru-bin-${version}.AppImage"
checksum=9747b895770532ce26d8b85188ae50f1f6750c404834985a799271673d673144
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/shiru-bin
	vcopy "squashfs-root/*" opt/shiru-bin
	vmkdir usr/bin
	ln -sf "/opt/shiru-bin/AppRun" "${DESTDIR}/usr/bin/shiru"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
