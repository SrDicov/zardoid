# Template file for 'plus42-bin'
pkgname=plus42-bin
version=1.3.15
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Plus42 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Plus42-AppImage"
distfiles="https://github.com/pkgforge-dev/Plus42-AppImage/releases/download/${version}%402026-10-01_1790876240/Plus42-${version}-anylinux-x86_64.AppImage>plus42-bin-${version}.AppImage"
checksum=0522c6a9e7d4041fd5e92417c595850f62aa0a40ac6479aa5aa61c05b181f5c8
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/plus42-bin
	vcopy "squashfs-root/*" opt/plus42-bin
	vmkdir usr/bin
	ln -sf "/opt/plus42-bin/AppRun" "${DESTDIR}/usr/bin/plus42"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
