# Template file for 'plus42-bin'
pkgname=plus42-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Plus42 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Plus42-AppImage"
distfiles="https://github.com/pkgforge-dev/Plus42-AppImage/releases/download/1.3.15%402026-10-22_1792688395/Plus42-1.3.15-anylinux-x86_64.AppImage>plus42-bin-${version}.AppImage"
checksum=42c77bd5f4ece6eb8e28f2ff541789995d0e08a855c03a323b8406d2a1be9ff4
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/plus42-bin
	vcopy "squashfs-root/*" opt/plus42-bin
	chmod -R o-w "${DESTDIR}/opt/plus42-bin"
	vmkdir usr/bin
	ln -sf "/opt/plus42-bin/AppRun" "${DESTDIR}/usr/bin/plus42"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
