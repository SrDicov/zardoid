# Template file for 'redriver2-bin'
pkgname=redriver2-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of REDRIVER2 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/REDRIVER2-AppImage"
distfiles="https://github.com/pkgforge-dev/REDRIVER2-AppImage/releases/download/b2d885742%402026-09-01_1788277206/REDRIVER2-b2d885742-anylinux-x86_64.AppImage>redriver2-bin-${version}.AppImage"
checksum=e53f67cb38662591ed35e0ed73f72c8a100d2ed8330e9b9c61e4bba39f492617
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/redriver2-bin
	vcopy "squashfs-root/*" opt/redriver2-bin
	vmkdir usr/bin
	ln -sf "/opt/redriver2-bin/AppRun" "${DESTDIR}/usr/bin/redriver2"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
