# Template file for 'tauon-bin'
pkgname=tauon-bin
version=20261009
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Tauon music player [Maintainer=@domesya]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Tauon-AppImage"
distfiles="https://github.com/pkgforge-dev/Tauon-AppImage/releases/download/12.1.0%402026-10-09_1791551191/Tauon-12.1.0-anylinux-x86_64.AppImage>tauon-bin-${version}.AppImage"
checksum=fa4de8764f0036c2115f5725cc850ada5b210192c75dc7fbb7ee41d421f95ffa
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/tauon-bin
	vcopy "squashfs-root/*" opt/tauon-bin
	vmkdir usr/bin
	ln -sf "/opt/tauon-bin/AppRun" "${DESTDIR}/usr/bin/tauon"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
