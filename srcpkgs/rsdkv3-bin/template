# Template file for 'rsdkv3-bin'
pkgname=rsdkv3-bin
version=20261007
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of RSDKv3 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/RSDKv3-AppImage"
distfiles="https://github.com/pkgforge-dev/RSDKv3-AppImage/releases/download/a99e16ad1%402026-10-07_1791382506/RSDKv3-a99e16ad1-anylinux-x86_64.AppImage>rsdkv3-bin-${version}.AppImage"
checksum=c5424611fd2e7d11e7570563cd31263a01e6130c47f9630bacdfaac3dabab334
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rsdkv3-bin
	vcopy "squashfs-root/*" opt/rsdkv3-bin
	vmkdir usr/bin
	ln -sf "/opt/rsdkv3-bin/AppRun" "${DESTDIR}/usr/bin/rsdkv3"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
