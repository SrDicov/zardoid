# Template file for 'asphyxia-core-bin'
pkgname=asphyxia-core-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Asphyxia CORE [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Asphyxia-CORE-AppImage"
distfiles="https://github.com/pkgforge-dev/Asphyxia-CORE-AppImage/releases/download/v1.70b%402026-10-22_1792689429/asphyxia-core-v1.70b-anylinux-x86_64.AppImage>asphyxia-core-bin-${version}.AppImage"
checksum=fde8a4b1a005f69fa3c8d3ffc9fd46e211c3fef8cb02ac9ee02859c87fb08a37
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/asphyxia-core-bin
	vcopy "squashfs-root/*" opt/asphyxia-core-bin
	chmod -R o-w "${DESTDIR}/opt/asphyxia-core-bin"
	vmkdir usr/bin
	ln -sf "/opt/asphyxia-core-bin/AppRun" "${DESTDIR}/usr/bin/asphyxia-core"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
