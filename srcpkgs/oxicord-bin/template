# Template file for 'oxicord-bin'
pkgname=oxicord-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Oxicord [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Oxicord-AppImage"
distfiles="https://github.com/pkgforge-dev/Oxicord-AppImage/releases/download/0.1.9%402026-10-22_1792689316/oxicord-0.1.9-anylinux-x86_64.AppImage>oxicord-bin-${version}.AppImage"
checksum=d78dcc4d263c3e9c48f6e846d822e4fe8e0fcfd2496a92070e2a021d3b317fa4
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/oxicord-bin
	vcopy "squashfs-root/*" opt/oxicord-bin
	chmod -R o-w "${DESTDIR}/opt/oxicord-bin"
	vmkdir usr/bin
	ln -sf "/opt/oxicord-bin/AppRun" "${DESTDIR}/usr/bin/oxicord"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
