# Template file for 'rewaita-bin'
pkgname=rewaita-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Rewaita, color tinting for Adwaita"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Rewaita-AppImage"
distfiles="https://github.com/pkgforge-dev/Rewaita-AppImage/releases/download/1.1.7-1%402026-10-22_1792688604/Rewaita-1.1.7-1-anylinux-x86_64.AppImage>rewaita-bin-${version}.AppImage"
checksum=af53867c8ac300cee6df6ec8323b59f5031937f7838ea87648509361060ae8da
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/rewaita-bin
	vcopy "squashfs-root/*" opt/rewaita-bin
	chmod -R o-w "${DESTDIR}/opt/rewaita-bin"
	vmkdir usr/bin
	ln -sf "/opt/rewaita-bin/AppRun" "${DESTDIR}/usr/bin/rewaita"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
