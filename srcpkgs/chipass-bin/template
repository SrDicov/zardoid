# Template file for 'chipass-bin'
pkgname=chipass-bin
version=2026.09.0
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ChiPass that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ChiPass-AppImage"
distfiles="https://github.com/pkgforge-dev/ChiPass-AppImage/releases/download/${version}%402026-10-01_1790876362/ChiPass-${version}-anylinux-x86_64.AppImage>chipass-bin-${version}.AppImage"
checksum=171d6219ba3832dc7326769edb9adadf307d1d69f5f9e2fd76e7a329988dc52a
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/chipass-bin
	vcopy "squashfs-root/*" opt/chipass-bin
	vmkdir usr/bin
	ln -sf "/opt/chipass-bin/AppRun" "${DESTDIR}/usr/bin/chipass"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
