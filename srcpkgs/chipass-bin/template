# Template file for 'chipass-bin'
pkgname=chipass-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ChiPass that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ChiPass-AppImage"
distfiles="https://github.com/pkgforge-dev/ChiPass-AppImage/releases/download/2026.09.0%402026-10-22_1792688638/ChiPass-2026.09.0-anylinux-x86_64.AppImage>chipass-bin-${version}.AppImage"
checksum=7fe43e806ce98e13d71c3093cc27d9b77f99d03eb02fc061291fd4f4ce82ced0
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/chipass-bin
	vcopy "squashfs-root/*" opt/chipass-bin
	chmod -R o-w "${DESTDIR}/opt/chipass-bin"
	vmkdir usr/bin
	ln -sf "/opt/chipass-bin/AppRun" "${DESTDIR}/usr/bin/chipass"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
