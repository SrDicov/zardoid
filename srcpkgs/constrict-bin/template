# Template file for 'constrict-bin'
pkgname=constrict-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Constrict [Maintainer=@TheRealYasri]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Constrict-AppImage"
distfiles="https://github.com/pkgforge-dev/Constrict-AppImage/releases/download/26.10%402026-10-22_1792688961/Constrict-26.10-anylinux-x86_64.AppImage>constrict-bin-${version}.AppImage"
checksum=7e7e889253c5adb8007b43a5fa7f27e73f575e0d7805070b20a360e5b8ff717d
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/constrict-bin
	vcopy "squashfs-root/*" opt/constrict-bin
	chmod -R o-w "${DESTDIR}/opt/constrict-bin"
	vmkdir usr/bin
	ln -sf "/opt/constrict-bin/AppRun" "${DESTDIR}/usr/bin/constrict"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
