# Template file for 'wine-bin'
pkgname=wine-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of wine [Maintainer=@fiftydinar]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/wine-AppImage"
distfiles="https://github.com/pkgforge-dev/wine-AppImage/releases/download/11.20-1%402026-10-22_1792689131/wine-11.20-1-anylinux-x86_64.AppImage>wine-bin-${version}.AppImage"
checksum=80eaaca26194c0817a2f94341d231f6b3faa7b67ae6be1fb960c788986cdba15
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/wine-bin
	vcopy "squashfs-root/*" opt/wine-bin
	chmod -R o-w "${DESTDIR}/opt/wine-bin"
	vmkdir usr/bin
	ln -sf "/opt/wine-bin/AppRun" "${DESTDIR}/usr/bin/wine"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
