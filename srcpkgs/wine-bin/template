# Template file for 'wine-bin'
pkgname=wine-bin
version=11.19
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of wine [Maintainer=@fiftydinar]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/wine-AppImage"
distfiles="https://github.com/pkgforge-dev/wine-AppImage/releases/download/${version}-1%402026-10-05_1791180881/wine-${version}-1-anylinux-x86_64.AppImage>wine-bin-${version}.AppImage"
checksum=818403024db63c0067fd8f7e9783b202b379516ae8ed1ca21e9b2918d814733e
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/wine-bin
	vcopy "squashfs-root/*" opt/wine-bin
	vmkdir usr/bin
	ln -sf "/opt/wine-bin/AppRun" "${DESTDIR}/usr/bin/wine"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
