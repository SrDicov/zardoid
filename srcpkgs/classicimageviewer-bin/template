# Template file for 'classicimageviewer-bin'
pkgname=classicimageviewer-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of ClassicImageViewer
 [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/ClassicImageViewer-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/ClassicImageViewer-AppImage-Enhanced/releases/download/970f44418%402026-10-01_1790875760/ClassicImageViewer-970f44418-anylinux-x86_64.AppImage>classicimageviewer-bin-${version}.AppImage"
checksum=7e057953fc1026dac32fdc91704db6c49d1c4116096951d26e6757679ac86ca4
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/classicimageviewer-bin
	vcopy "squashfs-root/*" opt/classicimageviewer-bin
	vmkdir usr/bin
	ln -sf "/opt/classicimageviewer-bin/AppRun" "${DESTDIR}/usr/bin/classicimageviewer"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
