# Template file for 'trelby-bin'
pkgname=trelby-bin
version=20260901
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Trelby [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Trelby-AppImage"
distfiles="https://github.com/pkgforge-dev/Trelby-AppImage/releases/download/2.4.16.2-1%402026-09-01_1788278082/Trelby-2.4.16.2-1-anylinux-x86_64.AppImage>trelby-bin-${version}.AppImage"
checksum=888802ffb6ce4177a66703f3541dbc3becc72ba866fbf53fb6df7a9bef9aa0ca
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/trelby-bin
	vcopy "squashfs-root/*" opt/trelby-bin
	vmkdir usr/bin
	ln -sf "/opt/trelby-bin/AppRun" "${DESTDIR}/usr/bin/trelby"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
