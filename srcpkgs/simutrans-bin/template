# Template file for 'simutrans-bin'
pkgname=simutrans-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Simutrans [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Simutrans-AppImage"
distfiles="https://github.com/pkgforge-dev/Simutrans-AppImage/releases/download/125.0.1-1%402026-10-22_1792688249/Simutrans-125.0.1-1-anylinux-x86_64.AppImage>simutrans-bin-${version}.AppImage"
checksum=2466715c4b69c260177c1806c09d9e650af95623d09e9614ae6712386e588084
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/simutrans-bin
	vcopy "squashfs-root/*" opt/simutrans-bin
	chmod -R o-w "${DESTDIR}/opt/simutrans-bin"
	vmkdir usr/bin
	ln -sf "/opt/simutrans-bin/AppRun" "${DESTDIR}/usr/bin/simutrans"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
