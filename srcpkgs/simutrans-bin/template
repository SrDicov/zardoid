# Template file for 'simutrans-bin'
pkgname=simutrans-bin
version=124.5
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Simutrans [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Simutrans-AppImage"
distfiles="https://github.com/pkgforge-dev/Simutrans-AppImage/releases/download/${version}-2%402026-10-01_1790875311/Simutrans-${version}-2-anylinux-x86_64.AppImage>simutrans-bin-${version}.AppImage"
checksum=936b8e7bafa37bac9dec906ffe4fe90078b65bdb88bd3523ccdc94fe5fca839f
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/simutrans-bin
	vcopy "squashfs-root/*" opt/simutrans-bin
	vmkdir usr/bin
	ln -sf "/opt/simutrans-bin/AppRun" "${DESTDIR}/usr/bin/simutrans"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
