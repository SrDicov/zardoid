# Template file for 'obs-studio-bin'
pkgname=obs-studio-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of OBS-Studio [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/OBS-Studio-AppImage"
distfiles="https://github.com/pkgforge-dev/OBS-Studio-AppImage/releases/download/32.2.2-1%402026-10-01_1790876050/OBS_Studio-32.2.2-1-anylinux-x86_64.AppImage>obs-studio-bin-${version}.AppImage"
checksum=307534aa9627c480411bb92993b9d5f801d7256ef0c033a8e00175826d64df0e
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/obs-studio-bin
	vcopy "squashfs-root/*" opt/obs-studio-bin
	vmkdir usr/bin
	ln -sf "/opt/obs-studio-bin/AppRun" "${DESTDIR}/usr/bin/obs-studio"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
