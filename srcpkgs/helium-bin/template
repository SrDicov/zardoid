# Template file for 'helium-bin'
pkgname=helium-bin
version=0.19.4.1
revision=1
archs="x86_64"
short_desc="Helium Browser for Linux"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/imputnet/helium-linux"
distfiles="https://github.com/imputnet/helium-linux/releases/download/${version}/helium-${version}-x86_64.AppImage>helium-bin-${version}.AppImage"
checksum=5b2db392b3ed87f24aa844936059d68aca98bc20548eaaa0decfa3c280a2a0a7
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/helium-bin
	vcopy "squashfs-root/*" opt/helium-bin
	vmkdir usr/bin
	ln -sf "/opt/helium-bin/AppRun" "${DESTDIR}/usr/bin/helium"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
