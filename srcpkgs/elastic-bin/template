# Template file for 'elastic-bin'
pkgname=elastic-bin
version=1.0.4
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Elastic physics-based animation design"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Elastic-AppImage"
distfiles="https://github.com/pkgforge-dev/Elastic-AppImage/releases/download/${version}-1%402026-10-01_1790864981/Elastic-${version}-1-anylinux-x86_64.AppImage>elastic-bin-${version}.AppImage"
checksum=e66ce861c0ca0b3cc7e649a619b6ef82be428b122f5465c9bd3df36da88484ae
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/elastic-bin
	vcopy "squashfs-root/*" opt/elastic-bin
	vmkdir usr/bin
	ln -sf "/opt/elastic-bin/AppRun" "${DESTDIR}/usr/bin/elastic"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
