# Template file for 'elastic-bin'
pkgname=elastic-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the Elastic physics-based animation design"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/Elastic-AppImage"
distfiles="https://github.com/pkgforge-dev/Elastic-AppImage/releases/download/1.0.4-1%402026-10-22_1792674564/Elastic-1.0.4-1-anylinux-x86_64.AppImage>elastic-bin-${version}.AppImage"
checksum=5ebbb6238c8342acf40f0901545effc609f7ce14e4883642379ac3bcb61c2501
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/elastic-bin
	vcopy "squashfs-root/*" opt/elastic-bin
	chmod -R o-w "${DESTDIR}/opt/elastic-bin"
	vmkdir usr/bin
	ln -sf "/opt/elastic-bin/AppRun" "${DESTDIR}/usr/bin/elastic"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
