# Template file for 'ppsspp-bin'
pkgname=ppsspp-bin
version=1.20.4
revision=1
archs="x86_64"
short_desc="PSP emulator for Android, Windows, Mac, Linux and iOS, written in
 C++"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://www.ppsspp.org"
distfiles="https://github.com/hrydgard/ppsspp/releases/download/v${version}/PPSSPP-v${version}-anylinux-x86_64.AppImage>ppsspp-bin-${version}.AppImage"
checksum=661c098e6b7f7610171a57b7c533ce8bba6f2312b71e76d61e850461973eba21
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ppsspp-bin
	vcopy "squashfs-root/*" opt/ppsspp-bin
	chmod -R o-w "${DESTDIR}/opt/ppsspp-bin"
	vmkdir usr/bin
	ln -sf "/opt/ppsspp-bin/AppRun" "${DESTDIR}/usr/bin/ppsspp"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
