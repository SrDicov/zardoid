# Template file for 'heroic-games-launcher-bin'
pkgname=heroic-games-launcher-bin
version=2.22.4
revision=1
archs="x86_64"
short_desc="Games launcher for GOG, Amazon and Epic Games for Linux, Windows
 and"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://heroicgameslauncher.com"
distfiles="https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v${version}/Heroic-${version}-linux-x86_64.AppImage>heroic-games-launcher-bin-${version}.AppImage"
checksum=1664fc3c8e746325f049273272a0eae5a7f653bd3eb4534c2e2a26ef90086e99
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/heroic-games-launcher-bin
	vcopy "squashfs-root/*" opt/heroic-games-launcher-bin
	vmkdir usr/bin
	ln -sf "/opt/heroic-games-launcher-bin/AppRun" "${DESTDIR}/usr/bin/heroic-games-launcher"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
