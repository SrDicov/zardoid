# Template file for 'hadolint-bin'
pkgname=hadolint-bin
version=2.15.1
revision=1
archs="x86_64*"
short_desc="Dockerfile linter, validate inline bash, written in Haskell"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/hadolint/hadolint"
distfiles="https://github.com/hadolint/hadolint/releases/download/v${version}/hadolint-linux-x86_64"
