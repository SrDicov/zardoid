nopie=yes
noshlibprovides=yes
nostrip=yes
skip_extraction="hadolint-linux-x86_64"

post_extract() {
	local f='hadolint-linux-x86_64'
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	vbin 'hadolint-linux-x86_64' 'hadolint'
}
