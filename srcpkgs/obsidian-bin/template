# Template file for 'obsidian-bin'
pkgname=obsidian-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Obsidian that can work on any linux system"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Obsidian-AppImage-Enhanced"
distfiles="https://github.com/pkgforge-dev/Obsidian-AppImage-Enhanced/releases/download/v1.14.4%402026-10-22_1792688243/Obsidian-v1.14.4-anylinux-x86_64.AppImage>obsidian-bin-${version}.AppImage"
checksum=6774b7b6517d6c2f7103f70d3c7f5754fa0f229e6193c428018f4dd32d705ea5
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/obsidian-bin
	vcopy "squashfs-root/*" opt/obsidian-bin
	chmod -R o-w "${DESTDIR}/opt/obsidian-bin"
	vmkdir usr/bin
	ln -sf "/opt/obsidian-bin/AppRun" "${DESTDIR}/usr/bin/obsidian"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
