# Template file for 'gthumb-bin'
pkgname=gthumb-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of gThumb [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/gThumb-AppImage"
distfiles="https://github.com/pkgforge-dev/gThumb-AppImage/releases/download/3.12.12-1%402026-10-22_1792689093/gThumb-3.12.12-1-anylinux-x86_64.AppImage>gthumb-bin-${version}.AppImage"
checksum=354bf5ae21e9dc610dec714dc336cd315c7fdaa5fca1e7bc9c325803042c164d
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gthumb-bin
	vcopy "squashfs-root/*" opt/gthumb-bin
	chmod -R o-w "${DESTDIR}/opt/gthumb-bin"
	vmkdir usr/bin
	ln -sf "/opt/gthumb-bin/AppRun" "${DESTDIR}/usr/bin/gthumb"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
