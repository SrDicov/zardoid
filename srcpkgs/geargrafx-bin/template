# Template file for 'geargrafx-bin'
pkgname=geargrafx-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Geargrafx [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Geargrafx-AppImage"
distfiles="https://github.com/pkgforge-dev/Geargrafx-AppImage/releases/download/1.8.4%402026-10-22_1792688737/Geargrafx-1.8.4-anylinux-x86_64.AppImage>geargrafx-bin-${version}.AppImage"
checksum=648825394366d2848a39c9973e009941a57cd9a39c7fbd1539a7b8ac24b4fe4a
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/geargrafx-bin
	vcopy "squashfs-root/*" opt/geargrafx-bin
	chmod -R o-w "${DESTDIR}/opt/geargrafx-bin"
	vmkdir usr/bin
	ln -sf "/opt/geargrafx-bin/AppRun" "${DESTDIR}/usr/bin/geargrafx"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
