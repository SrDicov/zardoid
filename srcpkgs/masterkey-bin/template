# Template file for 'masterkey-bin'
pkgname=masterkey-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Master Key [Maintainer=@TheRealYasri]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/masterkey-AppImage"
distfiles="https://github.com/pkgforge-dev/masterkey-AppImage/releases/download/v1.9.1%402026-10-22_1792689447/Master_Key-v1.9.1-anylinux-x86_64.AppImage>masterkey-bin-${version}.AppImage"
checksum=52995a9fae5a2af4f61873175c254a7ab72a404349e508315bd29d089416acc4
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/masterkey-bin
	vcopy "squashfs-root/*" opt/masterkey-bin
	chmod -R o-w "${DESTDIR}/opt/masterkey-bin"
	vmkdir usr/bin
	ln -sf "/opt/masterkey-bin/AppRun" "${DESTDIR}/usr/bin/masterkey"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
