# Template file for 'freetube-bin'
pkgname=freetube-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of FreeTube [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/FreeTube-Appimage-Enhanced"
distfiles="https://github.com/pkgforge-dev/FreeTube-Appimage-Enhanced/releases/download/0.25.3-beta%402026-10-22_1792688932/FreeTube-0.25.3-beta-anylinux-x86_64.AppImage>freetube-bin-${version}.AppImage"
checksum=1dc2526b6baa31b51b85d26665625ca65d697fc9d46c08f25626bca62926ce75
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/freetube-bin
	vcopy "squashfs-root/*" opt/freetube-bin
	chmod -R o-w "${DESTDIR}/opt/freetube-bin"
	vmkdir usr/bin
	ln -sf "/opt/freetube-bin/AppRun" "${DESTDIR}/usr/bin/freetube"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
