# Template file for 'catfish-bin'
pkgname=catfish-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of catfish [Maintainer=@TheRealYasri]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Catfish-AppImage"
distfiles="https://github.com/pkgforge-dev/Catfish-AppImage/releases/download/4.20.1-2%402026-10-01_1790876297/Catfish_File_Search-4.20.1-2-anylinux-x86_64.AppImage>catfish-bin-${version}.AppImage"
checksum=513c56567ed6b8b4c3e17ad42dafc3fd89f45ce357627ffe34c49f2db2d7051f
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/catfish-bin
	vcopy "squashfs-root/*" opt/catfish-bin
	vmkdir usr/bin
	ln -sf "/opt/catfish-bin/AppRun" "${DESTDIR}/usr/bin/catfish"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
