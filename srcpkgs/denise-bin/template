# Template file for 'denise-bin'
pkgname=denise-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Denise [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Denise-AppImage"
distfiles="https://github.com/pkgforge-dev/Denise-AppImage/releases/download/2.9%402026-10-22_1792689023/Denise-2.9-anylinux-x86_64.AppImage>denise-bin-${version}.AppImage"
checksum=a939aa21c7318c8a536cf4f7f1e348e16682424f9de994aae6e73598691c2c85
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/denise-bin
	vcopy "squashfs-root/*" opt/denise-bin
	chmod -R o-w "${DESTDIR}/opt/denise-bin"
	vmkdir usr/bin
	ln -sf "/opt/denise-bin/AppRun" "${DESTDIR}/usr/bin/denise"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
