# Template file for 'gpodder-bin'
pkgname=gpodder-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of gPodder [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/gPodder-AppImage"
distfiles="https://github.com/pkgforge-dev/gPodder-AppImage/releases/download/3.11.5-6%402026-10-01_1790876438/gPodder-3.11.5-6-anylinux-x86_64.AppImage>gpodder-bin-${version}.AppImage"
checksum=8357accf89d7336a3c887d01411a10750c5b0b3d6824518252457c384648ecea
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/gpodder-bin
	vcopy "squashfs-root/*" opt/gpodder-bin
	vmkdir usr/bin
	ln -sf "/opt/gpodder-bin/AppRun" "${DESTDIR}/usr/bin/gpodder"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
