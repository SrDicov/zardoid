# Template file for 'fooyin-bin'
pkgname=fooyin-bin
version=20260924
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of fooyin [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/fooyin-AppImage"
distfiles="https://github.com/pkgforge-dev/fooyin-AppImage/releases/download/0.13.0-1%402026-09-24_1790239832/fooyin-0.13.0-1-anylinux-x86_64.AppImage>fooyin-bin-${version}.AppImage"
checksum=03395dd8e9aec7a76533669e20f5cc82c0cea13f72787cd0de08f80989684ef0
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/fooyin-bin
	vcopy "squashfs-root/*" opt/fooyin-bin
	vmkdir usr/bin
	ln -sf "/opt/fooyin-bin/AppRun" "${DESTDIR}/usr/bin/fooyin"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
