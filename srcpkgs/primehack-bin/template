# Template file for 'primehack-bin'
pkgname=primehack-bin
version=20261022
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of the PrimeHack emulator [Maintainer=@SNBeast]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://github.com/pkgforge-dev/PrimeHack-AppImage"
distfiles="https://github.com/pkgforge-dev/PrimeHack-AppImage/releases/download/1.0.9%402026-10-22_1792688676/PrimeHack-1.0.9-anylinux-x86_64.AppImage>primehack-bin-${version}.AppImage"
checksum=bd922be7e45031047a55741cb2492872337dc1b5c64cff47dd417096c7f0cc83
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/primehack-bin
	vcopy "squashfs-root/*" opt/primehack-bin
	chmod -R o-w "${DESTDIR}/opt/primehack-bin"
	vmkdir usr/bin
	ln -sf "/opt/primehack-bin/AppRun" "${DESTDIR}/usr/bin/primehack"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
