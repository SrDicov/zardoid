# Template file for 'zenity-gtk3-bin'
pkgname=zenity-gtk3-bin
version=3.44.5
revision=1
archs="x86_64"
short_desc="AppImage of Zenity (GTK3 Version). [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/pkgforge-dev/Zenity-GTK3-AppImage"
distfiles="https://github.com/pkgforge-dev/Zenity-GTK3-AppImage/releases/download/${version}%402026-09-17_1789638135/zenity-${version}-anylinux-x86_64.AppImage>zenity-gtk3-bin-${version}.AppImage"
checksum=c5f4e2814c02be9fb80aac28f2e3f0cdbe62dd72d3d5491171dab19f708f95b7
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/zenity-gtk3-bin
	vcopy "squashfs-root/*" opt/zenity-gtk3-bin
	vmkdir usr/bin
	ln -sf "/opt/zenity-gtk3-bin/AppRun" "${DESTDIR}/usr/bin/zenity-gtk3"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
}
