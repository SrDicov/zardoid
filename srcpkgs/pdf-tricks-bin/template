# Template file for 'pdf-tricks-bin'
pkgname=pdf-tricks-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of PDF Tricks [Maintainer=@Samueru-sama]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/PDF-Tricks-AppImage"
distfiles="https://github.com/pkgforge-dev/PDF-Tricks-AppImage/releases/download/0.4.1-2%402026-10-01_1790876452/PDF_Tricks-0.4.1-2-anylinux-x86_64.AppImage>pdf-tricks-bin-${version}.AppImage"
checksum=2fe2fadcba10125120a86184789444ee72d15e88bf9a46a2bd68a9be36b52d8e
allow_unknown_shlibs=yes
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/pdf-tricks-bin
	vcopy "squashfs-root/*" opt/pdf-tricks-bin
	vmkdir usr/bin
	ln -sf "/opt/pdf-tricks-bin/AppRun" "${DESTDIR}/usr/bin/pdf-tricks"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
