# Template file for 'kega-fusion-bin'
pkgname=kega-fusion-bin
version=3.63
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Kega Fusion [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Kega-Fusion-AppImage"
distfiles="https://github.com/pkgforge-dev/Kega-Fusion-AppImage/releases/download/${version}-17%402026-05-01_1777638966/Kega_Fusion-${version}-17-anylinux-x86_64.AppImage>kega-fusion-bin-${version}.AppImage"
checksum=7663721ffc7e447ff960806143acd60996d5d26633da5ce607053bb468eabeab
noshlibprovides=yes
nostrip=yes
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/kega-fusion-bin
	vcopy "squashfs-root/*" opt/kega-fusion-bin
	vmkdir usr/bin
	ln -sf "/opt/kega-fusion-bin/AppRun" "${DESTDIR}/usr/bin/kega-fusion"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
