# Template file for 'sdlpop-bin'
pkgname=sdlpop-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of SDLPoP [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/SDLPoP-AppImage"
distfiles="https://github.com/pkgforge-dev/SDLPoP-AppImage/releases/download/3c5add5fb%402026-10-01_1790876450/SDLPoP-3c5add5fb-anylinux-x86_64.AppImage>sdlpop-bin-${version}.AppImage"
checksum=3246fe8cf58c9d3d199510dc29631cf5819b1873a6093cd354b56c069a6d45f8
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/sdlpop-bin
	vcopy "squashfs-root/*" opt/sdlpop-bin
	vmkdir usr/bin
	ln -sf "/opt/sdlpop-bin/AppRun" "${DESTDIR}/usr/bin/sdlpop"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
