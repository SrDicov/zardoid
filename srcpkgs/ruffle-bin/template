# Template file for 'ruffle-bin'
pkgname=ruffle-bin
version=20261001
revision=1
archs="x86_64"
short_desc="Unofficial AppImage of Ruffle [Maintainer=@Link4Electronics]"
maintainer="SrDicov <SrDicov@gmail.com>"
license="MIT"
homepage="https://github.com/pkgforge-dev/Ruffle-AppImage"
distfiles="https://github.com/pkgforge-dev/Ruffle-AppImage/releases/download/2026-10-01%402026-10-01_1790876428/Ruffle-2026-10-01-anylinux-x86_64.AppImage>ruffle-bin-${version}.AppImage"
checksum=2f76c2002813b773c882dd34758fd0fcce9cc5181a40501ec1d4186f7a1be383
noshlibprovides=yes
nostrip=yes
python_version=3
skip_extraction="${pkgname}-${version}.AppImage"

post_extract() {
	local f="${pkgname}-${version}.AppImage"
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${f}" .
}

do_install() {
	local appimg="${pkgname}-${version}.AppImage"
	chmod +x "${appimg}"
	"./${appimg}" --appimage-extract >/dev/null
	vmkdir opt/ruffle-bin
	vcopy "squashfs-root/*" opt/ruffle-bin
	vmkdir usr/bin
	ln -sf "/opt/ruffle-bin/AppRun" "${DESTDIR}/usr/bin/ruffle"
	local desk
	desk="$(find squashfs-root -maxdepth 3 -name '*.desktop' | head -n1)"
	if [ -n "$desk" ]; then
		vinstall "$desk" 644 usr/share/applications
	fi
	local icon
	icon="$(find squashfs-root -name '*.png' -o -name '*.svg' | head -n1)"
	if [ -n "$icon" ]; then
		vinstall "$icon" 644 usr/share/icons/hicolor/256x256/apps
	fi
	vlicense "${FILESDIR}/LICENSE"
}
